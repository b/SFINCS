module sfincs_continuity
   !
   ! GPU sibling of source/src/sfincs_continuity.f90.
   !
   ! Shadows the CPU module's public surface (compute_water_levels,
   ! compute_store_variables) using native CUDA Fortran kernels that operate
   ! on the device-resident catalog declared by sfincs_data_device. The two
   ! private helpers (compute_water_levels_regular, compute_water_levels_subgrid)
   ! mirror the CPU dispatch on the host scalar `subgrid`.
   !
   ! Bridge convention (gpu-foundation): host-side `use sfincs_data` arrays are
   ! suffixed _h via USE-rename; device-side `use sfincs_data_device` arrays are
   ! suffixed _d. CUDA Fortran translates `<dev> = <host>` (and vice-versa) to
   ! cudaMemcpy at the assignment level.
   !
   ! Bridge-IN H2D copies for init-time arrays and previous-step on-device
   ! writers have been retired (gpu-bridge-in-trim sub-epic). zs is now
   ! device-canonical across the per-step loop (SOR-65): its per-step
   ! zs bridge-IN and bridge-OUT in compute_water_levels_regular /
   ! _subgrid are dropped because the only per-step host writer of zs
   ! (the kcs==6 Neumann copy) is ported to a device kernel in
   ! update_boundary_conditions.
   !
   ! q is also device-canonical across the per-step loop (SOR-66, Phase
   ! 2): its per-step `bridge_in_edge_real4(q, q_h)` at the top of
   ! compute_water_levels_regular / _subgrid has been dropped because
   ! q was just written by the on-device k_compute_fluxes kernel in the
   ! same step, host q_h is stale relative to the device shadow (the
   ! compute_fluxes / update_boundary_fluxes bridge-OUTs of q are also
   ! gone), and the bridge-IN would overwrite the device's correct
   ! value with a stale host copy. The nonhydrostatic host-side writer
   ! of q (sfincs_nonhydrostatic.f90:664) is feature-gated and not
   ! exercised by the validation matrix; restoring NH correctness on
   ! the GPU path is deferred to Phase 4.
   !
   ! The remaining bridge-IN exclusion is qext (catalog C.1 — BMI/XMI
   ! external injection between time steps). Non-zs Bridge-OUT D2H
   ! copies remain in place because downstream CPU consumers (netCDF /
   ! binary output, BMI getters, snapwave coupling) still read host
   ! arrays after each step; the host-side store_t_zsmax loop still
   ! reads zs_h but is gated off in every validation case
   ! (storetzsmax=0) per AC #3. compute_store_variables (vmax/qmax/twet)
   ! keeps its own bridge-INs of q / uv; it is out of this phase's
   ! scope and not exercised by any validation case (all of
   ! storevelmax, storefluxmax, storetwet default to 0).
   !
   use cudafor
   use sfincs_data_device
   use sfincs_partition, only: &
      bridge_in_cell_real4, bridge_in_cell_real8, bridge_in_edge_real4, &
      bridge_out_cell_real4, bridge_out_cell_real8, &
      bridge_out_cell_int1, bridge_out_cell_int4, &
      bridge_out_edge_real4, bridge_out_edge_int1
   use sfincs_nvtx, only: nvtx_range_push, nvtx_range_pop
   !
   implicit none
   !
   private
   public :: compute_water_levels, compute_store_variables
   !
   integer, parameter :: TPB = 128   ! threads per block, intentionally simple
   !
contains
   !
   ! -----------------------------------------------------------------
   ! Public dispatch: same control flow as the CPU sibling.
   ! -----------------------------------------------------------------
   subroutine compute_water_levels(t, dt, tloop)
      !
      use sfincs_data, only: subgrid, &
                             store_maximum_velocity, &
                             store_maximum_flux, &
                             store_twet
      !
      implicit none
      !
      real*4           :: dt
      real*8           :: t
      !
      integer          :: count0
      integer          :: count1
      integer          :: count_rate
      integer          :: count_max
      real             :: tloop
      !
      call system_clock(count0, count_rate, count_max)
      !
      if (subgrid) then
         !
         call compute_water_levels_subgrid(dt, t)
         !
      else
         !
         call compute_water_levels_regular(dt, t)
         !
      endif
      !
      if ((store_maximum_velocity .eqv. .true.) .or. &
          (store_maximum_flux     .eqv. .true.) .or. &
          (store_twet             .eqv. .true.)) then
         !
         call compute_store_variables(dt)
         !
      endif
      !
      call system_clock(count1, count_rate, count_max)
      tloop = tloop + 1.0*(count1 - count0)/count_rate
      !
   end subroutine compute_water_levels
   !
   ! -----------------------------------------------------------------
   ! Regular (non-subgrid) water-level update.
   ! -----------------------------------------------------------------
   subroutine compute_water_levels_regular(dt, t)
      !
      use sfincs_data, only: &
         np_h => np, nsrcdrn_h => nsrcdrn, &
         precip_h => precip, use_qext_h => use_qext, &
         wavemaker_h => wavemaker, snapwave_h => snapwave, &
         crsgeo_h => crsgeo, &
         store_maximum_waterlevel_h => store_maximum_waterlevel, &
         store_t_zsmax_h => store_t_zsmax, &
         huthresh_h => huthresh, &
         wavemaker_filter_time_h => wavemaker_filter_time, &
         zs_h => zs, zb_h => zb, qext_h => qext, &
         zsm_h => zsm, zsmax_h => zsmax, maxzsm_h => maxzsm, &
         t_zsmax_h => t_zsmax
      !
      implicit none
      !
      real*4           :: dt
      real*8           :: t
      !
      integer :: blocks
      integer :: istat
      integer :: nm
      real*4  :: factime
      !
      ! Compute factime on the host; matches CPU sibling line 72-76.
      !
      if (snapwave_h) then
         factime = min(dt / wavemaker_filter_time_h, 1.0)
      else
         factime = 0.0
      endif
      !
      ! ------ Copy-IN: host -> device for kernel READ set ----------------
      !
      ! Init-time arrays (kcs, zb, z_flags_iref, z_index_uv_*, dxrinv,
      ! dyrinv, dxm, cell_area_m2, cell_area, nmindsrc,
      ! z_index_wavemaker, wavemaker_nmd/nmu/ndm/num) and previous-step
      ! on-device writers (netprcp, prcp, qtsrc, wavemaker_uvmean,
      ! zsm, maxzsm) are already current device-side; their H2D
      ! copies have been retired.
      !
      ! zs is device-canonical across the per-step loop (SOR-65): its
      ! former `bridge_in_cell_real8(zs, zs_h)` here is dropped. The only
      ! per-step host writer of zs (the kcs==6 Neumann copy) is ported to
      ! the device kernel k_update_neumann_zs in update_boundary_conditions,
      ! so the device zs shadow is already current on entry.
      !
      ! qext is retained per audit catalog Section C.1 (BMI/XMI external
      ! discharge injection between SFINCS time steps).
      !
      ! q is device-canonical across the per-step loop (SOR-66, Phase 2):
      ! its former `bridge_in_edge_real4(q, q_h)` here is dropped. q was
      ! just written by the on-device k_compute_fluxes kernel in the same
      ! step; host q_h is stale (compute_fluxes / update_boundary_fluxes
      ! bridge-OUTs of q are also dropped), so a bridge-IN would clobber
      ! the device's correct value with a stale host copy.
      ! Nonhydrostatic still writes host q on the host path; restoring
      ! that correction on the GPU side is a Phase-4 concern.
      !
      ! zsmax is now device-canonical across the per-step loop (SOR-67,
      ! Phase 3): the former per-step `bridge_in_cell_real4(zsmax,
      ! zsmax_h)` here is dropped. With the per-step bridge-OUT of zsmax
      ! also dropped (compute_water_levels_regular / _subgrid /
      ! update_boundary_fluxes -- AC #3), zsmax_h becomes stale between
      ! output gathers, and a per-step H2D would clobber the fresh
      ! device running max with stale host data. The output-time reset
      ! cycle remains correct because the CUDA-aware reset hook
      ! reset_max_arrays_device_after_output (called from sfincs_lib.F90
      ! USE_CUDA branch immediately after write_output) zeroes the
      ! device max arrays directly when the host reset fires; the
      ! `!$acc update device(zsmax)` in sfincs_output.f90:209 remains
      ! a no-op in the CUDA Fortran build as before.
      !
      call nvtx_range_push("cont_regular_copyin")
      if (use_qext_h)  call bridge_in_cell_real4(qext, qext_h)
      call nvtx_range_pop()
      !
      call nvtx_range_push("cont_regular_kernel")
      ! ------ Discharges: small sequential update on a single thread -----
      !
      if (nsrcdrn_h > 0) then
         call k_regular_discharge<<<1, 1>>>(dt, nsrcdrn_h, crsgeo_h)
         istat = cudaDeviceSynchronize()
      endif
      !
      ! ------ Main per-cell kernel ---------------------------------------
      !
      blocks = (npn_local + TPB - 1) / TPB
      !
      call k_regular_main<<<blocks, TPB>>>( &
         dt, t, factime, npn_local, &
         precip_h, use_qext_h, wavemaker_h, snapwave_h, crsgeo_h, &
         store_maximum_waterlevel_h)
      !
      istat = cudaDeviceSynchronize()
      call nvtx_range_pop()
      !
      ! ------ Copy-OUT: device -> host for WRITE set ---------------------
      ! zs is device-canonical (SOR-65): the former `bridge_out_cell_real8(
      ! zs_h, zs)` here is dropped. Host zs_h is refreshed only at the
      ! existing output / SnapWave-coupling sync points
      ! (device_to_host_for_output, update_wave_field) -- no new sync
      ! points. The store_t_zsmax host loop below still reads zs_h but is
      ! gated off in every validation case (storetzsmax=0); see the note
      ! at that block.
      !
      call nvtx_range_push("cont_regular_copyout")
      !
      ! zsm / maxzsm are now device-canonical between SnapWave coupling
      ! steps (SOR-67, Phase 3): the former per-step bridge-outs here
      ! have moved to update_wave_field (sfincs_snapwave_gpu.cuf), which
      ! fires at dtwave cadence. zsm_h / maxzsm_h for output are
      ! refreshed by device_to_host_for_output (sfincs_partition.cuf
      ! lines 3906 and 3910).
      !
      if (store_maximum_waterlevel_h) then
         !
         ! t_zsmax is host-only (not in foundation catalog). NOTE (SOR-65):
         ! zs is now device-canonical, so zs_h is NOT refreshed per-step
         ! here (the zs bridge-out above was dropped). This branch only
         ! runs when store_t_zsmax (storetzsmax=1), which is off in every
         ! validation case and in case_prod_compound_snapwave, so it is
         ! gated unchanged per the issue's AC #3. Making this read
         ! device-canonical is deferred to the feature-boundary phase; if
         ! storetzsmax is enabled this loop would read a stale zs_h and
         ! must be refactored then. Iterate the rank-local owned slice so
         ! multi-rank runs only update zsmax_h on cells they own; halo /
         ! non-owned positions stay authoritative on the owning rank.
         !
         if (store_t_zsmax_h) then
            do nm = 1, npn_local
               block
                  integer :: g
                  g = local_to_global(nm)
                  if (zs_h(g) > zsmax_h(g)) then
                     if ((zs_h(g) - zb_h(g)) > huthresh_h) then
                        t_zsmax_h(g) = t
                     endif
                  endif
               end block
            enddo
         endif
         !
         ! zsmax is now device-canonical across the per-step loop
         ! (SOR-67, Phase 3): the former per-step `bridge_out_cell_real4(
         ! zsmax_h, zsmax)` here is dropped. zsmax_h for output is
         ! refreshed by device_to_host_for_output (sfincs_partition.cuf
         ! line 3905) at output cadence. The dtmaxout reset cycle in
         ! sfincs_output.f90:207-210 still works: write_output reads the
         ! freshly gathered zsmax_h, then resets zsmax_h = -999.0; the
         ! reset propagates to the device via the per-step
         ! `bridge_in_cell_real4(zsmax, zsmax_h)` at the top of the next
         ! call to compute_water_levels (kept unchanged).
         !
      endif
      call nvtx_range_pop()
      !
   end subroutine compute_water_levels_regular
   !
   ! -----------------------------------------------------------------
   ! Subgrid water-level update.
   ! -----------------------------------------------------------------
   subroutine compute_water_levels_subgrid(dt, t)
      !
      use sfincs_data, only: &
         np_h => np, nsrcdrn_h => nsrcdrn, subgrid_nlevels_h => subgrid_nlevels, &
         precip_h => precip, use_qext_h => use_qext, &
         wavemaker_h => wavemaker, snapwave_h => snapwave, &
         use_quadtree_h => use_quadtree, crsgeo_h => crsgeo, &
         use_storage_volume_h => use_storage_volume, &
         wiggle_suppression_h => wiggle_suppression, &
         store_maximum_waterlevel_h => store_maximum_waterlevel, &
         store_t_zsmax_h => store_t_zsmax, &
         huthresh_h => huthresh, &
         wavemaker_filter_time_h => wavemaker_filter_time, &
         dx_h => dx, dy_h => dy, &
         zs_h => zs, zs0_h => zs0, qext_h => qext, &
         storage_volume_h => storage_volume, &
         subgrid_z_zmin_h => subgrid_z_zmin, &
         z_volume_h => z_volume, zsderv_h => zsderv, &
         zsm_h => zsm, zsmax_h => zsmax, maxzsm_h => maxzsm, &
         t_zsmax_h => t_zsmax
      !
      implicit none
      !
      real*4           :: dt
      real*8           :: t
      !
      integer :: blocks
      integer :: istat
      integer :: nm
      real*4  :: factime
      !
      ! Mirror CPU subgrid sibling: factime is computed inside `if (wavemaker)`.
      !
      if (wavemaker_h) then
         factime = min(dt / wavemaker_filter_time_h, 1.0)
      else
         factime = 0.0
      endif
      !
      ! ------ Copy-IN ----------------------------------------------------
      !
      ! Init-time arrays (kcs, zb, z_flags_iref, z_index_uv_*, dxrm,
      ! dyrm, dxm, cell_area_m2, cell_area, nmindsrc,
      ! z_index_wavemaker, wavemaker_nmd/nmu/ndm/num, subgrid_z_zmin,
      ! subgrid_z_zmax, subgrid_z_dep, subgrid_z_volmax) and
      ! previous-step on-device writers (z_volume, netprcp, prcp,
      ! qtsrc, wavemaker_uvmean, storage_volume, zs0, zsderv, zsm,
      ! maxzsm) are already current device-side; their H2D copies have
      ! been retired.
      !
      ! zs is device-canonical across the per-step loop (SOR-65): its
      ! former `bridge_in_cell_real8(zs, zs_h)` here is dropped. The only
      ! per-step host writer of zs (the kcs==6 Neumann copy) is ported to
      ! the device kernel k_update_neumann_zs in update_boundary_conditions,
      ! so the device zs shadow is already current on entry.
      !
      ! qext is retained per audit catalog Section C.1 (BMI/XMI external
      ! discharge injection between SFINCS time steps).
      !
      ! q is device-canonical across the per-step loop (SOR-66, Phase 2):
      ! its former `bridge_in_edge_real4(q, q_h)` here is dropped. q was
      ! just written by the on-device k_compute_fluxes kernel in the same
      ! step; host q_h is stale (compute_fluxes / update_boundary_fluxes
      ! bridge-OUTs of q are also dropped), so a bridge-IN would clobber
      ! the device's correct value with a stale host copy.
      ! Nonhydrostatic still writes host q on the host path; restoring
      ! that correction on the GPU side is a Phase-4 concern.
      !
      ! zsmax is now device-canonical across the per-step loop (SOR-67,
      ! Phase 3): the former per-step `bridge_in_cell_real4(zsmax,
      ! zsmax_h)` here is dropped. See compute_water_levels_regular for
      ! the full rationale; the output-time reset propagation now goes
      ! through reset_max_arrays_device_after_output instead of the
      ! per-step bridge_in.
      !
      call nvtx_range_push("cont_subgrid_copyin")
      if (use_qext_h)  call bridge_in_cell_real4(qext, qext_h)
      call nvtx_range_pop()
      !
      call nvtx_range_push("cont_subgrid_kernel")
      ! ------ Discharges -------------------------------------------------
      !
      if (nsrcdrn_h > 0) then
         call k_subgrid_discharge<<<1, 1>>>(dt, nsrcdrn_h)
         istat = cudaDeviceSynchronize()
      endif
      !
      ! ------ Main kernel ------------------------------------------------
      !
      blocks = (npn_local + TPB - 1) / TPB
      !
      call k_subgrid_main<<<blocks, TPB>>>( &
         dt, t, factime, npn_local, subgrid_nlevels_h, dx_h, dy_h, &
         precip_h, use_qext_h, wavemaker_h, snapwave_h, &
         use_quadtree_h, crsgeo_h, &
         use_storage_volume_h, wiggle_suppression_h, &
         store_maximum_waterlevel_h)
      !
      istat = cudaDeviceSynchronize()
      call nvtx_range_pop()
      !
      ! ------ Copy-OUT ---------------------------------------------------
      ! zs is device-canonical (SOR-65): the former `bridge_out_cell_real8(
      ! zs_h, zs)` here is dropped. Host zs_h is refreshed only at the
      ! existing output / SnapWave-coupling sync points
      ! (device_to_host_for_output, update_wave_field) -- no new sync
      ! points. The store_t_zsmax host loop below still reads zs_h but is
      ! gated off in every validation case (storetzsmax=0); see the note
      ! at that block.
      !
      call nvtx_range_push("cont_subgrid_copyout")
      !
      ! z_volume is device-canonical across the per-step loop (SOR-67,
      ! Phase 3): the former per-step `bridge_out_cell_real8(z_volume_h,
      ! z_volume)` here is dropped. No per-step host reader of z_volume_h
      ! exists between calls to k_subgrid_main; the host shadow is
      ! refreshed at output cadence by device_to_host_for_output
      ! (sfincs_partition.cuf:3911).
      !
      ! zsderv is also device-canonical (SOR-67, Phase 3): the former
      ! per-step `bridge_out_cell_real4(zsderv_h, zsderv)` here is
      ! dropped. zsderv has no host consumer in the validation matrix
      ! (not in netCDF output, not read by any host per-step path); the
      ! GPU-side reader is k_compute_fluxes which reads the device
      ! shadow and the cross-rank halo entries are refreshed by
      ! halo_exchange_zsderv. zs0 host-side mirror is kept (host
      ! wiggle-suppression reads it on the CPU path; outside Phase 3's
      ! scope).
      !
      if (wiggle_suppression_h) then
         call bridge_out_cell_real4(zs0_h,    zs0)
      endif
      !
      if (use_storage_volume_h) call bridge_out_cell_real4(storage_volume_h, storage_volume)
      !
      ! zsm / maxzsm are now device-canonical between SnapWave coupling
      ! steps (SOR-67, Phase 3): the former per-step bridge-outs here
      ! have moved to update_wave_field (sfincs_snapwave_gpu.cuf), which
      ! fires at dtwave cadence -- one D2H per `dtwave` seconds instead
      ! of one per simulation step. maxzsm_h for output is refreshed by
      ! device_to_host_for_output (sfincs_partition.cuf:3906); zsm_h for
      ! output by device_to_host_for_output (sfincs_partition.cuf:3910);
      ! both also caught by the snapwave-cadence refresh.
      !
      if (store_maximum_waterlevel_h) then
         !
         ! Host-side t_zsmax (not in catalog). See compute_water_levels_regular
         ! for the same pattern and the SOR-65 stale-zs_h note: zs is now
         ! device-canonical so zs_h is not refreshed per-step here; this
         ! branch is gated off in every validation case (storetzsmax=0) so
         ! it is unchanged per AC #3. Iterate owned slice in rank-local
         ! order; halo / non-owned cells stay untouched.
         !
         if (store_t_zsmax_h) then
            do nm = 1, npn_local
               block
                  integer :: g
                  g = local_to_global(nm)
                  if (zs_h(g) > zsmax_h(g)) then
                     if ((zs_h(g) - subgrid_z_zmin_h(g)) > huthresh_h) then
                        t_zsmax_h(g) = t
                     endif
                  endif
               end block
            enddo
         endif
         !
         ! zsmax is now device-canonical across the per-step loop
         ! (SOR-67, Phase 3): the former per-step `bridge_out_cell_real4(
         ! zsmax_h, zsmax)` here is dropped. See the matching block in
         ! compute_water_levels_regular for the dtmaxout reset-cycle
         ! rationale -- the per-step `bridge_in_cell_real4(zsmax,
         ! zsmax_h)` at the top of this routine still propagates the
         ! output-time host reset back to the device.
         !
      endif
      call nvtx_range_pop()
      !
   end subroutine compute_water_levels_subgrid
   !
   ! -----------------------------------------------------------------
   ! Optional store-variables update (vmax / qmax / twet).
   ! -----------------------------------------------------------------
   subroutine compute_store_variables(dt)
      !
      use sfincs_data, only: &
         subgrid_h => subgrid, &
         store_maximum_velocity_h => store_maximum_velocity, &
         store_maximum_flux_h => store_maximum_flux, &
         store_twet_h => store_twet, &
         twet_threshold_h => twet_threshold, &
         q_h => q, uv_h => uv, &
         vmax_h => vmax, qmax_h => qmax, twet_h => twet
      !
      implicit none
      !
      real*4 :: dt
      !
      integer :: blocks
      integer :: istat
      !
      ! ------ Copy-IN ----------------------------------------------------
      !
      ! Init-time arrays (kcs, zb, z_index_uv_*, subgrid_z_zmin) are
      ! already current device-side; their H2D copies have been retired.
      !
      ! zs is device-canonical across the entire per-step loop (SOR-65):
      ! no per-step zs bridge-IN. The kcs==6 (Neumann) host write in
      ! update_boundary_conditions that was the sole justification for the
      ! former `zs = zs_h` (catalog Section C.3) is now the on-device
      ! k_update_neumann_zs kernel; zs_h is no longer refreshed per-step
      ! so bridging it in would clobber the canonical device zs.
      !
      ! q and uv are retained because sfincs_nonhydrostatic.f90:664-665
      ! writes the host aliases every nonhydrostatic step
      ! (compute_nonhydrostatic is called from sfincs_lib.F90:659 between
      ! compute_fluxes and compute_water_levels under the USE_CUDA
      ! branch). The host-side correction must reach the device for the
      ! store-variables kernel to see the post-nonhydrostatic flux/
      ! velocity. Catalog Section D mandate: per-step host writer found
      ! -> KEEP the bridge-IN.
      !
      ! vmax / qmax / twet are retained because the dtmaxout reset cycle
      ! in sfincs_output.f90 (lines 213, 218, 228) writes their host
      ! aliases to default values each output interval, and no other
      ! per-step GPU bridge-IN propagates that reset to the device.
      !
      call bridge_in_edge_real4(q,  q_h)
      call bridge_in_edge_real4(uv, uv_h)
      !
      if (store_maximum_velocity_h) call bridge_in_cell_real4(vmax, vmax_h)
      if (store_maximum_flux_h)     call bridge_in_cell_real4(qmax, qmax_h)
      if (store_twet_h)             call bridge_in_cell_real4(twet, twet_h)
      !
      ! ------ Kernel -----------------------------------------------------
      !
      blocks = (npn_local + TPB - 1) / TPB
      !
      call k_store_variables<<<blocks, TPB>>>( &
         dt, npn_local, subgrid_h, &
         store_maximum_velocity_h, store_maximum_flux_h, store_twet_h, &
         twet_threshold_h)
      !
      istat = cudaDeviceSynchronize()
      !
      ! ------ Copy-OUT ---------------------------------------------------
      !
      if (store_maximum_velocity_h) call bridge_out_cell_real4(vmax_h, vmax)
      if (store_maximum_flux_h)     call bridge_out_cell_real4(qmax_h, qmax)
      if (store_twet_h)             call bridge_out_cell_real4(twet_h, twet)
      !
   end subroutine compute_store_variables
   !
   ! ===================================================================
   !                              KERNELS
   ! ===================================================================
   !
   ! Tiny single-threaded kernel that applies point discharges to zs in the
   ! regular (non-subgrid) path. Mirrors CPU sibling lines 87-106.
   !
   attributes(global) subroutine k_regular_discharge(dt, nsrcdrn_in, crsgeo_in)
      !
      implicit none
      !
      real*4,  value :: dt
      integer, value :: nsrcdrn_in
      logical, value :: crsgeo_in
      !
      integer :: isrc
      integer :: nm
      !
      do isrc = 1, nsrcdrn_in
         nm = nmindsrc(isrc)
         if (crsgeo_in) then
            zs(nm) = max(zs(nm) + qtsrc(isrc) * dt / cell_area_m2(nm), &
                         real(zb(nm), kind=8))
         else
            zs(nm) = max(zs(nm) + qtsrc(isrc) * dt / cell_area(z_flags_iref(nm)), &
                         real(zb(nm), kind=8))
         endif
      enddo
      !
   end subroutine k_regular_discharge
   !
   ! Per-cell regular kernel.
   !
   attributes(global) subroutine k_regular_main(dt, t, factime, npn_in, &
                                                precip_in, use_qext_in, &
                                                wavemaker_in, snapwave_in, &
                                                crsgeo_in, &
                                                store_max_zs_in)
      !
      implicit none
      !
      real*4,  value :: dt
      real*8,  value :: t
      real*4,  value :: factime
      integer, value :: npn_in
      logical, value :: precip_in
      logical, value :: use_qext_in
      logical, value :: wavemaker_in
      logical, value :: snapwave_in
      logical, value :: crsgeo_in
      logical, value :: store_max_zs_in
      !
      integer :: nm
      integer :: nmu
      integer :: nmd
      integer :: num
      integer :: ndm
      integer :: iwm
      real*4  :: qnmu
      real*4  :: qnmd
      real*4  :: qnum
      real*4  :: qndm
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      if (kcs(nm) == 1) then
         !
         if (precip_in) then
            zs(nm) = zs(nm) + netprcp(nm) * dt
         endif
         !
         if (use_qext_in) then
            zs(nm) = zs(nm) + qext(nm) * dt
         endif
         !
         nmd = z_index_uv_md(nm)
         nmu = z_index_uv_mu(nm)
         ndm = z_index_uv_nd(nm)
         num = z_index_uv_nu(nm)
         !
         if (crsgeo_in) then
            zs(nm) = zs(nm) + ( (q(nmd) - q(nmu)) / dxm(nm) &
                              + (q(ndm) - q(num)) * dyrinv(z_flags_iref(nm)) ) * dt
         else
            zs(nm) = zs(nm) + ( (q(nmd) - q(nmu)) * dxrinv(z_flags_iref(nm)) &
                              + (q(ndm) - q(num)) * dyrinv(z_flags_iref(nm)) ) * dt
         endif
         !
      endif
      !
      if (wavemaker_in) then
         if (kcs(nm) == 4) then
            !
            iwm = z_index_wavemaker(nm)
            !
            if (wavemaker_nmd(iwm) > 0) then
               qnmd = wavemaker_uvmean(wavemaker_nmd(iwm))
            else
               qnmd = q(z_index_uv_md(nm))
            endif
            !
            if (wavemaker_nmu(iwm) > 0) then
               qnmu = wavemaker_uvmean(wavemaker_nmu(iwm))
            else
               qnmu = q(z_index_uv_mu(nm))
            endif
            !
            if (wavemaker_ndm(iwm) > 0) then
               qndm = wavemaker_uvmean(wavemaker_ndm(iwm))
            else
               qndm = q(z_index_uv_nd(nm))
            endif
            !
            if (wavemaker_num(iwm) > 0) then
               qnum = wavemaker_uvmean(wavemaker_num(iwm))
            else
               qnum = q(z_index_uv_nu(nm))
            endif
            !
            zs(nm) = zs(nm) + ( (qnmd - qnmu) * dxrinv(z_flags_iref(nm)) &
                              + (qndm - qnum) * dyrinv(z_flags_iref(nm)) ) * dt
            !
         endif
      endif
      !
      if (snapwave_in) then
         zsm(nm) = factime * zs(nm) + (1.0 - factime) * zsm(nm)
         if (store_max_zs_in) then
            maxzsm(nm) = max(maxzsm(nm), zsm(nm))
         endif
      endif
      !
      if (store_max_zs_in) then
         zsmax(nm) = max(zsmax(nm), real(zs(nm), kind=4))
      endif
      !
   end subroutine k_regular_main
   !
   ! Tiny single-threaded kernel for subgrid discharges. Mirrors CPU sibling
   ! lines 311-325.
   !
   attributes(global) subroutine k_subgrid_discharge(dt, nsrcdrn_in)
      !
      implicit none
      !
      real*4,  value :: dt
      integer, value :: nsrcdrn_in
      !
      integer :: isrc
      integer :: nm
      !
      do isrc = 1, nsrcdrn_in
         nm = nmindsrc(isrc)
         if ((z_volume(nm) >= 0) .or. ((qtsrc(isrc) < 0.0) .and. (z_volume(nm) >= 0))) then
            z_volume(nm) = z_volume(nm) + qtsrc(isrc) * dt
         endif
      enddo
      !
   end subroutine k_subgrid_discharge
   !
   ! Per-cell subgrid kernel.
   !
   attributes(global) subroutine k_subgrid_main(dt, t, factime, npn_in, &
                                                subgrid_nlevels_in, dx_in, dy_in, &
                                                precip_in, use_qext_in, &
                                                wavemaker_in, snapwave_in, &
                                                use_quadtree_in, crsgeo_in, &
                                                use_storage_volume_in, &
                                                wiggle_suppression_in, &
                                                store_max_zs_in)
      !
      implicit none
      !
      real*4,  value :: dt
      real*8,  value :: t
      real*4,  value :: factime
      integer, value :: npn_in
      integer, value :: subgrid_nlevels_in
      real*4,  value :: dx_in
      real*4,  value :: dy_in
      logical, value :: precip_in
      logical, value :: use_qext_in
      logical, value :: wavemaker_in
      logical, value :: snapwave_in
      logical, value :: use_quadtree_in
      logical, value :: crsgeo_in
      logical, value :: use_storage_volume_in
      logical, value :: wiggle_suppression_in
      logical, value :: store_max_zs_in
      !
      integer :: nm
      integer :: nmu
      integer :: nmd
      integer :: num
      integer :: ndm
      integer :: iwm
      integer :: iuv
      real*4  :: dvol
      real*4  :: dzsdt
      real*4  :: a
      real*4  :: dv
      real*4  :: dzvol
      real*4  :: facint
      real*4  :: zs00
      real*4  :: zs11
      real*4  :: qnmu
      real*4  :: qnmd
      real*4  :: qnum
      real*4  :: qndm
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      dvol = 0.0
      !
      if (kcs(nm) == 1) then
         !
         nmd = z_index_uv_md(nm)
         nmu = z_index_uv_mu(nm)
         ndm = z_index_uv_nd(nm)
         num = z_index_uv_nu(nm)
         !
         if (crsgeo_in) then
            dvol = dvol + ( (q(nmd) - q(nmu)) * dyrm(z_flags_iref(nm)) &
                          + (q(ndm) - q(num)) * dxm(nm) ) * dt
         else
            if (use_quadtree_in) then
               dvol = dvol + ( (q(nmd) - q(nmu)) * dyrm(z_flags_iref(nm)) &
                             + (q(ndm) - q(num)) * dxrm(z_flags_iref(nm)) ) * dt
            else
               dvol = dvol + ( (q(nmd) - q(nmu)) * dy_in &
                             + (q(ndm) - q(num)) * dx_in ) * dt
            endif
         endif
      endif
      !
      if (wavemaker_in .and. kcs(nm) == 4) then
         !
         iwm = z_index_wavemaker(nm)
         !
         if (wavemaker_nmd(iwm) > 0) then
            qnmd = wavemaker_uvmean(wavemaker_nmd(iwm))
         else
            qnmd = q(z_index_uv_md(nm))
         endif
         !
         if (wavemaker_nmu(iwm) > 0) then
            qnmu = wavemaker_uvmean(wavemaker_nmu(iwm))
         else
            qnmu = q(z_index_uv_mu(nm))
         endif
         !
         if (wavemaker_ndm(iwm) > 0) then
            qndm = wavemaker_uvmean(wavemaker_ndm(iwm))
         else
            qndm = q(z_index_uv_nd(nm))
         endif
         !
         if (wavemaker_num(iwm) > 0) then
            qnum = wavemaker_uvmean(wavemaker_num(iwm))
         else
            qnum = q(z_index_uv_nu(nm))
         endif
         !
         if (use_quadtree_in) then
            dvol = dvol + ( (qnmd - qnmu) * dyrm(z_flags_iref(nm)) &
                          + (qndm - qnum) * dxrm(z_flags_iref(nm)) ) * dt
         else
            dvol = dvol + ( (qnmd - qnmu) * dy_in &
                          + (qndm - qnum) * dx_in ) * dt
         endif
         !
      endif
      !
      if (kcs(nm) == 1 .or. kcs(nm) == 4) then
         !
         if (crsgeo_in) then
            a = cell_area_m2(nm)
         else
            a = cell_area(z_flags_iref(nm))
         endif
         !
         if (precip_in .or. use_qext_in) then
            !
            dzsdt = 0.0
            if (precip_in)   dzsdt = dzsdt + netprcp(nm)
            if (use_qext_in) dzsdt = dzsdt + qext(nm)
            !
            dvol = dvol + dzsdt * a * dt
            !
         endif
         !
         if (use_storage_volume_in) then
            if (storage_volume(nm) > 1.0e-6 .and. dvol > 0.0) then
               dv = storage_volume(nm) - dvol
               storage_volume(nm) = max(dv, 0.0)
               if (dv < 0.0) then
                  dvol = - dv
               else
                  dvol = 0.0
               endif
            endif
         endif
         !
         z_volume(nm) = z_volume(nm) + dvol
         !
         if (wiggle_suppression_in) then
            zs00    = zs0(nm)
            zs11    = real(zs(nm), kind=4)
            zs0(nm) = zs11
         endif
         !
         if (z_volume(nm) >= subgrid_z_volmax(nm) * 0.999) then
            zs(nm) = max(subgrid_z_zmax(nm), -20.0) &
                    + (z_volume(nm) - subgrid_z_volmax(nm)) / a
         elseif (z_volume(nm) <= 1.0e-6) then
            zs(nm) = max(subgrid_z_zmin(nm), -20.0)
         else
            dzvol  = subgrid_z_volmax(nm) / (subgrid_nlevels_in - 1)
            iuv    = int(z_volume(nm) / dzvol) + 1
            facint = (z_volume(nm) - (iuv - 1) * dzvol) / dzvol
            zs(nm) = subgrid_z_dep(iuv, nm) &
                    + (subgrid_z_dep(iuv + 1, nm) - subgrid_z_dep(iuv, nm)) * facint
         endif
         !
         if (wiggle_suppression_in) then
            zsderv(nm) = real(zs(nm), kind=4) - 2.0 * zs11 + zs00
         endif
         !
      endif
      !
      if (snapwave_in) then
         zsm(nm) = factime * real(zs(nm), kind=4) + (1.0 - factime) * zsm(nm)
         if (store_max_zs_in) then
            maxzsm(nm) = max(maxzsm(nm), zsm(nm))
         endif
      endif
      !
      if (store_max_zs_in) then
         zsmax(nm) = max(zsmax(nm), real(zs(nm), kind=4))
      endif
      !
   end subroutine k_subgrid_main
   !
   ! Per-cell store-variables kernel.
   !
   attributes(global) subroutine k_store_variables(dt, npn_in, subgrid_in, &
                                                   store_vmax_in, store_qmax_in, &
                                                   store_twet_in, twet_threshold_in)
      !
      implicit none
      !
      real*4,  value :: dt
      integer, value :: npn_in
      logical, value :: subgrid_in
      logical, value :: store_vmax_in
      logical, value :: store_qmax_in
      logical, value :: store_twet_in
      real*4,  value :: twet_threshold_in
      !
      integer :: nm
      integer :: nmu
      integer :: nmd
      integer :: num
      integer :: ndm
      real*4  :: quz
      real*4  :: qvz
      real*4  :: qz
      real*4  :: uvz
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      qz  = 0.0
      uvz = 0.0
      !
      if (kcs(nm) == 1 .or. kcs(nm) == 4) then
         !
         nmd = z_index_uv_md(nm)
         nmu = z_index_uv_mu(nm)
         ndm = z_index_uv_nd(nm)
         num = z_index_uv_nu(nm)
         !
         if (store_vmax_in) then
            quz = (uv(nmd) + uv(nmu)) / 2
            qvz = (uv(ndm) + uv(num)) / 2
            uvz = sqrt(quz**2 + qvz**2)
            vmax(nm) = max(vmax(nm), uvz)
         endif
         !
         if (store_qmax_in) then
            quz = (q(nmd) + q(nmu)) / 2
            qvz = (q(ndm) + q(num)) / 2
            qz  = sqrt(quz**2 + qvz**2)
            qmax(nm) = max(qmax(nm), qz)
         endif
         !
         if (store_twet_in) then
            if (subgrid_in) then
               if ((real(zs(nm), kind=4) - subgrid_z_zmin(nm)) > twet_threshold_in) then
                  twet(nm) = twet(nm) + dt
               endif
            else
               if ((real(zs(nm), kind=4) - zb(nm)) > twet_threshold_in) then
                  twet(nm) = twet(nm) + dt
               endif
            endif
         endif
         !
      endif
      !
   end subroutine k_store_variables
   !
end module sfincs_continuity
