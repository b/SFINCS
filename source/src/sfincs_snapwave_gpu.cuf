module sfincs_snapwave
   !
   ! GPU sibling of source/src/sfincs_snapwave.f90.
   !
   ! Re-exports the CPU sibling's full module-level state and helper API
   ! through `use sfincs_snapwave_init` / `use sfincs_snapwave_io`. The
   ! per-step coupling routine update_wave_field is reimplemented here as
   ! a D2H / H2D bracket around an UNCHANGED host-side call into the CPU
   ! SnapWave solver (modules under source/src/snapwave/). The SnapWave
   ! solver itself stays CPU per the architect's directive.
   !
   ! Bridge-IN (D2H): refresh host-side zs / windu / windv (and zsm if a
   ! wavemaker is active) from their device shadows so the host loops
   ! computing snapwave_depth / snapwave_u10 / snapwave_u10dir read fresh
   ! state. Required during the staging period because unported per-step
   ! modules write only to host arrays and leave the device shadows stale.
   !
   ! Bridge-OUT (H2D): publish fwuv (the wave forcing read by the GPU
   ! momentum kernel on the next step) and hm0 / hm0_ig (read by the GPU
   ! wavemaker kernel from sfincs_wavemaker_gpu.cuf on the next step)
   ! back to the device shadows. Without H2D-publication of hm0 / hm0_ig
   ! the wavemaker kernel would read stale device shadows on every step
   ! except the first.
   !
   use cudafor
   use mpi
   use sfincs_log
   use sfincs_error
   use sfincs_snapwave_init
   use sfincs_snapwave_io
   use sfincs_data_device, only: &
      zs_dev     => zs, &
      zsm_dev    => zsm, &
      maxzsm_dev => maxzsm, &
      windu_dev  => windu, &
      windv_dev  => windv, &
      fwuv_dev   => fwuv, &
      hm0_dev    => hm0, &
      hm0_ig_dev => hm0_ig, &
      mpi_rank, mpi_size, &
      npn_local, npuv_local, &
      local_to_global, local_to_global_uv, &
      gather_recvcounts, gather_displacements, &
      gather_perrank_local_to_global, &
      gather_uv_recvcounts, gather_uv_displacements, &
      gather_perrank_local_to_global_uv
   use sfincs_partition, only: &
      bridge_in_cell_real4, bridge_in_edge_real4, &
      bridge_out_cell_real4, bridge_out_cell_real8
   !
   implicit none
   !
   private :: compute_snapwave
   !
contains
   !
   subroutine update_wave_field(t, tloop)
   !
   use sfincs_data
   !
   implicit none
   !
   integer  :: count0
   integer  :: count1
   integer  :: count_rate
   integer  :: count_max
   real     :: tloop
   !
   real*4   :: u10, u10dir
   !
   real*4,    dimension(:), allocatable       :: fwx0
   real*4,    dimension(:), allocatable       :: fwy0
   real*4,    dimension(:), allocatable       :: dw0
   real*4,    dimension(:), allocatable       :: df0
   real*4,    dimension(:), allocatable       :: dwig0
   real*4,    dimension(:), allocatable       :: dfig0
   real*4,    dimension(:), allocatable       :: cg0
   real*4,    dimension(:), allocatable       :: beta0
   real*4,    dimension(:), allocatable       :: srcig0
   real*4,    dimension(:), allocatable       :: alphaig0
   integer   :: ip, nm, nmu, idir
   real*8    :: t
   !
   ! ===== gpu-multi-gpu (SOR-711) ===========================================
   ! Multi-rank gather/scatter scratch buffers. The CPU SnapWave solver runs
   ! against the full unpartitioned mesh on rank 0 only; under mpi_size > 1
   ! every rank contributes its rank-local slice of zs / windu / windv via
   ! MPI_Gatherv, rank 0 unpacks into its full-size host arrays, runs the
   ! solver, then MPI_Scatterv-s the resulting fwuv slices back. Buffers
   ! sized for owned cells / uv on each rank, plus a flat npn_h / npuv_h
   ! receive (rank 0) / send (rank 0) view used during pack/unpack.
   !
   real*4,    dimension(:), allocatable       :: gather_send_zs
   real*4,    dimension(:), allocatable       :: gather_send_windu
   real*4,    dimension(:), allocatable       :: gather_send_windv
   real*4,    dimension(:), allocatable       :: gather_recv_flat
   real*4,    dimension(:), allocatable       :: scatter_send_flat
   real*4,    dimension(:), allocatable       :: scatter_recv_fwuv
   integer   :: i, k, ierr
   integer   :: total_npn_gathered, total_npuv_gathered
   !
   call system_clock(count0, count_rate, count_max)
   !
   ! ===== Bridge-IN: D2H copies of arrays the host loops below read =====
   !
   ! Refresh host-side SFINCS state from the device shadows so the host
   ! loops computing snapwave_depth / snapwave_u10 / snapwave_u10dir see
   ! fresh values produced by GPU kernels earlier in the step. zsm is
   ! only read when a wavemaker is active (see CPU sibling). Under
   ! mpi_size > 1 the rank-local slice is still authoritative on each
   ! rank's device shadow; the gather below assembles rank 0's full-size
   ! global view from those slices.
   !
   ! Whole-array assignment between the host array (size np_h on every
   ! rank) and the device shadow (size npn_local + halo_cell_count, which
   ! differs from np_h on every rank when mpi_size > 1) reallocates the
   ! host LHS to match the RHS shape under nvfortran -Mallocatable=03.
   ! Once reallocated, the subsequent gather pack zs(local_to_global(i))
   ! reads through global indices that exceed the new host-array bound
   ! and produces an out-of-bounds read (SIGSEGV at 0x20 / malloc
   ! corruption observed in the SOR-47 reproducer). The per-slot
   ! bridge_out_cell_* helpers copy device(1:npn_local) into a temp and
   ! scatter through local_to_global into the host array at its existing
   ! shape, leaving size(zs) == np_h intact.
   !
   call bridge_out_cell_real8(zs, zs_dev)
   !
   ! SOR-67, Phase 3: zsm / maxzsm are device-canonical between
   ! SnapWave coupling steps. Their per-step D2H copies that used to
   ! live in compute_water_levels_regular / _subgrid have moved here so
   ! they fire at `dtwave` cadence (every update_wave_field call)
   ! instead of every per-step compute_water_levels call. The bridge is
   ! unconditional (was wavemaker-gated for zsm only): zsm is read by
   ! the host loop below when wavemaker is on, and maxzsm is read at
   ! output cadence (output catches it independently through
   ! device_to_host_for_output -- this bridge also keeps the
   ! snapwave-cadence host shadow current for any future consumer).
   !
   call bridge_out_cell_real4(zsm,    zsm_dev)
   call bridge_out_cell_real4(maxzsm, maxzsm_dev)
   !
   if (wind .and. snapwavewind) then
      call bridge_out_cell_real4(windu, windu_dev)
      call bridge_out_cell_real4(windv, windv_dev)
   endif
   !
   ! ===== Multi-rank gather: rank-local slices -> rank 0 global host =====
   !
   ! Per AC #2 / AC #3 of SOR-711: each rank packs its owned cells (in
   ! local_to_global(1:npn_local) order) into a contiguous send buffer,
   ! MPI_Gatherv-s to rank 0, and rank 0 scatters the gathered flat buffer
   ! back into its full-size host arrays at the global cell positions
   ! recorded by gather_perrank_local_to_global. mpi_size == 1 short-
   ! circuits the entire block: rank 0 already owns everything, the
   ! bridge-IN above already populated the global host arrays, and the
   ! existing solver path runs unchanged.
   !
   if (mpi_size > 1) then
      total_npn_gathered = sum(gather_recvcounts)
      allocate(gather_send_zs(max(npn_local, 1)))
      do i = 1, npn_local
         gather_send_zs(i) = real(zs(local_to_global(i)), kind=4)
      end do
      if (mpi_rank == 0) then
         allocate(gather_recv_flat(max(total_npn_gathered, 1)))
      else
         allocate(gather_recv_flat(1))
      end if
      call mpi_gatherv(gather_send_zs, npn_local, MPI_REAL, &
                       gather_recv_flat, gather_recvcounts, gather_displacements, MPI_REAL, &
                       0, MPI_COMM_WORLD, ierr)
      if (mpi_rank == 0) then
         do k = 1, total_npn_gathered
            zs(gather_perrank_local_to_global(k)) = real(gather_recv_flat(k), kind=8)
         end do
      end if
      deallocate(gather_send_zs)
      !
      if (wind .and. snapwavewind) then
         allocate(gather_send_windu(max(npn_local, 1)))
         allocate(gather_send_windv(max(npn_local, 1)))
         do i = 1, npn_local
            gather_send_windu(i) = windu(local_to_global(i))
            gather_send_windv(i) = windv(local_to_global(i))
         end do
         call mpi_gatherv(gather_send_windu, npn_local, MPI_REAL, &
                          gather_recv_flat, gather_recvcounts, gather_displacements, MPI_REAL, &
                          0, MPI_COMM_WORLD, ierr)
         if (mpi_rank == 0) then
            do k = 1, total_npn_gathered
               windu(gather_perrank_local_to_global(k)) = gather_recv_flat(k)
            end do
         end if
         call mpi_gatherv(gather_send_windv, npn_local, MPI_REAL, &
                          gather_recv_flat, gather_recvcounts, gather_displacements, MPI_REAL, &
                          0, MPI_COMM_WORLD, ierr)
         if (mpi_rank == 0) then
            do k = 1, total_npn_gathered
               windv(gather_perrank_local_to_global(k)) = gather_recv_flat(k)
            end do
         end if
         deallocate(gather_send_windu, gather_send_windv)
      end if
      deallocate(gather_recv_flat)
   end if
   !
   ! ===== CPU SnapWave solver path: rank 0 only =========================
   !
   ! The unparallelised CPU solver runs against the full global mesh on
   ! rank 0. Other ranks skipped to the scatter step below; their fwuv
   ! gets filled by the scatter that follows.
   !
   if (mpi_rank == 0) then
   !
   allocate(fwx0(np))
   allocate(fwy0(np))
   allocate(dw0(np))
   allocate(df0(np))
   allocate(dwig0(np))
   allocate(dfig0(np))
   allocate(cg0(np))
   allocate(beta0(np))
   allocate(srcig0(np))
   allocate(alphaig0(np))
   !
   fwx0 = 0.0
   fwy0 = 0.0
   dw0 = 0.0
   df0 = 0.0
   dwig0 = 0.0
   dfig0 = 0.0
   cg0 = 0.0
   beta0 = 0.0
   srcig0 = 0.0
   alphaig0 = 0.0
   !
   ! Determine SnapWave water depth
   !
   do nm = 1, snapwave_no_nodes
      !
      ip = index_sfincs_in_snapwave(nm) ! matching index in SFINCS mesh
      !
      if (ip > 0) then
         !
         ! A matching SFINCS point is found
         !

         if (wavemaker) then
            !
            snapwave_depth(nm) = max(zsm(ip) - snapwave_z(nm), 0.00001)
            !
         else
            !
            snapwave_depth(nm) = max(zs(ip) - snapwave_z(nm), 0.00001)
            !
         endif
         !
      else
         !
         ! Use 0.0 water level
         !
         snapwave_depth(nm) = max(0.0 - snapwave_z(nm), 0.00001)
         !
      endif
      !
   enddo
   !
   ! Determine SnapWave wind
   !
   if (wind) then ! =We have wind inputs given to SFINCS
      !
      if (snapwavewind) then ! =We have windgrowth in SnapWave turned on
          !
          do nm = 1, snapwave_no_nodes
             !
             ip = index_sfincs_in_snapwave(nm) ! matching index in SFINCS mesh
             !
             if (ip>0) then
                !
                ! A matching SFINCS point is found
                !
                ! Convert to umag & dir, as in ncoutput_update_his:
                !
                u10 = sqrt(windu(ip)**2 + windv(ip)**2)
                !
                u10dir = atan2(windv(ip), windu(ip))*180/pi
                !
	            if (u10dir<0.0) u10dir = u10dir + 360.0
                if (u10dir>360.0) u10dir = u10dir - 360.0
                !
                snapwave_u10(nm) = max(u10, 0.0)
                snapwave_u10dir(nm) = u10dir / 180.0 * pi ! from nautical coming from in degrees to cartesian going to in radians
                !
             else
                !
                ! Use 0.0 wind speed and direction
                !
                snapwave_u10(nm) = 0.0
                snapwave_u10dir(nm) = 0.0
                !
             endif
             !
          enddo
          !
      endif
      !
   endif
   !
   call compute_snapwave(t)
   !
   do nm = 1, np
      !
      ip = index_snapwave_in_sfincs(nm) ! matching index in SFINCS mesh
      !
      if (ip>0) then
         !
         hm0(nm)    = snapwave_H(ip)
         hm0_ig(nm) = snapwave_H_ig(ip)
         sw_tp(nm)    = snapwave_Tp(ip)
         sw_tp_ig(nm) = snapwave_Tp_ig(ip)
         fwx0(nm)   = snapwave_Fx(ip)
         fwy0(nm)   = snapwave_Fy(ip)
         dw0(nm)    = snapwave_Dw(ip)
         df0(nm)    = snapwave_Df(ip)
         dwig0(nm)  = snapwave_Dwig(ip)
         dfig0(nm)  = snapwave_Dfig(ip)
         cg0(nm)    = snapwave_cg(ip)
         beta0(nm)  = snapwave_beta(ip)
         srcig0(nm) = snapwave_srcig(ip)
         alphaig0(nm) = snapwave_alphaig(ip)
         if (store_wave_direction) then
            mean_wave_direction(nm) = snapwave_mean_direction(ip)
            wave_directional_spreading(nm) = snapwave_directional_spreading(ip)*180/pi
         endif
         !
      else
         !
         ! SnapWave point outside active SFINCS domain
         !
         hm0(nm)    = 0.0
         hm0_ig(nm) = 0.0
         sw_tp(nm)  = 0.0
         sw_tp_ig(nm) = 0.0
         fwx0(nm)   = 0.0
         fwy0(nm)   = 0.0
         dw0(nm)    = 0.0
         df0(nm)    = 0.0
         dwig0(nm)  = 0.0
         dfig0(nm)  = 0.0
         cg0(nm)    = 0.0
         beta0(nm)  = 0.0
         srcig0(nm) = 0.0
         alphaig0(nm) = 0.0
         if (store_wave_direction) then
            mean_wave_direction(nm)        = 0.0
            wave_directional_spreading(nm) = 0.0
         endif
         !
      endif
      !
      if (store_wave_forces) then
         !
         fwx(nm)        = fwx0(nm)
         fwy(nm)        = fwy0(nm)
         dw(nm)         = dw0(nm)
         df(nm)         = df0(nm)
         dwig(nm)       = dwig0(nm)
         dfig(nm)       = dfig0(nm)
         cg(nm)         = cg0(nm)
         betamean(nm)   = beta0(nm)
         srcig(nm)      = srcig0(nm)
         alphaig(nm)    = alphaig0(nm)
         !
      endif
      !
   enddo
   !
   hm0 = hm0 * sqrt(2.0)
   hm0_ig = hm0_ig * sqrt(2.0)
   !
   do ip = 1, npuv
      !
      nm   = uv_index_z_nm(ip)
      nmu  = uv_index_z_nmu(ip)
      idir = uv_flags_dir(ip) ! 0 is u, 1 is v
      !
      ! Should do better averaging for uv points that go from fine to coarse
      !
      if (idir == 0) then
         !
         ! U point
         !
         fwuv(ip) = waveforces_factor * (0.5 * (cosrot * fwx0(nm) + sinrot * fwy0(nm)) + 0.5 * ( cosrot * fwx0(nmu) + sinrot * fwy0(nmu))) / rhow
         ! waveforces_factor = 1.0 by default, but can be set to 0 to avoid double counting incident setup if wavemaker_hinc true
      else
         !
         ! V point
         !
         fwuv(ip) = waveforces_factor * (0.5 * (-sinrot * fwx0(nm) + cosrot * fwy0(nm)) + 0.5 * (-sinrot * fwx0(nmu) + cosrot * fwy0(nmu))) / rhow
         !
      endif
      !
   enddo
   !
   end if ! mpi_rank == 0
   !
   ! ===== Multi-rank scatter: rank 0 fwuv -> rank-local slices ==========
   !
   ! Per AC #5 / AC #7 of SOR-711: fwuv is uv-indexed (declared real*4
   ! dimension(npuv) in sfincs_data and assigned at fwuv(ip) where ip
   ! ranges 1..npuv in the loop above), so the scatter uses the uv
   ! mapping arrays. Rank 0 packs its full-size fwuv into a per-rank
   ! ordered send buffer (position k -> global uv id
   ! gather_perrank_local_to_global_uv(k)); MPI_Scatterv distributes
   ! npuv_local-sized slices to each rank; each rank unpacks into its
   ! host fwuv at the global uv positions recorded in
   ! local_to_global_uv(1:npuv_local). mpi_size == 1 short-circuits as
   ! with the gather above.
   !
   if (mpi_size > 1) then
      total_npuv_gathered = sum(gather_uv_recvcounts)
      if (mpi_rank == 0) then
         allocate(scatter_send_flat(max(total_npuv_gathered, 1)))
         do k = 1, total_npuv_gathered
            scatter_send_flat(k) = fwuv(gather_perrank_local_to_global_uv(k))
         end do
      else
         allocate(scatter_send_flat(1))
      end if
      allocate(scatter_recv_fwuv(max(npuv_local, 1)))
      call mpi_scatterv(scatter_send_flat, gather_uv_recvcounts, gather_uv_displacements, MPI_REAL, &
                        scatter_recv_fwuv, npuv_local, MPI_REAL, &
                        0, MPI_COMM_WORLD, ierr)
      do i = 1, npuv_local
         fwuv(local_to_global_uv(i)) = scatter_recv_fwuv(i)
      end do
      deallocate(scatter_send_flat, scatter_recv_fwuv)
   end if
   !
   ! ===== Bridge-OUT: H2D copies of arrays consumed by GPU kernels =====
   !
   ! fwuv : read by the GPU momentum kernel. Every rank publishes its
   !        rank-local slice (post-scatter, the global uv positions
   !        owned by this rank carry fresh values; non-owned positions
   !        carry stale data that other ranks' halo exchanges and own
   !        bridge-OUTs override on the device side as usual under the
   !        full-size-shadow regime).
   ! hm0 / hm0_ig : read by k_wavemaker_fluxes in sfincs_wavemaker_gpu.cuf.
   !        Only rank 0 has fresh values for these arrays (no scatter is
   !        defined for them in SOR-711's scope: it covers fwuv only).
   !        Other ranks therefore skip the H2D so they do not publish
   !        stale host data on top of whatever is already on their
   !        device shadow.
   !
   ! Whole-array assignment from the host array (size npuv_h / np_h) to
   ! the device shadow (size npuv_local + halo_edge_count / npn_local +
   ! halo_cell_count) reallocates the device LHS to the host's global
   ! size under nvfortran -Mallocatable=03, breaking the local-indexed
   ! kernel reads on subsequent steps. The bridge_in_* helpers push only
   ! the owned rank-local slice (1..npuv_local / 1..npn_local) into the
   ! device shadow at the matching local positions; halo cells are
   ! refreshed by halo_exchange_q_uv / per-step bridge-OUTs as usual.
   !
   call bridge_in_edge_real4(fwuv_dev, fwuv)
   if (mpi_rank == 0) then
      call bridge_in_cell_real4(hm0_dev,    hm0)
      call bridge_in_cell_real4(hm0_ig_dev, hm0_ig)
   end if
   !
   call system_clock(count1, count_rate, count_max)
   tloop = tloop + 1.0*(count1 - count0)/count_rate
   !
   end subroutine


   subroutine compute_snapwave(t)
   !
   use snapwave_data
   use snapwave_solver
   use snapwave_boundaries
   !
   real*8    :: t
   integer   :: k
   !
   depth = snapwave_depth
   !
   zb = snapwave_z
   !
   u10 = snapwave_u10
   u10dir = snapwave_u10dir
   !
   ! TL: we use depth now in boundary conditions for Herbers bc determination of Hm0ig, in this order we use updated values of depth through SFINCS
   !
   call update_boundary_conditions(t) ! SnapWave boundary conditions
   !
   call compute_wave_field()
   !
   snapwave_H                     = H
   snapwave_H_ig                  = H_ig
   snapwave_Tp                    = Tp
   snapwave_Tp_ig                 = Tp_ig
   snapwave_mean_direction        = modulo(270.0 - thetam * 180 / pi + 360.0, 360.0)
   snapwave_directional_spreading = thetam  ! TL: CORRECT? > is not spreading but mean direction?
   snapwave_Dw                    = Dw
   snapwave_Df                    = Df
   snapwave_Dwig                  = Dw_ig
   snapwave_Dfig                  = Df_ig
   snapwave_cg                    = cg
   snapwave_beta                  = beta
   snapwave_srcig                 = srcig
   snapwave_alphaig               = alphaig
   !
   ! Convert wave force to correct unit [Dw/C] as expected by SFINCS, assumed to be piecewise (seems to work)
   snapwave_Fx                    = Fx * rho * depth
   snapwave_Fy                    = Fy * rho * depth
   !
   ! Loop over points and set Tp, cg, direction, spreading to 0 where H and/or H_ig are zero
   ! TL: needed because e.g. Tp is set to Tpini initially, so shows values even if cell remains dry with H=0
   do k = 1, no_nodes
       if (snapwave_H(k) <= 0.0) then
           snapwave_Tp(k) = 0.0
           snapwave_mean_direction(k) = 0.0
           snapwave_directional_spreading(k) = 0.0
           snapwave_cg(k) = 0.0
       endif
       !
       if (snapwave_H_ig(k) <= 0.0) then
           snapwave_Tp_ig(k) = 0.0
       endif
   enddo
   !
   ! Wave periods from SnapWave, used in e.g. wavemakers - TL: moved behind call update_boundary_conditions & compute_wave_field so values at first timestep are not 0
   !
   snapwave_hsmean = hsmean_bwv
   snapwave_tpmean = tpmean_bwv
   !
   ! Do quick check whether incoming Tpig value seems realistic, before using it:
   if (igwaves) then
       !
       snapwave_tpigmean = tpmean_bwv_ig
       !
       if (snapwave_tpigmean < 10.0) then
           ! These warnings should not occur here
	       write(logstr,*)'DEBUG SFINCS_SnapWave - incoming tp for IG wave at wavemaker might be unrealistically small! value: ',snapwave_tpigmean
           call write_log(logstr, 0)
       elseif (snapwave_tpigmean > 250.0) then
	       write(logstr,*)'DEBUG SFINCS_SnapWave - incoming tp for IG wave at wavemaker might be unrealistically large! value: ',snapwave_tpigmean
           call write_log(logstr, 0)
       endif
   endif
   ! TL: NOTE - in first timestep run of SnapWave tp = 0, therefore excluded that case from the check
   !
   end subroutine

end module
