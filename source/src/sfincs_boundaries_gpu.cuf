module sfincs_boundaries
   !
   ! GPU sibling of source/src/sfincs_boundaries.f90.
   !
   ! Shadows the CPU module's public surface. Orchestrator-called entry points
   ! (read_boundary_data, find_boundary_indices, update_boundaries) are public;
   ! the per-step internals and IO helpers are private.
   !
   ! IO surface (read_boundary_data, find_boundary_indices, find_sfincs_cell,
   ! clean_line) trampolines into sfincs_boundaries_io. The two host-side
   ! per-step helpers (update_boundary_points, update_boundary_conditions) and
   ! weighted_average run on the host: time-series interpolation belongs on the
   ! rank that owns each boundary cell, which in single-rank is local. Only
   ! update_boundary_fluxes is ported to a CUDA Fortran kernel.
   !
   ! Bridge convention (gpu-foundation): host-side `use sfincs_data` arrays are
   ! suffixed _h via USE-rename; device-side `use sfincs_data_device` arrays
   ! are suffixed _d. CUDA Fortran translates `<dev> = <host>` and vice-versa
   ! to cudaMemcpy at the assignment level.
   !
   ! Per-step bridge-IN trim (gpu-bridge-in-trim, SOR-785): inside
   ! update_boundary_fluxes, every kernel-read array that is init-time-only
   ! (mesh / mask / boundary index catalogs, geometry, subgrid tables,
   ! ibuvdir) or written on-device the previous step with no host writer
   ! in between (q, uv, uvmean, z_volume, zsmax) has had its `<dev> =
   ! <host>` line dropped because the device shadow is already current.
   ! Retentions:
   !   zsb / zsb0 : update_boundary_conditions runs on host immediately
   !     before update_boundary_fluxes every step and writes
   !     zsb_h(ib) / zsb0_h(ib) per catalog Section C.2.
   !
   ! zs device-canonical (SOR-65): zs is now device-resident across the
   ! whole per-step loop. The three per-step host touches of zs that used
   ! to live in update_boundary_conditions / update_boundary_fluxes are
   ! all ported to device kernels launched from update_boundary_conditions
   ! before update_boundary_fluxes' k_update_boundary_fluxes:
   !   * kcs==6 Neumann lateral copy -> k_update_neumann_zs
   !   * kcs==5 downstream-river stencil (zsb from device zs) ->
   !     k_update_river_zsb
   !   * kcs==2/5 boundary-condition fan-out write zs(nmb)=zsb(indb) ->
   !     k_apply_boundary_zs (extracted from the tail of
   !     k_update_boundary_fluxes so the whole boundary-conditions phase
   !     finishes before the flux kernel reads the refreshed zsb).
   ! Consequently the per-step zs bridge-IN (was in update_boundary_fluxes
   ! copy-IN) and the per-step zs bridge-OUT (was in update_boundary_fluxes
   ! copy-OUT) are dropped. The zsb/zsb0 H2D bridge moves to
   ! update_boundary_conditions so the three new device kernels see
   ! the kcs==2 entries the host OMP loop just wrote; k_update_river_zsb
   ! overwrites the kcs==5 entries from the device zs stencil; the
   ! kcs==2 bridge-IN of zsb/zsb0 is therefore *not* repeated in
   ! update_boundary_fluxes (zsb/zsb0 are device-current on entry).
   ! Host zs_h is refreshed only at the existing output / SnapWave-coupling
   ! sync points (device_to_host_for_output, update_wave_field) -- no new
   ! sync points are introduced. The store_t_zsmax host loop below still
   ! reads zs_h but is gated off in every validation case (storetzsmax=0);
   ! see the note at that block.
   !
   use cudafor
   use mpi
   use sfincs_data_device
   use sfincs_log
   use sfincs_error
   use sfincs_partition, only: &
      bridge_in_cell_real4, bridge_in_cell_real8, bridge_in_edge_real4, &
      bridge_out_cell_real4, bridge_out_cell_real8, &
      bridge_out_cell_int1, bridge_out_cell_int4, &
      bridge_out_edge_real4, bridge_out_edge_int1
   use sfincs_boundaries_io, only: io_read_boundary_data    => read_boundary_data, &
                                   io_find_boundary_indices => find_boundary_indices, &
                                   io_find_sfincs_cell      => find_sfincs_cell, &
                                   io_clean_line            => clean_line, &
                                   io_interpolate_boundary_points => interpolate_boundary_points, &
                                   io_interpolate_boundary_zsb    => interpolate_boundary_zsb
   use sfincs_nvtx, only: nvtx_range_push, nvtx_range_pop
   !
   implicit none
   !
   private
   public :: read_boundary_data, find_boundary_indices, update_boundaries
   !
   integer, parameter :: TPB = 128   ! threads per block
   !
   ! Per-step host workbuf for the time-series-derived (kcs==2) boundary
   ! water levels. Sized to the global boundary count `size(nmindbnd_h)`
   ! on first call; the dimension is identical on every rank because
   ! nmindbnd_h is the host-side global array allocated by
   ! initialize_domain BEFORE partition_and_localize() runs. Rank 0
   ! interpolates into the workbuf each step, the workbuf is
   ! MPI_Bcast-ed to every rank, and each rank fans the workbuf into
   ! its rank-local subset of zsb / zsb0.
   !
   real*4,  allocatable, save :: zsb_global_workbuf(:)
   real*4,  allocatable, save :: zsb0_global_workbuf(:)
   logical, allocatable, save :: bnd_is_local(:)
   logical,              save :: bnd_first_call = .true.
   !
contains

   subroutine read_boundary_data()
   !
   ! Trampoline to sfincs_boundaries_io::read_boundary_data
   !
   implicit none
   !
   call io_read_boundary_data()
   !
   end subroutine


   subroutine find_boundary_indices()
   !
   ! Trampoline to sfincs_boundaries_io::find_boundary_indices
   !
   implicit none
   !
   call io_find_boundary_indices()
   !
   end subroutine


   subroutine update_boundary_points(t)
   !
   ! Time-interpolation of zs_bnd / zsi_bnd onto zst_bnd / zsit_bnd.
   ! GPU sibling: rank 0 interpolates; the result is MPI_Bcast-ed to all
   ! ranks. The interpolation depends only on bnd-file data (replicated
   ! on every rank by read_boundary_data, which runs before partition),
   ! so doing it on rank 0 and broadcasting eliminates any FP-reorder
   ! divergence between ranks. MPI_Bcast on mpi_size==1 is a no-op.
   !
   use sfincs_data, only: nbnd, zst_bnd, zsit_bnd, bzifile
   !
   implicit none
   !
   real*8, intent(in) :: t
   !
   integer :: ierr
   !
   if (nbnd == 0) return
   !
   if (mpi_rank == 0) then
      call io_interpolate_boundary_points(t)
   endif
   !
   call mpi_bcast(zst_bnd, nbnd, MPI_REAL, 0, MPI_COMM_WORLD, ierr)
   !
   if (bzifile(1:4) /= 'none') then
      call mpi_bcast(zsit_bnd, nbnd, MPI_REAL, 0, MPI_COMM_WORLD, ierr)
   endif
   !
   end subroutine


   subroutine update_boundary_conditions(t, dt)
   !
   ! Update water level at boundary grid points.
   !
   ! GPU sibling: rank 0 computes the kcs==2 boundary water levels into
   ! zsb_global_workbuf / zsb0_global_workbuf (size = global boundary
   ! count), the workbufs are MPI_Bcast-ed to every rank, and each rank
   ! fans the workbuf into its rank-local subset of zsb_h / zsb0_h. The
   ! host loop is now restricted to the kcs==2 fan-out only; the kcs==5
   ! and kcs==6 entries depend on local model state (zs values inside
   ! this rank's slab) and so are filled on-device after the bridge-IN
   ! by the k_update_river_zsb and k_update_neumann_zs kernels.
   !
   ! After the host fan-out, zsb / zsb0 are bridged H2D once. Then three
   ! tiny device kernels run in sequence to finish the boundary-conditions
   ! phase entirely on the device shadows (SOR-65):
   !   1. k_update_neumann_zs  : zs(nmb)  = zs(nmi_gbp(ib))           (kcs==6)
   !   2. k_update_river_zsb   : zsb(ib)  = zs(index_zsi_bdr(ibdr))
   !                                       + dzs_bdr(ibdr), clamped   (kcs==5)
   !   3. k_apply_boundary_zs  : zs(nmb)  = zsb(ib)                   (kcs==2,3,5)
   ! After (3) returns, update_boundary_fluxes' k_update_boundary_fluxes
   ! reads device zsb / zs directly with no bridge-IN of either array.
   !
   ! MPI_Bcast on mpi_size==1 is a no-op (rank 0 is its own communicator),
   ! preserving the N=1 baseline bit-for-bit modulo any unavoidable FP
   ! reordering from the helper extraction.
   !
   ! USE-rename: every host array that has a device shadow at module
   ! scope (zsb / zsb0 / nmindbnd / kcs) is brought in with an `_h`
   ! suffix so the bare names in this routine refer to the device
   ! shadow from sfincs_data_device (consistent with the
   ! update_boundary_fluxes convention).
   !
   use sfincs_data, only: &
      ngbnd_h    => ngbnd, &
      nkcuv2_h   => nkcuv2, &
      bndtype_h  => bndtype, &
      subgrid_h  => subgrid, &
      neumann_boundaries_in_mask_h          => neumann_boundaries_in_mask, &
      downstream_river_boundaries_in_mask_h => downstream_river_boundaries_in_mask, &
      nmindbnd_h => nmindbnd, kcs_h => kcs, &
      zsb_h => zsb, zsb0_h => zsb0
   !
   implicit none
   !
   real*8 :: t
   real   :: dt
   !
   integer :: ib, nmb, ierr
   integer :: blocks, istat
   !
   call nvtx_range_push("bnd_conditions")
   !
   call ensure_bnd_workbufs()
   !
   ! Compute kcs==2 boundary water levels into the workbuf on rank 0.
   !
   if (mpi_rank == 0) then
      call io_interpolate_boundary_zsb(t, zsb_global_workbuf, zsb0_global_workbuf)
   endif
   !
   call mpi_bcast(zsb_global_workbuf,  size(zsb_global_workbuf),  MPI_REAL, 0, MPI_COMM_WORLD, ierr)
   call mpi_bcast(zsb0_global_workbuf, size(zsb0_global_workbuf), MPI_REAL, 0, MPI_COMM_WORLD, ierr)
   !
   ! Host fan-out loop: kcs==2 only. kcs==5 / kcs==6 are device-only now
   ! (SOR-65 AC #1a / AC #1c). Each rank still applies only to its
   ! locally-owned grid boundary points.
   !
   ! kcs = 1 : regular point
   ! kcs = 2 : water level boundary point (workbuf)
   ! kcs = 3 : outflow boundary point (set at initialization, no update)
   ! kcs = 4 : wave maker point
   ! kcs = 5 : river outflow point (dzs/dx = i) -- device, see k_update_river_zsb
   ! kcs = 6 : lateral (coastal) boundary point (Neumann) -- device, see k_update_neumann_zs
   !
   !$omp parallel private ( ib, nmb ) if(ngbnd_h > 10000)
   !$omp do schedule(dynamic, 64)
   do ib = 1, ngbnd_h
      !
      if (.not. bnd_is_local(ib)) cycle
      !
      nmb = nmindbnd_h(ib)
      !
      if (kcs_h(nmb) == 2) then
         !
         zsb_h(ib)  = zsb_global_workbuf(ib)
         zsb0_h(ib) = zsb0_global_workbuf(ib)
         !
      endif
      !
   enddo
   !$omp end do
   !$omp end parallel
   !
   ! ----- Bridge zsb / zsb0 H2D (moved here from update_boundary_fluxes) ----
   !
   ! The kcs==2 fan-out just wrote zsb_h / zsb0_h on the host; the kcs==5
   ! kernel below overwrites those entries' kcs==5 slots from the device
   ! zs stencil, and k_apply_boundary_zs reads the merged zsb shadow.
   ! update_boundary_fluxes therefore needs no zsb / zsb0 bridge-IN of
   ! its own (catalog Section C.2 -- the bridge moves with its consumers).
   !
   call nvtx_range_push("bnd_conditions_copyin")
   zsb  = zsb_h
   zsb0 = zsb0_h
   call nvtx_range_pop()
   !
   ! Neumann (kcs==6) lateral water-level update, on-device. zs is
   ! device-canonical across the per-step loop (SOR-65). Gated on
   ! neumann_boundaries_in_mask, which is exactly the predicate that
   ! guards the host-side allocation of nmi_gbp, so nmi_gbp is allocated
   ! on host (hence its device shadow exists) whenever this fires. Writes
   ! zs(nmb) for kcs==6 cells; k_update_boundary_fluxes returns early for
   ! kcs==6 so the update does not interact with the flux kernel.
   !
   if (neumann_boundaries_in_mask_h .and. ngbnd_h > 0) then
      call nvtx_range_push("bnd_neumann_zs")
      blocks = (ngbnd_h + TPB - 1) / TPB
      call k_update_neumann_zs<<<blocks, TPB>>>(ngbnd_h, npn_local)
      istat = cudaDeviceSynchronize()
      call nvtx_range_pop()
   endif
   !
   ! Downstream-river (kcs==5) zsb / zsb0 update, on-device (SOR-65 AC #1a).
   ! Reads device zs at the bdr internal point (kcs==1 cell), adds the
   ! per-bdr slope*distance offset, clamps to subgrid_z_zmin / zb, and
   ! writes device zsb / zsb0 for that boundary point. Gated on
   ! downstream_river_boundaries_in_mask (the predicate that guards the
   ! host-side allocation of index_bdr_gbp), so the device shadows of
   ! index_bdr_gbp / index_zsi_bdr / dzs_bdr exist whenever this fires.
   !
   if (downstream_river_boundaries_in_mask_h .and. ngbnd_h > 0) then
      call nvtx_range_push("bnd_river_zsb")
      blocks = (ngbnd_h + TPB - 1) / TPB
      call k_update_river_zsb<<<blocks, TPB>>>(ngbnd_h, npn_local, subgrid_h)
      istat = cudaDeviceSynchronize()
      call nvtx_range_pop()
   endif
   !
   ! Apply boundary-condition water level zs(nmb) = zsb(ib) on-device
   ! (SOR-65 AC #1b). Mirrors the gating in k_update_boundary_fluxes:
   ! bndtype==1 (weakly reflective, the only branch in which the CPU
   ! sibling writes zs(nmb)=zsb(indb)); skips kcs==6 (Neumann lateral,
   ! flux at kcuv=6 is solved in sfincs_momentum and does not lean on
   ! this assignment); ownership-gates via nmb in [1, npn_local].
   ! Runs before k_update_boundary_fluxes so the flux kernel reads a
   ! consistent zs(nmb) when later computing zsmax(nmb).
   !
   if (bndtype_h == 1 .and. nkcuv2_h > 0) then
      call nvtx_range_push("bnd_apply_zs")
      blocks = (nkcuv2_h + TPB - 1) / TPB
      call k_apply_boundary_zs<<<blocks, TPB>>>(nkcuv2_h)
      istat = cudaDeviceSynchronize()
      call nvtx_range_pop()
   endif
   !
   call nvtx_range_pop()
   !
   end subroutine


   subroutine ensure_bnd_workbufs()
   !
   ! Lazy first-call allocation of the per-step workbufs and the
   ! rank-local boundary point ownership mask.
   !
   ! Workbuf size = size(nmindbnd_h) = global boundary count, identical
   ! on every rank because nmindbnd_h is allocated by initialize_domain
   ! before partition_and_localize.
   !
   ! bnd_is_local(ib) is .true. iff this rank owns the cell that grid
   ! boundary point ib sits on. For mpi_size==1 every entry is .true..
   ! For mpi_size>1 we derive the ownership mask from local_to_global
   ! (persisted across partition_and_localize in sfincs_data_device):
   ! invert it into a global-to-local cell map, then look up
   ! nmindbnd_h(ib) for each ib. cell_part itself is not exposed beyond
   ! partition_and_localize, but local_to_global is sufficient for this
   ! lookup.
   !
   use sfincs_data, only: nmindbnd_h => nmindbnd, npn_h => np
   !
   implicit none
   !
   integer :: i, ib
   integer, allocatable :: global_to_local_cell(:)
   !
   if (.not. bnd_first_call) return
   !
   allocate(zsb_global_workbuf (size(nmindbnd_h)))
   allocate(zsb0_global_workbuf(size(nmindbnd_h)))
   allocate(bnd_is_local       (size(nmindbnd_h)))
   !
   if (mpi_size == 1) then
      !
      bnd_is_local = .true.
      !
   else
      !
      ! Build inverse cell map: global cell index -> local index (0 if
      ! not owned by this rank). One-time cost; deallocated below.
      !
      allocate(global_to_local_cell(npn_h))
      global_to_local_cell = 0
      do i = 1, npn_local
         global_to_local_cell(local_to_global(i)) = i
      enddo
      !
      do ib = 1, size(nmindbnd_h)
         bnd_is_local(ib) = (global_to_local_cell(nmindbnd_h(ib)) /= 0)
      enddo
      !
      deallocate(global_to_local_cell)
      !
   endif
   !
   bnd_first_call = .false.
   !
   end subroutine


   subroutine update_boundary_fluxes(dt, t)
   !
   ! Update fluxes qx and qy at boundary points (device kernel).
   !
   use sfincs_data, only: &
      nkcuv2_h => nkcuv2, bndtype_h => bndtype, &
      btfilter_h => btfilter, btrelax_h => btrelax, &
      huthresh_h => huthresh, g_h => g, &
      subgrid_nlevels_h => subgrid_nlevels, subgrid_h => subgrid, &
      store_maximum_waterlevel_h => store_maximum_waterlevel, &
      store_t_zsmax_h => store_t_zsmax, t_zsmax_h => t_zsmax, &
      kcs_h => kcs, &
      zs_h => zs, &
      uvmean_h => uvmean, zsmax_h => zsmax, &
      zsb_h => zsb, zsb0_h => zsb0, &
      nmbkcuv2_h => nmbkcuv2
   !
   implicit none
   !
   real*4           :: dt
   real*8           :: t
   !
   integer :: blocks
   integer :: istat
   integer :: ib
   integer :: nmb
   real*4  :: factime
   real*4  :: one_minus_factime
   real*4  :: facrel
   !
   if (nkcuv2_h <= 0) return
   !
   factime           = min(dt / btfilter_h, 1.0)
   one_minus_factime = 1.0 - factime
   facrel            = 1.0 - min(dt / btrelax_h, 1.0)
   !
   ! ------ Copy-IN: host -> device for kernel READ set ------------------
   ! Per audit catalog (gpu-bridge-in-trim, SOR-785): bridge-IN H2D copies
   ! for init-time-only catalog/mesh/geometry/subgrid arrays (Section A)
   ! and for arrays kept current on-device by the previous step's GPU
   ! kernels with no per-step host writer (Section B) have been dropped.
   ! zs is now device-canonical across the per-step loop (SOR-65): its
   ! per-step host writers (the kcs==6 Neumann copy AND the kcs==2/3/5
   ! boundary-condition fan-out write zs(nmb)=zsb(indb)) have all been
   ! ported to device kernels launched from update_boundary_conditions,
   ! so the former `bridge_in_cell_real8(zs, zs_h)` here is dropped --
   ! the device zs shadow is already current. zsb / zsb0 are also
   ! device-current on entry: update_boundary_conditions just bridged
   ! the kcs==2 host fan-out H2D and the on-device k_update_river_zsb
   ! kernel filled the kcs==5 entries from the device zs stencil. The
   ! former bulk `zsb = zsb_h` / `zsb0 = zsb0_h` H2D copies here are
   ! therefore dropped too (the bridge moved with its consumers --
   ! catalog Section C.2 mandate now satisfied by the producer-side
   ! bridge in update_boundary_conditions).
   ! ------ Main per-boundary-point kernel -------------------------------
   !
   call nvtx_range_push("bnd_fluxes_kernel")
   blocks = (nkcuv2_h + TPB - 1) / TPB
   !
   call k_update_boundary_fluxes<<<blocks, TPB>>>( &
      dt, factime, one_minus_factime, facrel, btfilter_h, &
      nkcuv2_h, bndtype_h, subgrid_h, &
      subgrid_nlevels_h, huthresh_h, g_h, &
      store_maximum_waterlevel_h, real(t, kind=8))
   !
   istat = cudaDeviceSynchronize()
   call nvtx_range_pop()
   !
   ! ------ Copy-OUT: device -> host for WRITE set -----------------------
   ! zs is device-canonical (SOR-65): the former `bridge_out_cell_real8(
   ! zs_h, zs)` here is dropped. The host zs_h view is refreshed only at
   ! the existing output / SnapWave-coupling sync points
   ! (device_to_host_for_output, update_wave_field).
   !
   ! q / uv are device-canonical across the per-step loop (SOR-66,
   ! Phase 2): the former `bridge_out_edge_real4(q_h, q)` and
   ! `bridge_out_edge_real4(uv_h, uv)` here are dropped. The host
   ! aliases are refreshed by the output-cadence flush
   ! (device_to_host_for_output) when output is due; in-loop consumers
   ! read the device shadow directly. zsb / zsb0 are republished
   ! (host-mutated by update_boundary_conditions; identity copy here,
   ! but kept so the host view stays canonical for those boundary-sized
   ! arrays).
   !
   call nvtx_range_push("bnd_fluxes_copyout")
   ! uvmean / zsb / zsb0 are boundary-sized (nkcuv2 / ngbnd); keep bulk D2H.
   uvmean_h = uvmean
   zsb_h    = zsb
   zsb0_h   = zsb0
   !
   if (store_maximum_waterlevel_h) then
      !
      ! Host-side t_zsmax (not in foundation catalog). NOTE (SOR-65): zs
      ! is now device-canonical, so zs_h here is NOT refreshed per-step
      ! (the zs bridge-out above was dropped). This branch only runs when
      ! store_t_zsmax (storetzsmax=1), which is off in every validation
      ! case and in case_prod_compound_snapwave, so it is gated unchanged
      ! per the issue's AC #3. Making this read device-canonical is
      ! deferred to the feature-boundary phase; if storetzsmax is enabled
      ! this loop would read a stale zs_h and must be refactored then.
      !
      if (store_t_zsmax_h .and. bndtype_h == 1) then
         do ib = 1, nkcuv2_h
            nmb = nmbkcuv2_h(ib)
            if (kcs_h(nmb) == 6) cycle  ! mirrors kernel's `if (kcs(nmb) == 6) return`
            if (real(zs_h(nmb), kind=4) > zsmax_h(nmb)) then
               t_zsmax_h(nmb) = t
            endif
         enddo
      endif
      !
      call bridge_out_cell_real4(zsmax_h, zsmax)
      !
   endif
   call nvtx_range_pop()
   !
   end subroutine


   subroutine update_boundaries(t, dt, tloop)
   !
   ! Update all boundary conditions.
   !
   use sfincs_data, only: nbnd, boundaries_in_mask, bathtub
   !
   implicit none
   !
   integer  :: count0
   integer  :: count1
   integer  :: count_rate
   integer  :: count_max
   real     :: tloop
   !
   real*8           :: t
   real*4           :: dt
   !
   call system_clock(count0, count_rate, count_max)
   !
   if (boundaries_in_mask) then
      !
      if (nbnd > 0) then
         !
         call update_boundary_points(t)
         !
      endif
      !
      if (.not. bathtub) then
         !
         call update_boundary_conditions(t, dt)
         !
         call update_boundary_fluxes(dt, t)
         !
      endif
      !
   endif
   !
   call system_clock(count1, count_rate, count_max)
   tloop = tloop + 1.0 * (count1 - count0) / count_rate
   !
   end subroutine


   subroutine weighted_average(val1, val2, fac, iopt, val3)
   !
   ! Host-callable; matches the CPU sibling's weighted_average exactly.
   !
   implicit none
   !
   integer, intent(in)    :: iopt
   real*4,  intent(in)    :: val1
   real*4,  intent(in)    :: val2
   real*4,  intent(in)    :: fac
   real*4,  intent(out)   :: val3
   !
   real*4                 :: u1
   real*4                 :: v1
   real*4                 :: u2
   real*4                 :: v2
   real*4                 :: u
   real*4                 :: v
   !
   if (iopt == 1) then
      val3 = val1*fac + val2*(1.0 - fac)
   else
      u1 = cos(val1)
      v1 = sin(val1)
      u2 = cos(val2)
      v2 = sin(val2)
      u = u1*fac + u2*(1.0 - fac)
      v = v1*fac + v2*(1.0 - fac)
      val3 = atan2(v, u)
   endif
   !
   end subroutine


   function find_sfincs_cell(n, m, iref) result (nm)
   !
   ! Trampoline to sfincs_boundaries_io::find_sfincs_cell
   !
   implicit none
   !
   integer, intent(in)  :: n
   integer, intent(in)  :: m
   integer, intent(in)  :: iref
   integer              :: nm
   !
   nm = io_find_sfincs_cell(n, m, iref)
   !
   end function


   function clean_line(s) result(out)
   !
   ! Trampoline to sfincs_boundaries_io::clean_line
   !
   character(len=*), intent(in) :: s
   character(len=len(s)) :: out
   !
   out = io_clean_line(s)
   !
   end function

   ! ===================================================================
   !                              KERNELS
   ! ===================================================================
   !
   ! Per-boundary-uv-point kernel. Mirrors the OpenACC-decorated loop in
   ! the original CPU sibling (pre-extraction lines ~951-1118): one thread
   ! per boundary u/v index ib in [1, nkcuv2_in].
   !
   attributes(global) subroutine k_update_boundary_fluxes( &
         dt, factime, one_minus_factime, facrel, btfilter_in, &
         nkcuv2_in, bndtype_in, subgrid_in, &
         subgrid_nlevels_in, huthresh_in, g_in, &
         store_max_zs_in, t_in)
      !
      implicit none
      !
      real*4,  value :: dt
      real*4,  value :: factime
      real*4,  value :: one_minus_factime
      real*4,  value :: facrel
      real*4,  value :: btfilter_in
      integer, value :: nkcuv2_in
      integer, value :: bndtype_in
      logical, value :: subgrid_in
      integer, value :: subgrid_nlevels_in
      real*4,  value :: huthresh_in
      real*4,  value :: g_in
      logical, value :: store_max_zs_in
      real*8,  value :: t_in
      !
      integer :: ib
      integer :: indb
      integer :: nmb
      integer :: nmi
      integer :: ip
      integer :: iuv
      real*4  :: zsnmi
      real*4  :: zsnmb
      real*4  :: zs0nmb
      real*4  :: zsuv
      real*4  :: depthuv
      real*4  :: dzuv
      real*4  :: facint
      real*4  :: hnmb
      real*4  :: ui
      real*4  :: ub
      !
      ib = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (ib > nkcuv2_in) return
      !
      indb = ibkcuv2(ib)
      nmb  = nmbkcuv2(ib)     ! nm index of kcs=2/3/5/6 boundary point
      nmi  = nmikcuv2(ib)     ! Index of kcs=1 point
      ip   = index_kcuv2(ib)  ! Index in uv array of kcuv=2 velocity point
      !
      ! Skip boundary points that are neither owned nor halo on this rank.
      ! On single-rank runs every boundary point is local, so this is a no-op.
      if (nmb <= 0 .or. nmi <= 0 .or. ip <= 0) return
      !
      if (kcs(nmb) == 6) return  ! Lateral boundary: fluxes solved in sfincs_momentum.
      !
      zsnmi  = real(zs(nmi), kind=4)
      zsnmb  = zsb(indb)
      zs0nmb = zsb0(indb)
      !
      if (bndtype_in == 1) then
         !
         ! Weakly reflective boundary (default)
         !
         if (subgrid_in) then
            !
            zsuv = max(zsnmb, zsnmi)
            !
            if (zsuv >= subgrid_uv_zmax(ip) - 1.0e-4) then
               depthuv = subgrid_uv_havg_zmax(ip) + zsuv
            elseif (zsuv > subgrid_uv_zmin(ip)) then
               dzuv    = (subgrid_uv_zmax(ip) - subgrid_uv_zmin(ip)) / (subgrid_nlevels_in - 1)
               iuv     = int((zsuv - subgrid_uv_zmin(ip)) / dzuv) + 1
               facint  = (zsuv - (subgrid_uv_zmin(ip) + (iuv - 1) * dzuv)) / dzuv
               depthuv = subgrid_uv_havg(iuv, ip) + (subgrid_uv_havg(iuv + 1, ip) - subgrid_uv_havg(iuv, ip)) * facint
            else
               depthuv = 0.0
            endif
            !
            hnmb   = max(depthuv, huthresh_in)
            zsnmb  = max(zsnmb,  subgrid_z_zmin(nmb))
            zs0nmb = max(zs0nmb, subgrid_z_zmin(nmb))
            !
         else
            !
            hnmb   = max(0.5 * (zsnmb + zsnmi) - zbuv(ip), huthresh_in)
            zsnmb  = max(zsnmb,  zb(nmb))
            zs0nmb = max(zs0nmb, zb(nmb))
            !
         endif
         !
         if (hnmb < huthresh_in + 1.0e-6 .or. kcuv(ip) == 3) then
            !
            ! Very shallow or also a structure point.
            !
            q(ip)      = 0.0
            uv(ip)     = 0.0
            uvmean(ib) = 0.0
            !
         else
            !
            ui = sqrt(g_in / hnmb) * (zsnmb - zs0nmb)
            ub = ibuvdir(ib) * (2 * ui - sqrt(g_in / hnmb) * (zsnmi - zs0nmb))
            !
            q(ip) = ub * hnmb + uvmean(ib)
            !
            if (subgrid_in) then
               !
               if (z_volume(nmi) <= 0.0) then
                  if (ibuvdir(ib) == 1) then
                     q(ip) = max(q(ip), 0.0)
                  else
                     q(ip) = min(q(ip), 0.0)
                  endif
               endif
               !
               if (zsnmb - subgrid_z_zmin(nmb) < huthresh_in) then
                  if (ibuvdir(ib) == 1) then
                     q(ip) = min(q(ip), 0.0)
                  else
                     q(ip) = max(q(ip), 0.0)
                  endif
               endif
               !
            else
               !
               if (zsnmi - zb(nmi) <= huthresh_in) then
                  if (ibuvdir(ib) == 1) then
                     q(ip) = max(q(ip), 0.0)
                  else
                     q(ip) = min(q(ip), 0.0)
                  endif
               endif
               !
               if (zsnmb - zb(nmb) < huthresh_in) then
                  if (ibuvdir(ib) == 1) then
                     q(ip) = min(q(ip), 0.0)
                  else
                     q(ip) = max(q(ip), 0.0)
                  endif
               endif
            endif
            !
            uv(ip) = max(min(q(ip) / hnmb, 4.0), -4.0)
            !
         endif
         !
         if (btfilter_in >= -1.0e-6) then
            uvmean(ib) = factime * q(ip) + facrel * one_minus_factime * uvmean(ib)
         else
            uvmean(ib) = 0.0
         endif
         !
         ! kcs==2/3/5 boundary-condition water-level fan-out write
         ! zs(nmb) = zsb(indb) was applied earlier in this step by
         ! k_apply_boundary_zs (launched from update_boundary_conditions,
         ! SOR-65 AC #1b). zsmax(nmb) still gets sampled here so the
         ! store_maximum_waterlevel bookkeeping continues to see the
         ! post-update value (the cell index nmb -> indb mapping is
         ! deterministic for kcs==2/3/5 cells, so zsmax reads the same
         ! value k_apply_boundary_zs wrote).
         !
         if (store_max_zs_in) then
            zsmax(nmb) = max(zsmax(nmb), real(zs(nmb), kind=4))
         endif
         !
      endif
      !
   end subroutine k_update_boundary_fluxes
   !
   ! -------------------------------------------------------------------
   ! Neumann (kcs==6) lateral boundary water-level update (SOR-65).
   !
   ! Device port of the kcs==6 branch that used to run on the host inside
   ! update_boundary_conditions:
   !
   !    do ib = 1, ngbnd
   !       if (.not. bnd_is_local(ib)) cycle
   !       nmb = nmindbnd(ib)
   !       ...
   !       elseif (kcs(nmb) == 6) then
   !          zs(nmb) = zs(nmi_gbp(ib))
   !
   ! One thread per grid boundary point ib in [1, ngbnd_in]. nmindbnd /
   ! nmi_gbp carry cell indices renumbered to this rank's local space
   ! (renumber_to_local_cell, same as nmbkcuv2 / nmikcuv2). The owned-slice
   ! test `nmb in [1, npn_local_in]` is the exact device equivalent of the
   ! host `bnd_is_local(ib)` filter (true iff the boundary cell is in this
   ! rank's owned slice; halo / non-resident boundary cells are skipped
   ! here and refreshed by halo_exchange_zs from the owning rank). zs is
   ! device-canonical, so the kcs==1 internal value is read straight from
   ! the device shadow; the assignment is a pure integer-indexed real*8
   ! copy (kcs==6 targets and kcs==1 sources are disjoint, and each nmb
   ! appears once in nmindbnd), so it is bit-identical to the serial /
   ! OpenMP host loop regardless of thread order.
   ! -------------------------------------------------------------------
   !
   attributes(global) subroutine k_update_neumann_zs(ngbnd_in, npn_local_in)
      !
      implicit none
      !
      integer, value :: ngbnd_in
      integer, value :: npn_local_in
      !
      integer :: ib
      integer :: nmb
      integer :: nmi
      !
      ib = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (ib > ngbnd_in) return
      !
      nmb = nmindbnd(ib)
      if (nmb < 1 .or. nmb > npn_local_in) return  ! mirrors .not. bnd_is_local
      !
      if (kcs(nmb) /= 6) return
      !
      nmi = nmi_gbp(ib)
      if (nmi <= 0) return  ! internal cell not resident on this rank
      !
      zs(nmb) = zs(nmi)
      !
   end subroutine k_update_neumann_zs
   !
   ! -------------------------------------------------------------------
   ! Downstream-river (kcs==5) zsb / zsb0 update (SOR-65 AC #1a).
   !
   ! Device port of the kcs==5 branch that used to run on the host inside
   ! update_boundary_conditions:
   !
   !    do ib = 1, ngbnd
   !       if (.not. bnd_is_local(ib)) cycle
   !       nmb = nmindbnd(ib)
   !       elseif (kcs(nmb) == 5) then
   !          ibdr = index_bdr_gbp(ib)
   !          zst  = zs(index_zsi_bdr(ibdr)) + dzs_bdr(ibdr)
   !          if (subgrid) then
   !             zst = max(zst, subgrid_z_zmin(nmb))
   !          else
   !             zst = max(zst, zb(nmb))
   !          endif
   !          zsb(ib)  = zst
   !          zsb0(ib) = zst
   !
   ! One thread per grid boundary point ib in [1, ngbnd_in]. The kcs==5
   ! gate matches the host CPU sibling (sfincs_boundaries.f90:127-143).
   ! `nmb in [1, npn_local_in]` mirrors `.not. bnd_is_local`. The device
   ! zs read at `index_zsi_bdr(ibdr)` is correct only when the internal
   ! cell (a kcs==1 cell) is resident on this rank as owned or halo: if
   ! the renumber mapped index_zsi_bdr(ibdr) to 0 (non-resident on this
   ! rank's slab), the kernel skips writing this entry. The owning rank
   ! still writes its own kcs==5 entries unconditionally (the host bdr
   ! catalog is global, and find_quadtree_cell picks a kcs==1 cell on
   ! the same model-side region as the boundary, so the owning rank
   ! typically holds the internal cell as owned or halo after the
   ! cycle-1 boundary halo extension).
   ! -------------------------------------------------------------------
   !
   attributes(global) subroutine k_update_river_zsb(ngbnd_in, npn_local_in, subgrid_in)
      !
      implicit none
      !
      integer, value :: ngbnd_in
      integer, value :: npn_local_in
      logical, value :: subgrid_in
      !
      integer :: ib
      integer :: nmb
      integer :: ibdr
      integer :: nmi
      real*8  :: zst
      real*8  :: zst_clamp
      !
      ib = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (ib > ngbnd_in) return
      !
      nmb = nmindbnd(ib)
      if (nmb < 1 .or. nmb > npn_local_in) return  ! mirrors .not. bnd_is_local
      !
      if (kcs(nmb) /= 5) return
      !
      ibdr = index_bdr_gbp(ib)
      if (ibdr <= 0) return  ! no bdr-file entry mapped for this gbp
      !
      nmi = index_zsi_bdr(ibdr)
      if (nmi <= 0) return  ! internal cell not resident on this rank
      !
      ! Match the CPU sibling's promotion exactly: zst is real*8, the
      ! addition with real*4 dzs_bdr is promoted, the max-with-clamp
      ! is done in real*8, and the final assignment to real*4 zsb /
      ! zsb0 carries the implicit truncation. Keeping the intermediate
      ! in real*4 would change WHAT moves, not just WHEN, breaking
      ! Phase 1's bit-identical contract.
      !
      zst = zs(nmi) + real(dzs_bdr(ibdr), kind=8)
      !
      if (subgrid_in) then
         zst_clamp = real(subgrid_z_zmin(nmb), kind=8)
      else
         zst_clamp = real(zb(nmb), kind=8)
      endif
      if (zst < zst_clamp) zst = zst_clamp
      !
      zsb(ib)  = real(zst, kind=4)
      zsb0(ib) = real(zst, kind=4)
      !
   end subroutine k_update_river_zsb
   !
   ! -------------------------------------------------------------------
   ! Boundary-condition water-level fan-out (SOR-65 AC #1b).
   !
   ! Device port of the `zs(nmb) = zsb(indb)` write that used to live at
   ! the tail of k_update_boundary_fluxes (and on the CPU sibling at
   ! sfincs_boundaries.f90:329). Iterates boundary uv-points (1..nkcuv2)
   ! -- one thread per uv-point -- so the write set exactly matches the
   ! original kernel: a kcs==2/3/5 cell only gets zs(nmb) written if it
   ! has at least one boundary uv-point. (Iterating grid boundary points
   ! 1..ngbnd would over-write: corner / sandwich cells exist in the
   ! mask that have kcs in {2,3,5,6} but no active boundary uv-point --
   ! e.g. kcs==2 corners where both face neighbours are also boundary
   ! cells get kcuv=0 -- and the CPU sibling does NOT touch zs there.)
   ! kcs==6 (Neumann) is skipped because zsb is not used for Neumann
   ! cells (their zs(nmb) is set by k_update_neumann_zs). The owned /
   ! non-resident filter mirrors k_update_boundary_fluxes' nmb/nmi/ip
   ! gate, and bndtype gating is done at the launch site (the kernel
   ! is only fired when bndtype==1).
   ! -------------------------------------------------------------------
   !
   attributes(global) subroutine k_apply_boundary_zs(nkcuv2_in)
      !
      implicit none
      !
      integer, value :: nkcuv2_in
      !
      integer :: ib
      integer :: indb
      integer :: nmb
      integer :: nmi
      integer :: ip
      !
      ib = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (ib > nkcuv2_in) return
      !
      indb = ibkcuv2(ib)
      nmb  = nmbkcuv2(ib)
      nmi  = nmikcuv2(ib)
      ip   = index_kcuv2(ib)
      !
      ! Skip boundary points that are neither owned nor halo on this rank,
      ! mirroring the early-return at the top of k_update_boundary_fluxes.
      if (nmb <= 0 .or. nmi <= 0 .or. ip <= 0) return
      !
      if (kcs(nmb) == 6) return  ! Neumann: zs(nmb) set by k_update_neumann_zs
      !
      zs(nmb) = real(zsb(indb), kind=8)
      !
   end subroutine k_apply_boundary_zs

end module
