module sfincs_data_device
   !
   ! Device-resident mirrors of host-side state declared in sfincs_data.
   !
   ! Each catalog array below is the GPU shadow of a host-side counterpart
   ! with the same Fortran type and rank. Names are deliberately bare (not
   ! suffixed _d): consumer sites disambiguate via USE-rename, e.g.
   !   use sfincs_data,        only: zs_h => zs
   !   use sfincs_data_device, only: zs_d => zs
   !
   ! Order matches the catalog in source/src/sfincs_openacc.f90 (lines 15-39)
   ! for reviewer readability.
   !
   implicit none
   !
   ! Mask / flag arrays
   !
   integer*1, device, dimension(:), allocatable :: kcs
   integer*1, device, dimension(:), allocatable :: kfuv
   integer*1, device, dimension(:), allocatable :: kcuv
   !
   ! Hydrodynamic state
   !
   real*8,    device, dimension(:), allocatable :: zs
   real*4,    device, dimension(:), allocatable :: zs0
   real*4,    device, dimension(:), allocatable :: zsderv
   real*4,    device, dimension(:), allocatable :: q
   real*4,    device, dimension(:), allocatable :: q0
   real*4,    device, dimension(:), allocatable :: uv
   real*4,    device, dimension(:), allocatable :: uv0
   real*4,    device, dimension(:), allocatable :: zb
   real*4,    device, dimension(:), allocatable :: zbuv
   real*4,    device, dimension(:), allocatable :: zbuvmx
   real*4,    device, dimension(:), allocatable :: zsmax
   real*4,    device, dimension(:), allocatable :: maxzsm
   real*4,    device, dimension(:), allocatable :: qmax
   real*4,    device, dimension(:), allocatable :: vmax
   real*4,    device, dimension(:), allocatable :: twet
   real*4,    device, dimension(:), allocatable :: zsm
   real*8,    device, dimension(:), allocatable :: z_volume
   !
   ! Topology flags
   !
   integer*1, device, dimension(:), allocatable :: z_flags_iref
   integer*1, device, dimension(:), allocatable :: uv_flags_iref
   integer*1, device, dimension(:), allocatable :: uv_flags_type
   integer*1, device, dimension(:), allocatable :: uv_flags_dir
   integer*1, device, dimension(:), allocatable :: mask_adv
   !
   ! Boundary indexing
   !
   integer*4, device, dimension(:), allocatable :: index_kcuv2
   integer*4, device, dimension(:), allocatable :: nmikcuv2
   integer*4, device, dimension(:), allocatable :: nmbkcuv2
   integer*4, device, dimension(:), allocatable :: ibkcuv2
   real*4,    device, dimension(:), allocatable :: zsb
   real*4,    device, dimension(:), allocatable :: zsb0
   integer*1, device, dimension(:), allocatable :: ibuvdir
   real*4,    device, dimension(:), allocatable :: uvmean
   !
   ! Subgrid UV tables
   !
   real*4,    device, dimension(:),   allocatable :: subgrid_uv_zmin
   real*4,    device, dimension(:),   allocatable :: subgrid_uv_zmax
   real*4,    device, dimension(:,:), allocatable :: subgrid_uv_havg
   real*4,    device, dimension(:,:), allocatable :: subgrid_uv_nrep
   real*4,    device, dimension(:,:), allocatable :: subgrid_uv_pwet
   real*4,    device, dimension(:),   allocatable :: subgrid_uv_havg_zmax
   real*4,    device, dimension(:),   allocatable :: subgrid_uv_nrep_zmax
   real*4,    device, dimension(:),   allocatable :: subgrid_uv_fnfit
   real*4,    device, dimension(:),   allocatable :: subgrid_uv_navg_w
   !
   ! Subgrid Z tables
   !
   real*4,    device, dimension(:),   allocatable :: subgrid_z_zmin
   real*4,    device, dimension(:),   allocatable :: subgrid_z_zmax
   real*4,    device, dimension(:,:), allocatable :: subgrid_z_dep
   real*4,    device, dimension(:),   allocatable :: subgrid_z_volmax
   !
   ! Z <-> UV neighbour indices
   !
   integer*4, device, dimension(:), allocatable :: z_index_uv_md
   integer*4, device, dimension(:), allocatable :: z_index_uv_nd
   integer*4, device, dimension(:), allocatable :: z_index_uv_mu
   integer*4, device, dimension(:), allocatable :: z_index_uv_nu
   integer*4, device, dimension(:), allocatable :: uv_index_z_nm
   integer*4, device, dimension(:), allocatable :: uv_index_z_nmu
   integer*4, device, dimension(:), allocatable :: uv_index_u_nmd
   integer*4, device, dimension(:), allocatable :: uv_index_u_nmu
   integer*4, device, dimension(:), allocatable :: uv_index_u_ndm
   integer*4, device, dimension(:), allocatable :: uv_index_u_num
   integer*4, device, dimension(:), allocatable :: uv_index_v_ndm
   integer*4, device, dimension(:), allocatable :: uv_index_v_ndmu
   integer*4, device, dimension(:), allocatable :: uv_index_v_nm
   integer*4, device, dimension(:), allocatable :: uv_index_v_nmu
   !
   ! Discharges & drainage
   !
   integer*4, device, dimension(:),   allocatable :: nmindsrc
   real*4,    device, dimension(:),   allocatable :: qtsrc
   integer*1, device, dimension(:),   allocatable :: drainage_type
   real*4,    device, dimension(:,:), allocatable :: drainage_params
   !
   ! Wavemaker
   !
   integer*4, device, dimension(:), allocatable :: z_index_wavemaker
   real*4,    device, dimension(:), allocatable :: wavemaker_uvmean
   integer*4, device, dimension(:), allocatable :: wavemaker_nmd
   integer*4, device, dimension(:), allocatable :: wavemaker_nmu
   integer*4, device, dimension(:), allocatable :: wavemaker_ndm
   integer*4, device, dimension(:), allocatable :: wavemaker_num
   !
   ! Structures
   !
   integer,   device, dimension(:),   allocatable :: structure_uv_index
   real*4,    device, dimension(:,:), allocatable :: structure_parameters
   integer*1, device, dimension(:),   allocatable :: structure_type
   real*4,    device, dimension(:),   allocatable :: structure_length
   !
   ! Wave forcing
   !
   real*4,    device, dimension(:), allocatable :: fwuv
   !
   ! Wind stress
   !
   real*4,    device, dimension(:), allocatable :: tauwu
   real*4,    device, dimension(:), allocatable :: tauwv
   real*4,    device, dimension(:), allocatable :: tauwu0
   real*4,    device, dimension(:), allocatable :: tauwv0
   real*4,    device, dimension(:), allocatable :: tauwu1
   real*4,    device, dimension(:), allocatable :: tauwv1
   !
   ! Wind components
   !
   real*4,    device, dimension(:), allocatable :: windu
   real*4,    device, dimension(:), allocatable :: windv
   real*4,    device, dimension(:), allocatable :: windu0
   real*4,    device, dimension(:), allocatable :: windv0
   real*4,    device, dimension(:), allocatable :: windu1
   real*4,    device, dimension(:), allocatable :: windv1
   real*4,    device, dimension(:), allocatable :: windmax
   !
   ! Atmospheric pressure
   !
   real*4,    device, dimension(:), allocatable :: patm
   real*4,    device, dimension(:), allocatable :: patm0
   real*4,    device, dimension(:), allocatable :: patm1
   real*4,    device, dimension(:), allocatable :: patmb
   integer*4, device, dimension(:), allocatable :: nmindbnd
   ! nm index of the kcs==1 internal point feeding each Neumann (kcs==6)
   ! grid boundary point. Entries are renumbered to local cell indices by
   ! renumber_to_local_cell (same treatment as nmindbnd); read on-device
   ! by k_update_neumann_zs to apply the Neumann dzs/dx=0 lateral update.
   integer*4, device, dimension(:), allocatable :: nmi_gbp
   ! Downstream-river (kcs==5) boundary catalogs. index_bdr_gbp maps grid
   ! boundary point index (1..ngbnd) to the bdr-file row index (1..nbdr);
   ! index_zsi_bdr maps the bdr-file row to a kcs==1 internal cell index
   ! (renumbered to local like nmindbnd); dzs_bdr is the slope*distance
   ! water-level offset for that bdr row. Read on-device by
   ! k_update_river_zsb to compute zsb/zsb0 from the device zs stencil.
   integer*4, device, dimension(:), allocatable :: index_bdr_gbp
   integer*4, device, dimension(:), allocatable :: index_zsi_bdr
   real*4,    device, dimension(:), allocatable :: dzs_bdr
   !
   ! Precipitation & external flux
   !
   real*4,    device, dimension(:), allocatable :: prcp
   real*4,    device, dimension(:), allocatable :: prcp0
   real*4,    device, dimension(:), allocatable :: prcp1
   real*4,    device, dimension(:), allocatable :: cumprcp
   real*4,    device, dimension(:), allocatable :: netprcp
   real*4,    device, dimension(:), allocatable :: qext
   !
   ! Geometry / metric arrays
   !
   real*4,    device, dimension(:), allocatable :: dxminv
   real*4,    device, dimension(:), allocatable :: dxrinv
   real*4,    device, dimension(:), allocatable :: dyrinv
   real*4,    device, dimension(:), allocatable :: dxm2inv
   real*4,    device, dimension(:), allocatable :: dxr2inv
   real*4,    device, dimension(:), allocatable :: dyr2inv
   real*4,    device, dimension(:), allocatable :: dxrinvc
   real*4,    device, dimension(:), allocatable :: dyrinvc
   real*4,    device, dimension(:), allocatable :: dxm
   real*4,    device, dimension(:), allocatable :: dxrm
   real*4,    device, dimension(:), allocatable :: dyrm
   real*4,    device, dimension(:), allocatable :: cell_area_m2
   real*4,    device, dimension(:), allocatable :: cell_area
   !
   ! Friction / Coriolis / storage / viscosity
   !
   real*4,    device, dimension(:), allocatable :: gn2uv
   real*4,    device, dimension(:), allocatable :: fcorio2d
   real*4,    device, dimension(:), allocatable :: storage_volume
   real*4,    device, dimension(:), allocatable :: nuvisc
   !
   ! Combined UV indexing
   !
   integer*4, device, dimension(:), allocatable :: cuv_index_uv
   integer*4, device, dimension(:), allocatable :: cuv_index_uv1
   integer*4, device, dimension(:), allocatable :: cuv_index_uv2
   !
   ! Misc
   !
   real*4,    device, dimension(:,:), allocatable :: x73
   real*4,    device, dimension(:),   allocatable :: gnapp2
   !
   ! Timestep analysis
   !
   real*4,    device, dimension(:), allocatable :: timestep_analysis_required_timestep
   real*4,    device, dimension(:), allocatable :: timestep_analysis_average_required_timestep
   integer*4, device, dimension(:), allocatable :: timestep_analysis_times_wet
   integer*4, device, dimension(:), allocatable :: timestep_analysis_times_limiting
   !
   ! Infiltration (general / SCS / Green-Ampt / Horton)
   !
   real*4,    device, dimension(:), allocatable :: qinffield
   real*4,    device, dimension(:), allocatable :: qinfmap
   real*4,    device, dimension(:), allocatable :: cuminf
   integer*1, device, dimension(:), allocatable :: scs_rain
   real*4,    device, dimension(:), allocatable :: scs_Se
   real*4,    device, dimension(:), allocatable :: scs_P1
   real*4,    device, dimension(:), allocatable :: scs_F1
   real*4,    device, dimension(:), allocatable :: scs_S1
   real*4,    device, dimension(:), allocatable :: rain_T1
   real*4,    device, dimension(:), allocatable :: ksfield
   real*4,    device, dimension(:), allocatable :: GA_head
   real*4,    device, dimension(:), allocatable :: GA_sigma
   real*4,    device, dimension(:), allocatable :: GA_sigma_max
   real*4,    device, dimension(:), allocatable :: GA_F
   real*4,    device, dimension(:), allocatable :: GA_Lu
   real*4,    device, dimension(:), allocatable :: inf_kr
   real*4,    device, dimension(:), allocatable :: horton_kd
   real*4,    device, dimension(:), allocatable :: horton_fc
   real*4,    device, dimension(:), allocatable :: horton_f0
   !
   ! MPI / partition scalars
   !
   integer :: mpi_rank
   integer :: mpi_size
   integer :: local_rank
   integer :: npn_local
   integer :: npuv_local
   integer :: halo_cell_count
   integer :: halo_edge_count
   integer :: cell_index_first
   integer :: cell_index_last
   !
   ! ===== gpu-wavemaker-snapwave-coupling supplemental ====
   !
   ! Device shadows consumed by k_wavemaker_fluxes in
   ! source/src/sfincs_wavemaker_gpu.cuf. Subgrid mirrors (zb, zbuv,
   ! subgrid_z_*, subgrid_uv_zmin/zmax/havg/nrep/havg_zmax) are reused
   ! from the main catalog above; the entries below are the wavemaker-
   ! specific arrays plus the per-cell wave-height fields hm0 and
   ! hm0_ig (written by SnapWave coupling on host, read on device).
   !
   integer*4, device, dimension(:), allocatable :: wavemaker_index_uv
   integer*4, device, dimension(:), allocatable :: wavemaker_index_nmi
   integer*4, device, dimension(:), allocatable :: wavemaker_index_nmb
   integer*4, device, dimension(:), allocatable :: wavemaker_index_wmfp1
   integer*4, device, dimension(:), allocatable :: wavemaker_index_wmfp2
   real*4,    device, dimension(:), allocatable :: wavemaker_fac_wmfp
   integer*1, device, dimension(:), allocatable :: wavemaker_idir
   real*4,    device, dimension(:), allocatable :: wavemaker_angfac
   real*4,    device, dimension(:), allocatable :: wavemaker_uvtrend
   real*4,    device, dimension(:), allocatable :: hm0
   real*4,    device, dimension(:), allocatable :: hm0_ig
   !
   ! ===== gpu-meteo-spatial-interp supplemental ====
   !
   ! Device shadows consumed by the four spatial-interpolation kernels
   ! (update_spiderweb_data, update_amuv_data, update_amp_data,
   ! update_ampr_data) ported from sfincs_meteo_io.f90 into
   ! source/src/sfincs_meteo_gpu.cuf. Type and rank match the host
   ! counterparts in source/src/sfincs_data.f90:691-743 (and z_xz / z_yz
   ! at sfincs_data.f90:365-366; cdval / cdlgx / z0land / z0land_table
   ! near sfincs_data.f90:404-405, 750, 825).
   !
   ! Spiderweb time-major and temporal-snapshot scratches
   !
   real*4,    device, dimension(:),     allocatable :: spw_times
   real*4,    device, dimension(:),     allocatable :: spw_xe
   real*4,    device, dimension(:),     allocatable :: spw_ye
   real*4,    device, dimension(:,:,:), allocatable :: spw_wu
   real*4,    device, dimension(:,:,:), allocatable :: spw_wv
   real*4,    device, dimension(:,:,:), allocatable :: spw_pabs
   real*4,    device, dimension(:,:,:), allocatable :: spw_prcp
   real*4,    device, dimension(:,:),   allocatable :: spw_wu01
   real*4,    device, dimension(:,:),   allocatable :: spw_wv01
   real*4,    device, dimension(:,:),   allocatable :: spw_pabs01
   real*4,    device, dimension(:,:),   allocatable :: spw_prcp01
   !
   ! Regular-grid time-major and temporal-snapshot scratches
   !
   real*4,    device, dimension(:),     allocatable :: amuv_times
   real*4,    device, dimension(:,:,:), allocatable :: amuv_wu
   real*4,    device, dimension(:,:,:), allocatable :: amuv_wv
   real*4,    device, dimension(:,:),   allocatable :: amuv_wu01
   real*4,    device, dimension(:,:),   allocatable :: amuv_wv01
   real*4,    device, dimension(:),     allocatable :: amp_times
   real*4,    device, dimension(:,:,:), allocatable :: amp_patm
   real*4,    device, dimension(:,:),   allocatable :: amp_patm01
   real*4,    device, dimension(:),     allocatable :: ampr_times
   real*4,    device, dimension(:,:,:), allocatable :: ampr_pr
   real*4,    device, dimension(:,:),   allocatable :: ampr_pr01
   !
   ! Per-cell coordinate arrays
   !
   real*4,    device, dimension(:),     allocatable :: z_xz
   real*4,    device, dimension(:),     allocatable :: z_yz
   !
   ! Wind-stress lookup tables. cdval and cdlgx are non-allocatable
   ! fixed-size on the host (sfincs_data.f90:750, 825); declaring the
   ! device shadows fixed-size with the matching shape avoids an extra
   ! allocate/deallocate pair (design (a) per the issue notes). z0land
   ! and z0land_table are allocatable on the host; their device shadows
   ! follow the standard mold/copy/deallocate pattern.
   !
   real*4,    device, dimension(1000)              :: cdval
   real*4,    device, dimension(50, 20)            :: cdlgx
   real*4,    device, dimension(:,:),   allocatable :: z0land
   real*4,    device, dimension(:),     allocatable :: z0land_table
   !
   ! ===== gpu-multi-gpu supplemental =====
   !
   ! Per-neighbor-rank halo descriptors populated by build_halo_descriptors
   ! in sfincs_partition.cuf. SOR-708 consumes these in the MPI Isend/Irecv
   ! halo_exchange_cells and halo_exchange_q_uv bodies; SOR-709 wires the
   ! call sites in sfincs_lib.F90. The leading dimension of the 2D index
   ! arrays is the maximum count across neighbors; the trailing dimension
   ! is halo_n_neighbors. Per-neighbor counts in halo_*_count are the
   ! actual valid lengths within that leading dimension.
   !
   ! Cell (z) halos.
   !
   integer, device, allocatable :: halo_recv_local_idx(:,:)
   integer, device, allocatable :: halo_recv_remote_idx(:,:)
   integer, device, allocatable :: halo_send_local_idx(:,:)
   integer, allocatable :: halo_recv_count(:)
   integer, allocatable :: halo_send_count(:)
   integer, allocatable :: halo_neighbor_ranks(:)
   integer :: halo_n_neighbors
   !
   ! Edge (uv) halos. The neighbor-rank list is shared with the z halos
   ! (halo_neighbor_ranks above); only the index sets and counts differ.
   !
   integer, device, allocatable :: halo_uv_recv_local_idx(:,:)
   integer, device, allocatable :: halo_uv_recv_remote_idx(:,:)
   integer, device, allocatable :: halo_uv_send_local_idx(:,:)
   integer, allocatable :: halo_uv_recv_count(:)
   integer, allocatable :: halo_uv_send_count(:)
   integer :: halo_uv_n_neighbors
   !
   ! Local-to-global translation maps. Persisted across partition_and_localize
   ! because the per-step bridge-IN gather kernels in source/src/sfincs_*_gpu.cuf
   ! (and the post-shrink output-pack helpers in this module) read
   ! local_to_global / local_to_global_uv to translate LOCAL device-shadow
   ! indices into GLOBAL host-array indices. global_to_local /
   ! global_to_local_uv are persisted alongside so that
   ! allocate_structure_device_shadows /
   ! allocate_discharges_device_shadows / allocate_wavemaker_device_shadows --
   ! which run after read_structures / read_discharges / initialize_wavemakers
   ! has populated host counterparts -- can renumber the connectivity entries
   ! they ship to device through the maps. halo_recv_remote_idx still carries
   ! global indices on the receive side so the recv-translate step in
   ! halo_exchange_cells / halo_exchange_q_uv keeps that source-of-truth.
   !
   integer, allocatable :: local_to_global(:)
   integer, allocatable :: local_to_global_uv(:)
   integer, allocatable :: global_to_local(:)
   integer, allocatable :: global_to_local_uv(:)
   !
   ! Device-resident copy of local_to_global. Read by the per-step bridge-IN
   ! gather and bridge-OUT scatter kernels in source/src/sfincs_*_gpu.cuf to
   ! translate LOCAL device-shadow positions to GLOBAL host-array indices.
   !
   integer, device, allocatable :: local_to_global_d(:)
   integer, device, allocatable :: local_to_global_uv_d(:)
   !
   ! Send/recv staging buffers for halo exchange. CUDA-aware MPI is
   ! mandatory in this build (verified in partition_and_localize Phase 1b),
   ! so these are device-resident; the gather kernel writes them, MPI
   ! Isend/Irecv consume them as device pointers, and the scatter kernel
   ! reads from them.
   !
   ! Cell payload: one combined real*8 buffer pair
   ! (halo_send_buf_cells / halo_recv_buf_cells) carries the
   ! post-continuity cell halo arrays — zs (real*8, always), zsderv
   ! (real*4, when wiggle suppression is built in) and z_volume
   ! (real*8, when the case is subgrid) — coalesced by SOR-1019 into
   ! a single per-neighbor exchange. Each neighbor's column packs the
   ! participating arrays in contiguous bands: zs in rows [1..n], then
   ! zsderv in rows [n+1..2n] (if allocated), then z_volume in rows
   ! [2n+1..3n] (if allocated). zsderv is upcast to real*8 in the
   ! gather kernel and downcast back to real*4 in the scatter kernel
   ! so the buffer is type-uniform and the MPI message carries one
   ! MPI_DOUBLE_PRECISION payload per neighbor; the r4 → r8 → r4
   ! round-trip is bit-exact (r4 ⊂ r8 in IEEE 754) so the scattered
   ! halo values, and therefore sfincs_map.nc, are unchanged from the
   ! pre-fix three-separate-exchanges path. The buffer's leading
   ! dimension is n_cell_bands * max(halo_*_count) where
   ! n_cell_bands ∈ {1, 2, 3} depending on which arrays are allocated
   ! at partition_and_localize time. The real*8 wire format also
   ! avoids any per-step quantization on subgrid wet/dry transitions
   ! that an r4 wire format would introduce on the z_volume band.
   !
   ! The q / uv edge exchange uses one combined real*4 buffer pair
   ! (halo_send_buf_quv / halo_recv_buf_quv) below. q and uv are real*4
   ! on both sides so they have no precision step either; SOR-1018
   ! coalesced what used to be two sequential single-array exchanges
   ! (separate halo_send_buf_q / halo_send_buf_uv pairs) into one
   ! exchange whose per-neighbor column packs q in rows [1..count] and
   ! uv in rows [count+1..2*count], so the leading dimension here is
   ! 2*max(halo_uv_*_count) instead of max(halo_uv_*_count).
   !
   real*8, device, allocatable :: halo_send_buf_cells(:,:)
   real*8, device, allocatable :: halo_recv_buf_cells(:,:)
   integer :: halo_cells_n_bands
   integer :: halo_cells_band_zsderv
   integer :: halo_cells_band_z_volume
   real, device, allocatable :: halo_send_buf_quv(:,:)
   real, device, allocatable :: halo_recv_buf_quv(:,:)
   !
   ! SnapWave gather/scatter metadata (SOR-711). Populated once at startup
   ! by partition_and_localize and consumed every dtwave interval inside
   ! sfincs_snapwave_gpu.cuf::update_wave_field. The SnapWave solver itself
   ! stays CPU on rank 0 (out of scope for the gpu-multi-gpu sub-epic), so
   ! each rank packs its rank-local slice of zs / windu / windv into a
   ! contiguous send buffer (in local_to_global(1:npn_local) order) and
   ! MPI_Gatherv-es to rank 0; rank 0 unpacks into its full-size global host
   ! arrays via gather_perrank_local_to_global, runs the solver, then packs
   ! its full-size fwuv into a per-rank-ordered send buffer for an
   ! MPI_Scatterv that returns each rank's owned uv slice.
   !
   ! Counts and displacements live on every rank (both sides of the
   ! collective need them); the perrank_local_to_global flat permutation
   ! is only meaningful on rank 0 (other ranks allocate a placeholder).
   ! Position k in the flat perrank array gives the global cell / uv id
   ! that the k-th element of the gathered flat data buffer corresponds to,
   ! so unpack and pre-scatter pack are single linear loops over k.
   !
   integer, allocatable :: gather_recvcounts(:)
   integer, allocatable :: gather_displacements(:)
   integer, allocatable :: gather_perrank_local_to_global(:)
   integer, allocatable :: gather_uv_recvcounts(:)
   integer, allocatable :: gather_uv_displacements(:)
   integer, allocatable :: gather_perrank_local_to_global_uv(:)
   !
end module sfincs_data_device
