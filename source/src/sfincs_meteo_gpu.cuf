   ! Snapshot kernel: amp_patm01(irow, icol) = blend of amp_patm slices
   ! at itw0 / itw1 by twfac. Mirrors CPU sibling lines 1009-1015.
   !
   attributes(global) subroutine k_amp_snapshot(itw0_in, itw1_in, twfac_in, &
                                                amp_nrows_in, amp_ncols_in)
      !
      implicit none
      !
      integer, value :: itw0_in
      integer, value :: itw1_in
      real*4,  value :: twfac_in
      integer, value :: amp_nrows_in
      integer, value :: amp_ncols_in
      !
      integer :: tid, irow, icol
      !
      tid = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (tid > amp_nrows_in * amp_ncols_in) return
      !
      irow = ((tid - 1) / amp_ncols_in) + 1
      icol = mod(tid - 1, amp_ncols_in) + 1
      !
      amp_patm01(irow, icol) = amp_patm(itw0_in, irow, icol) * (1.0 - twfac_in) &
                             + amp_patm(itw1_in, irow, icol) *        twfac_in
      !
   end subroutine k_amp_snapshot
   !
   ! Spatial kernel: bilinear interpolation of amp_patm01 onto each
   ! SFINCS cell. Mirrors CPU sibling lines 1019-1086.
   !
   attributes(global) subroutine k_amp_spatial(itw_in, npn_in, &
                                               amp_nrows_in, amp_ncols_in, &
                                               amp_dx_in, amp_dy_in, &
                                               yul_in, xll_in, gapres_in)
      !
      implicit none
      !
      integer, value :: itw_in
      integer, value :: npn_in
      integer, value :: amp_nrows_in
      integer, value :: amp_ncols_in
      real*4,  value :: amp_dx_in
      real*4,  value :: amp_dy_in
      real*4,  value :: yul_in
      real*4,  value :: xll_in
      real*4,  value :: gapres_in
      !
      integer :: nm
      integer :: ix, iy, ip
      integer :: ind1(4), ind2(4)
      real*4  :: x, y, di1, dj1, pr
      real*4  :: f(4)
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      x = z_xz(nm)
      y = z_yz(nm)
      !
      ! Row indices
      !
      iy = int((yul_in - y) / amp_dy_in) + 1
      ind1(1) = iy
      ind1(2) = iy
      ind1(3) = iy + 1
      ind1(4) = iy + 1
      dj1 = (yul_in - (iy - 1) * amp_dy_in - y) / amp_dy_in
      !
      ! Column indices
      !
      ix = int((x - xll_in) / amp_dx_in) + 1
      ind2(1) = ix
      ind2(2) = ix + 1
      ind2(3) = ix + 1
      ind2(4) = ix
      di1 = (x - (xll_in + (ix - 1) * amp_dx_in)) / amp_dx_in
      !
      if (iy <= 1 .or. iy >= amp_nrows_in .or. ix <= 0 .or. ix >= amp_ncols_in) then
         !
         ! Point outside rectangular amp grid
         !
         if (itw_in == 1) then
            patm0(nm) = gapres_in
         else
            patm1(nm) = gapres_in
         endif
         !
         return
         !
      endif
      !
      ! Bilinear weights
      !
      f(1) = (1.0 - di1) * (1.0 - dj1)
      f(2) = (      di1) * (1.0 - dj1)
      f(3) = (      di1) * (      dj1)
      f(4) = (1.0 - di1) * (      dj1)
      !
      pr = 0.0
      do ip = 1, 4
         pr = pr + f(ip) * amp_patm01(ind1(ip), ind2(ip))
      enddo
      !
      if (itw_in == 1) then
         patm0(nm) = pr
      else
         patm1(nm) = pr
      endif
      !
   end subroutine k_amp_spatial
