module sfincs_meteo
   !
   ! GPU sibling of source/src/sfincs_meteo.f90.
   !
   ! Shadows the CPU module's public surface using native CUDA Fortran kernels
   ! that operate on device-resident state declared by sfincs_data_device.
   !
   ! IO routines (read_meteo_data, update_spiderweb_data, update_amuv_data,
   ! update_amp_data, update_ampr_data) are re-exported from sfincs_meteo_io.
   ! Those helpers continue to write host-side staging arrays (tauwu0/tauwu1,
   ! patm0/patm1, prcp0/prcp1, windu0/windu1, ...). The per-step kernels
   ! refresh the device shadows from those host arrays at launch (bridge-IN)
   ! and publish the writes back to host at completion (bridge-OUT). The
   ! bridge is wasted bandwidth once every per-step module is GPU-resident
   ! but is required for correctness during the staging period.
   !
   use cudafor
   use sfincs_data_device
   use sfincs_meteo_io, only: read_meteo_data, &
                              update_spiderweb_data, &
                              update_amuv_data
   !
   implicit none
   !
   private
   public :: read_meteo_data, &
             update_spiderweb_data, &
             update_amuv_data, &
             update_amp_data, &
             update_ampr_data, &
             update_meteo_forcing, &
             update_wind_forcing_from_timeseries, &
             update_precipitation_from_timeseries, &
             update_meteo_fields
   !
   integer, parameter :: TPB = 128   ! threads per block, intentionally simple
   !
contains
   !
   ! -----------------------------------------------------------------
   ! Per-step time-interpolation of wind/pressure/precipitation. Mirrors
   ! CPU sibling lines 11-192.
   ! -----------------------------------------------------------------
   subroutine update_meteo_forcing(t, dt, tloop)
      !
      use sfincs_data, only: &
         meteo3d_h => meteo3d, &
         meteo_t0_h => meteo_t0, meteo_t1_h => meteo_t1, &
         wind_h => wind, patmos_h => patmos, precip_h => precip, &
         subgrid_h => subgrid, &
         store_wind_h => store_wind, &
         store_wind_max_h => store_wind_max, &
         store_cumulative_precipitation_h => store_cumulative_precipitation, &
         spinup_meteo_h => spinup_meteo, &
         tspinup_h => tspinup, t0_h => t0, gapres_h => gapres, &
         pavbnd_h => pavbnd, ngbnd_h => ngbnd, &
         wndfile_h => wndfile, prcpfile_h => prcpfile, &
         tauwu_h => tauwu, tauwv_h => tauwv, &
         tauwu0_h => tauwu0, tauwv0_h => tauwv0, &
         tauwu1_h => tauwu1, tauwv1_h => tauwv1, &
         windu_h => windu, windv_h => windv, &
         windu0_h => windu0, windv0_h => windv0, &
         windu1_h => windu1, windv1_h => windv1, &
         windmax_h => windmax, &
         patm_h => patm, patm0_h => patm0, patm1_h => patm1, &
         patmb_h => patmb, &
         prcp_h => prcp, prcp0_h => prcp0, prcp1_h => prcp1, &
         cumprcp_h => cumprcp, netprcp_h => netprcp, &
         z_volume_h => z_volume, zs_h => zs, zb_h => zb, &
         nmindbnd_h => nmindbnd
      !
      implicit none
      !
      integer  :: count0
      integer  :: count1
      integer  :: count_rate
      integer  :: count_max
      real     :: tloop
      !
      real*8    :: t
      real*4    :: dt
      real*4    :: twfact, onemintwfact
      real*4    :: smfac, oneminsmfac
      logical   :: do_spinup
      integer   :: blocks
      integer   :: bnd_blocks
      integer   :: istat
      !
      call system_clock(count0, count_rate, count_max)
      !
      if (meteo3d_h) then
         !
         twfact       = (t - meteo_t0_h) / (meteo_t1_h - meteo_t0_h)
         onemintwfact = 1.0 - twfact
         !
         do_spinup = (t < (tspinup_h - 1.0e-3) .and. spinup_meteo_h)
         if (do_spinup) then
            smfac       = (t - t0_h) / (tspinup_h - t0_h)
            oneminsmfac = 1.0 - smfac
         else
            smfac       = 1.0
            oneminsmfac = 0.0
         endif
         !
         ! ------ Copy-IN: host -> device for kernel READ set ----------------
         !
         if (wind_h) then
            tauwu0 = tauwu0_h
            tauwv0 = tauwv0_h
            tauwu1 = tauwu1_h
            tauwv1 = tauwv1_h
            tauwu  = tauwu_h
            tauwv  = tauwv_h
            if (store_wind_h) then
               windu0 = windu0_h
               windv0 = windv0_h
               windu1 = windu1_h
               windv1 = windv1_h
               windu  = windu_h
               windv  = windv_h
               if (store_wind_max_h) windmax = windmax_h
            endif
         endif
         !
         if (patmos_h) then
            patm0 = patm0_h
            patm1 = patm1_h
            patm  = patm_h
         endif
         !
         if (precip_h) then
            prcp0   = prcp0_h
            prcp1   = prcp1_h
            prcp    = prcp_h
            netprcp = netprcp_h
            if (store_cumulative_precipitation_h) cumprcp = cumprcp_h
            if (subgrid_h) then
               z_volume = z_volume_h
            else
               zs = zs_h
               zb = zb_h
            endif
         endif
         !
         ! ------ Per-cell time interpolation kernel -------------------------
         !
         blocks = (npn_local + TPB - 1) / TPB
         !
         call k_meteo_time_interp<<<blocks, TPB>>>( &
            dt, npn_local, &
            twfact, onemintwfact, smfac, oneminsmfac, &
            do_spinup, gapres_h, &
            wind_h, patmos_h, precip_h, subgrid_h, &
            store_wind_h, store_wind_max_h, &
            store_cumulative_precipitation_h)
         !
         istat = cudaDeviceSynchronize()
         !
         ! ------ Boundary atmospheric pressure update -----------------------
         !
         if (patmos_h .and. pavbnd_h > 0.0) then
            !
            nmindbnd = nmindbnd_h
            !
            bnd_blocks = (ngbnd_h + TPB - 1) / TPB
            call k_meteo_patmb<<<bnd_blocks, TPB>>>(ngbnd_h)
            istat = cudaDeviceSynchronize()
            !
         endif
         !
         ! ------ Copy-OUT: device -> host for WRITE set ---------------------
         !
         if (wind_h) then
            tauwu_h = tauwu
            tauwv_h = tauwv
            if (store_wind_h) then
               windu_h = windu
               windv_h = windv
               if (store_wind_max_h) windmax_h = windmax
            endif
         endif
         !
         if (patmos_h) then
            patm_h = patm
            if (pavbnd_h > 0.0) patmb_h = patmb
         endif
         !
         if (precip_h) then
            prcp_h    = prcp
            netprcp_h = netprcp
            if (store_cumulative_precipitation_h) cumprcp_h = cumprcp
         endif
         !
      endif
      !
      ! Wind from time series
      !
      if (wndfile_h(1:4) /= 'none') then
         call update_wind_forcing_from_timeseries(t)
      endif
      !
      ! Rainfall from time series
      !
      if (prcpfile_h(1:4) /= 'none') then
         call update_precipitation_from_timeseries(t, dt)
      endif
      !
      call system_clock(count1, count_rate, count_max)
      tloop = tloop + 1.0 * (count1 - count0) / count_rate
      !
   end subroutine update_meteo_forcing
   !
   ! -----------------------------------------------------------------
   ! Spatially-uniform wind from time series. Mirrors CPU sibling
   ! lines 195-255.
   ! -----------------------------------------------------------------
   subroutine update_wind_forcing_from_timeseries(t)
      !
      use sfincs_data, only: pi, rhoa, rhow, &
                             ntwnd, itwndlast, twnd, wndmag, wnddir, cdval, &
                             store_wind_h => store_wind, &
                             tauwu_h => tauwu, tauwv_h => tauwv, &
                             windu_h => windu, windv_h => windv
      !
      implicit none
      !
      real*8 :: t
      !
      integer :: itw
      integer :: blocks
      integer :: istat
      real*4  :: twfac, vmag, vdir, dr0, dr1, cd
      real*8  :: twu, twv
      real*4  :: wu_uni, wv_uni
      !
      do itw = itwndlast, ntwnd
         !
         if (twnd(itw) > t) then
            !
            twfac = (t - twnd(itw - 1)) / (twnd(itw) - twnd(itw - 1))
            !
            vmag = wndmag(itw - 1) * (1.0 - twfac) + wndmag(itw) * twfac
            dr0  = modulo(wnddir(itw - 1), 2 * pi)
            dr1  = modulo(wnddir(itw    ), 2 * pi)
            if (dr1 > dr0 + pi) then
               dr0 = dr0 + 2 * pi
            elseif (dr0 > dr1 + pi) then
               dr1 = dr1 + 2 * pi
            endif
            vdir = dr0 * (1.0 - twfac) + dr1 * twfac
            !
            cd = cdval(int(vmag * 10) + 1)
            !
            twu = vmag**2 * cos(vdir) * rhoa * cd / rhow
            twv = vmag**2 * sin(vdir) * rhoa * cd / rhow
            !
            wu_uni = vmag * cos(vdir)
            wv_uni = vmag * sin(vdir)
            !
            blocks = (npn_local + TPB - 1) / TPB
            !
            call k_wind_uniform<<<blocks, TPB>>>(npn_local, &
               real(twu, kind=4), real(twv, kind=4), &
               wu_uni, wv_uni, store_wind_h)
            !
            istat = cudaDeviceSynchronize()
            !
            ! Publish device -> host for downstream CPU consumers
            !
            tauwu_h = tauwu
            tauwv_h = tauwv
            if (store_wind_h) then
               windu_h = windu
               windv_h = windv
            endif
            !
            itwndlast = itw - 1
            !
            exit
            !
         endif
         !
      enddo
      !
   end subroutine update_wind_forcing_from_timeseries
   !
   ! -----------------------------------------------------------------
   ! Spatially-uniform precipitation from time series. Mirrors CPU
   ! sibling lines 257-302.
   ! -----------------------------------------------------------------
   subroutine update_precipitation_from_timeseries(t, dt)
      !
      use sfincs_data, only: ntprcp, itprcplast, tprcpt, tprcpv, &
                             store_cumulative_precipitation_h => store_cumulative_precipitation, &
                             prcp_h => prcp, netprcp_h => netprcp, &
                             cumprcp_h => cumprcp
      !
      implicit none
      !
      real*8 :: t
      real*4 :: dt
      !
      integer :: itp
      integer :: blocks
      integer :: istat
      real*4  :: twfac, ptmp
      !
      do itp = itprcplast, ntprcp
         if (tprcpt(itp) > t) exit
      enddo
      !
      itp = max(min(itp, ntprcp), 1)
      !
      twfac = (t - tprcpt(itp - 1)) / (tprcpt(itp) - tprcpt(itp - 1))
      !
      ptmp = (tprcpv(itp - 1) * (1.0 - twfac) + tprcpv(itp) * twfac) / (1000 * 3600)
      !
      ! Copy-IN cumprcp if used (read-modify-write pattern)
      !
      if (store_cumulative_precipitation_h) cumprcp = cumprcp_h
      !
      blocks = (npn_local + TPB - 1) / TPB
      !
      call k_precip_uniform<<<blocks, TPB>>>(npn_local, dt, ptmp, &
         store_cumulative_precipitation_h)
      !
      istat = cudaDeviceSynchronize()
      !
      ! Copy-OUT
      !
      prcp_h    = prcp
      netprcp_h = netprcp
      if (store_cumulative_precipitation_h) cumprcp_h = cumprcp
      !
      itprcplast = itp - 1
      !
   end subroutine update_precipitation_from_timeseries
   !
   ! -----------------------------------------------------------------
   ! Per-step host dispatcher to IO trampolines that read meteo data
   ! and (in the case of update_spiderweb_data) interpolate spatially
   ! onto the SFINCS grid into host-side staging arrays.
   !
   ! Mirrors the CPU sibling lines 305-352. The per-cell interpolation
   ! work for spiderweb is performed inside update_spiderweb_data
   ! (writing to host arrays tauwu0/tauwu1, patm0/patm1, prcp0/prcp1,
   ! windu0/windu1); update_meteo_forcing then refreshes the device
   ! shadows from those host arrays via bridge-IN before time-interp.
   ! -----------------------------------------------------------------
   subroutine update_meteo_fields(t, tloop)
      !
      use sfincs_data, only: amufile, netamuamvfile, &
                             ampfile, netampfile, &
                             amprfile, netamprfile, &
                             spwfile, netspwfile, patmos
      !
      implicit none
      !
      integer  :: count0
      integer  :: count1
      integer  :: count_rate
      integer  :: count_max
      real     :: tloop
      !
      real*8   :: t
      logical  :: has_amu
      logical  :: has_amp
      logical  :: has_ampr
      logical  :: has_spw
      !
      call system_clock(count0, count_rate, count_max)
      !
      has_amu  = (amufile(1:4)  /= 'none' .or. netamuamvfile(1:4) /= 'none')
      has_amp  = (ampfile(1:4)  /= 'none' .or. netampfile(1:4)    /= 'none') .and. patmos
      has_ampr = (amprfile(1:4) /= 'none' .or. netamprfile(1:4)   /= 'none')
      has_spw  = (spwfile(1:4)  /= 'none' .or. netspwfile(1:4)    /= 'none')
      !
      if (has_amu) then
         call update_amuv_data()
         call launch_amuv_interp_gpu()
      endif
      !
      if (has_amp) then
         call update_amp_data()
      endif
      !
      if (has_ampr) then
         call update_ampr_data()
      endif
      !
      if (has_spw) then
         call update_spiderweb_data()
         call launch_spiderweb_interp_gpu(has_amu, has_amp, has_ampr)
      endif
      !
      if (has_amu .or. has_amp .or. has_ampr .or. has_spw) then
         call bridge_out_meteo_fields(has_amu, has_amp, has_ampr, has_spw)
      endif
      !
      call system_clock(count1, count_rate, count_max)
      tloop = tloop + 1.0 * (count1 - count0) / count_rate
      !
   end subroutine update_meteo_fields
   !
   ! -----------------------------------------------------------------
   ! Bridge OUT of the host arrays the device kernels wrote, so consumer
   ! modules (compute_fluxes, update_meteo_forcing on next step, etc.)
   ! see the GPU's results.
   ! -----------------------------------------------------------------
   subroutine bridge_out_meteo_fields(has_amu, has_amp, has_ampr, has_spw)
      !
      use sfincs_data, only: store_wind_h => store_wind, &
                             patmos_h => patmos, &
                             precip_h => precip, spw_precip_h => spw_precip, &
                             tauwu0_h => tauwu0, tauwv0_h => tauwv0, &
                             tauwu1_h => tauwu1, tauwv1_h => tauwv1, &
                             windu0_h => windu0, windv0_h => windv0, &
                             windu1_h => windu1, windv1_h => windv1, &
                             patm0_h => patm0, patm1_h => patm1, &
                             prcp0_h => prcp0, prcp1_h => prcp1
      !
      implicit none
      !
      logical, intent(in) :: has_amu
      logical, intent(in) :: has_amp
      logical, intent(in) :: has_ampr
      logical, intent(in) :: has_spw
      !
      if (has_amu .or. has_spw) then
         tauwu0_h = tauwu0
         tauwv0_h = tauwv0
         tauwu1_h = tauwu1
         tauwv1_h = tauwv1
         if (store_wind_h) then
            windu0_h = windu0
            windv0_h = windv0
            windu1_h = windu1
            windv1_h = windv1
         endif
      endif
      !
      if (patmos_h .and. (has_amp .or. has_spw)) then
         patm0_h = patm0
         patm1_h = patm1
      endif
      !
      if (precip_h .and. (has_ampr .or. (has_spw .and. spw_precip_h))) then
         prcp0_h = prcp0
         prcp1_h = prcp1
      endif
      !
   end subroutine bridge_out_meteo_fields
   !
   ! -----------------------------------------------------------------
   ! Host launcher for k_amuv_interp. Host-side time-interp into
   ! amuv_wu01 / amuv_wv01 (which the CPU IO already overwrote, but we
   ! redo it per itw to capture both itw=1 and itw=2 states), copy to
   ! private device scratch, launch kernel, two passes.
   ! -----------------------------------------------------------------
   subroutine launch_amuv_interp_gpu()
      !
      use sfincs_data, only: amuv_nrows, amuv_ncols, amuv_dx, amuv_dy, &
                             amuv_x_llcorner, amuv_y_llcorner, &
                             amuv_nt, &
                             amuv_times_h => amuv_times, &
                             amuv_wu_h => amuv_wu, &
                             amuv_wv_h => amuv_wv, &
                             amuv_wu01_h => amuv_wu01, &
                             amuv_wv01_h => amuv_wv01, &
                             meteo_t0_h => meteo_t0, meteo_t1_h => meteo_t1, &
                             cosrot_h => cosrot, sinrot_h => sinrot, &
                             rhoa_h => rhoa, rhow_h => rhow, &
                             waveage_h => waveage, &
                             store_wind_h => store_wind, radstr_h => radstr
      !
      implicit none
      !
      integer :: itw, irow, icol, itspw, itw0, itw1
      integer :: blocks, istat
      real*4  :: meteo_t, twfac
      !
      blocks = (npn_local + TPB - 1) / TPB
      !
      do itw = 1, 2
         !
         if (itw == 1) then
            meteo_t = meteo_t0_h
         else
            meteo_t = meteo_t1_h
         endif
         !
         meteo_t = max(meteo_t, amuv_times_h(1))
         meteo_t = min(meteo_t, amuv_times_h(amuv_nt))
         !
         itw0 = 1
         do itspw = 1, amuv_nt
            if (amuv_times_h(itspw) <= meteo_t) itw0 = itspw
         enddo
         itw1 = min(itw0 + 1, amuv_nt)
         meteo_t = min(meteo_t, amuv_times_h(itw1))
         twfac = (meteo_t - amuv_times_h(itw0)) / max(amuv_times_h(itw1) - amuv_times_h(itw0), 1.0e-6)
         !
         ! Recompute time-interp on host into the *01 scratch. CPU IO
         ! already filled this once for itw=2; we redo per itw.
         !
         do irow = 1, amuv_nrows
            do icol = 1, amuv_ncols
               amuv_wu01_h(irow, icol) = amuv_wu_h(itw0, irow, icol) * (1.0 - twfac) + amuv_wu_h(itw1, irow, icol) * twfac
               amuv_wv01_h(irow, icol) = amuv_wv_h(itw0, irow, icol) * (1.0 - twfac) + amuv_wv_h(itw1, irow, icol) * twfac
            enddo
         enddo
         !
         ! Bridge IN: host -> device-resident shadows (in sfincs_data_device,
         ! provisioned by SOR-735).
         !
         amuv_wu01 = amuv_wu01_h
         amuv_wv01 = amuv_wv01_h
         !
         call k_amuv_interp<<<blocks, TPB>>>( &
            itw, npn_local, &
            amuv_nrows, amuv_ncols, amuv_dx, amuv_dy, &
            amuv_x_llcorner, amuv_y_llcorner, &
            cosrot_h, sinrot_h, rhoa_h, rhow_h, &
            waveage_h, store_wind_h, radstr_h)
         !
         istat = cudaDeviceSynchronize()
         !
      enddo
      !
   end subroutine launch_amuv_interp_gpu
   !
   ! -----------------------------------------------------------------
   ! Host launcher for k_spiderweb_interp.
   ! -----------------------------------------------------------------
   subroutine launch_spiderweb_interp_gpu(has_amu, has_amp, has_ampr)
      !
      use sfincs_data, only: spw_nrows, spw_ncols, spw_radius, &
                             dradspw, dphispw, spw_merge_frac, &
                             spw_nt, &
                             spw_times_h => spw_times, &
                             spw_xe_h => spw_xe, &
                             spw_ye_h => spw_ye, &
                             spw_wu_h => spw_wu, &
                             spw_wv_h => spw_wv, &
                             spw_pabs_h => spw_pabs, &
                             spw_prcp_h => spw_prcp, &
                             spw_wu01_h => spw_wu01, &
                             spw_wv01_h => spw_wv01, &
                             spw_pabs01_h => spw_pabs01, &
                             spw_prcp01_h => spw_prcp01, &
                             spw_precip_h => spw_precip, &
                             patmos_h => patmos, precip_h => precip, &
                             store_wind_h => store_wind, &
                             wind_reduction_h => wind_reduction, &
                             waveage_h => waveage, &
                             crsgeo_h => crsgeo, &
                             pi_h => pi, gapres_h => gapres, &
                             rhoa_h => rhoa, rhow_h => rhow, &
                             cosrot_h => cosrot, sinrot_h => sinrot, &
                             meteo_t0_h => meteo_t0, meteo_t1_h => meteo_t1
      !
      implicit none
      !
      logical, intent(in) :: has_amu
      logical, intent(in) :: has_amp
      logical, intent(in) :: has_ampr
      !
      integer :: itw, irow, icol, itspw, itw0, itw1
      integer :: blocks, istat
      real*4  :: meteo_t, twfac, tspinup_fac, spw_xe01, spw_ye01
      !
      blocks = (npn_local + TPB - 1) / TPB
      !
      do itw = 1, 2
         !
         if (itw == 1) then
            meteo_t = meteo_t0_h
         else
            meteo_t = meteo_t1_h
         endif
         !
         ! Mirror CPU IO time-bracket logic (lines 466-513).
         !
         if (meteo_t < spw_times_h(1)) then
            itw0 = 1
            itw1 = 1
            twfac = 1.0
            tspinup_fac = max(1.0 - (spw_times_h(1) - meteo_t) / 21600.0, 0.0)
         elseif (meteo_t > spw_times_h(spw_nt)) then
            itw0 = spw_nt
            itw1 = spw_nt
            twfac = 1.0
            tspinup_fac = max(1.0 - (meteo_t - spw_times_h(spw_nt)) / 21600.0, 0.0)
         else
            itw0 = 1
            do itspw = 1, spw_nt
               if (spw_times_h(itspw) <= meteo_t) itw0 = itspw
            enddo
            itw1 = min(itw0 + 1, spw_nt)
            twfac = (meteo_t - spw_times_h(itw0)) / max(spw_times_h(itw1) - spw_times_h(itw0), 1.0e-6)
            tspinup_fac = 1.0
         endif
         !
         spw_xe01 = spw_xe_h(itw0) * (1.0 - twfac) + spw_xe_h(itw1) * twfac
         spw_ye01 = spw_ye_h(itw0) * (1.0 - twfac) + spw_ye_h(itw1) * twfac
         !
         do irow = 1, spw_nrows
            do icol = 1, spw_ncols
               spw_wu01_h(irow, icol) = spw_wu_h(itw0, irow, icol) * (1.0 - twfac) + spw_wu_h(itw1, irow, icol) * twfac
               spw_wv01_h(irow, icol) = spw_wv_h(itw0, irow, icol) * (1.0 - twfac) + spw_wv_h(itw1, irow, icol) * twfac
               if (patmos_h) then
                  spw_pabs01_h(irow, icol) = spw_pabs_h(itw0, irow, icol) * (1.0 - twfac) + spw_pabs_h(itw1, irow, icol) * twfac
               endif
               if (spw_precip_h) then
                  spw_prcp01_h(irow, icol) = spw_prcp_h(itw0, irow, icol) * (1.0 - twfac) + spw_prcp_h(itw1, irow, icol) * twfac
               endif
            enddo
         enddo
         !
         ! Bridge IN: host -> device-resident shadows.
         !
         spw_wu01 = spw_wu01_h
         spw_wv01 = spw_wv01_h
         if (patmos_h) spw_pabs01 = spw_pabs01_h
         if (spw_precip_h) spw_prcp01 = spw_prcp01_h
         !
         call k_spiderweb_interp<<<blocks, TPB>>>( &
            itw, npn_local, &
            spw_nrows, spw_ncols, spw_radius, dradspw, dphispw, &
            spw_xe01, spw_ye01, tspinup_fac, spw_merge_frac, &
            crsgeo_h, pi_h, gapres_h, rhoa_h, rhow_h, cosrot_h, sinrot_h, &
            has_amu, has_amp, has_ampr, &
            patmos_h, spw_precip_h, precip_h, store_wind_h, &
            wind_reduction_h, waveage_h)
         !
         istat = cudaDeviceSynchronize()
         !
      enddo
      !
   end subroutine launch_spiderweb_interp_gpu
   !
   !
   ! ===================================================================
   !                              KERNELS
   ! ===================================================================
   !
   ! Per-cell time-interpolation kernel. Mirrors the inner loops at CPU
   ! sibling lines 43-101 (twfact branch) and 115-149 (spinup branch),
   ! plus the negative-prcp guard at lines 75-87 and 132-144.
   !
   attributes(global) subroutine k_meteo_time_interp(dt, npn_in, &
                                                     twfact, onemintwfact, &
                                                     smfac, oneminsmfac, &
                                                     do_spinup_in, gapres_in, &
                                                     wind_in, patmos_in, &
                                                     precip_in, subgrid_in, &
                                                     store_wind_in, &
                                                     store_wind_max_in, &
                                                     store_cumprcp_in)
      !
      implicit none
      !
      real*4,  value :: dt
      integer, value :: npn_in
      real*4,  value :: twfact
      real*4,  value :: onemintwfact
      real*4,  value :: smfac
      real*4,  value :: oneminsmfac
      logical, value :: do_spinup_in
      real*4,  value :: gapres_in
      logical, value :: wind_in
      logical, value :: patmos_in
      logical, value :: precip_in
      logical, value :: subgrid_in
      logical, value :: store_wind_in
      logical, value :: store_wind_max_in
      logical, value :: store_cumprcp_in
      !
      integer :: nm
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      if (wind_in) then
         tauwu(nm) = tauwu0(nm) * onemintwfact + tauwu1(nm) * twfact
         tauwv(nm) = tauwv0(nm) * onemintwfact + tauwv1(nm) * twfact
         if (store_wind_in) then
            windu(nm) = windu0(nm) * onemintwfact + windu1(nm) * twfact
            windv(nm) = windv0(nm) * onemintwfact + windv1(nm) * twfact
            if (store_wind_max_in) then
               windmax(nm) = max(windmax(nm), sqrt(windu(nm)**2 + windv(nm)**2))
            endif
         endif
      endif
      !
      if (patmos_in) then
         patm(nm) = patm0(nm) * onemintwfact + patm1(nm) * twfact
      endif
      !
      if (precip_in) then
         !
         prcp(nm) = prcp0(nm) * onemintwfact + prcp1(nm) * twfact
         !
         if (prcp(nm) < 0.0) then
            if (subgrid_in) then
               if (z_volume(nm) <= 0.0) prcp(nm) = 0.0
            else
               if (zs(nm) <= zb(nm)) prcp(nm) = 0.0
            endif
         endif
         !
         netprcp(nm) = prcp(nm)
         !
         if (store_cumprcp_in) then
            cumprcp(nm) = cumprcp(nm) + prcp(nm) * dt
         endif
         !
      endif
      !
      ! Spinup factor branch
      !
      if (do_spinup_in) then
         !
         if (wind_in) then
            tauwu(nm) = tauwu(nm) * smfac
            tauwv(nm) = tauwv(nm) * smfac
         endif
         !
         if (patmos_in) then
            patm(nm) = patm(nm) * smfac + gapres_in * oneminsmfac
         endif
         !
         if (precip_in) then
            !
            netprcp(nm) = netprcp(nm) * smfac
            !
            if (netprcp(nm) < 0.0) then
               if (subgrid_in) then
                  if (z_volume(nm) <= 0.0) netprcp(nm) = 0.0
               else
                  if (zs(nm) <= zb(nm)) netprcp(nm) = 0.0
               endif
            endif
            !
         endif
         !
      endif
      !
   end subroutine k_meteo_time_interp
   !
   ! Boundary patmb update kernel. Mirrors CPU sibling lines 159-163.
   !
   attributes(global) subroutine k_meteo_patmb(ngbnd_in)
      !
      implicit none
      !
      integer, value :: ngbnd_in
      !
      integer :: ib
      !
      ib = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (ib > ngbnd_in) return
      !
      patmb(ib) = patm(nmindbnd(ib))
      !
   end subroutine k_meteo_patmb
   !
   ! Spatially-uniform wind kernel. Mirrors CPU sibling lines 234-248.
   !
   attributes(global) subroutine k_wind_uniform(npn_in, twu_in, twv_in, &
                                                wu_uni_in, wv_uni_in, &
                                                store_wind_in)
      !
      implicit none
      !
      integer, value :: npn_in
      real*4,  value :: twu_in
      real*4,  value :: twv_in
      real*4,  value :: wu_uni_in
      real*4,  value :: wv_uni_in
      logical, value :: store_wind_in
      !
      integer :: nm
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      tauwu(nm) = twu_in
      tauwv(nm) = twv_in
      !
      if (store_wind_in) then
         windu(nm) = wu_uni_in
         windv(nm) = wv_uni_in
      endif
      !
   end subroutine k_wind_uniform
   !
   ! Spatially-uniform precipitation kernel. Mirrors CPU sibling
   ! lines 287-296.
   !
   attributes(global) subroutine k_precip_uniform(npn_in, dt, ptmp_in, &
                                                  store_cumprcp_in)
      !
      implicit none
      !
      integer, value :: npn_in
      real*4,  value :: dt
      real*4,  value :: ptmp_in
      logical, value :: store_cumprcp_in
      !
      integer :: nm
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      prcp(nm)    = ptmp_in
      netprcp(nm) = ptmp_in
      !
      if (store_cumprcp_in) then
         cumprcp(nm) = cumprcp(nm) + ptmp_in * dt
      endif
      !
   end subroutine k_precip_uniform
   !
   ! -----------------------------------------------------------------
   ! GPU port of update_amp_data. Mirrors CPU sibling
   ! sfincs_meteo_io.f90:963-1090 — atmospheric-pressure regular-grid
   ! bilinear interpolation onto SFINCS cells.
   !
   ! The outer do itw = 1, 2 loop fills the *0 staging array (itw=1) or
   ! *1 staging array (itw=2). Per itw: a host-side time-find preamble
   ! computes itw0/itw1/twfac against amp_times, then two kernels run:
   !   - k_amp_snapshot: amp_nrows*amp_ncols threads compute amp_patm01
   !     via blend of amp_patm(itw0,...) and amp_patm(itw1,...) by twfac.
   !   - k_amp_spatial:  npn_local threads bilinearly interpolate
   !     amp_patm01 onto each cell, writing patm0/patm1.
   ! cudaDeviceSynchronize() between snapshot and spatial because the
   ! spatial kernel reads amp_patm01 written by snapshot.
   !
   ! After both halves complete, a D2H staging block publishes the
   ! device-resident patm0/patm1 back to the host arrays. This is needed
   ! during the staging period because (a) the still-CPU
   ! update_spiderweb_data reads host patm0/patm1 as a merge base, and
   ! (b) the bridge-IN block in update_meteo_forcing would otherwise
   ! H2D-clobber the device writes with stale host values. The D2H block
   ! drops once all four spatial-interp kernels are GPU-resident and the
   ! bridge-trim issue lands.
   ! -----------------------------------------------------------------
   subroutine update_amp_data()
      !
      use sfincs_data, only: meteo_t0_h => meteo_t0, meteo_t1_h => meteo_t1, &
                             amp_nt_h => amp_nt, &
                             amp_nrows_h => amp_nrows, amp_ncols_h => amp_ncols, &
                             amp_dx_h => amp_dx, amp_dy_h => amp_dy, &
                             amp_x_llcorner_h => amp_x_llcorner, &
                             amp_y_llcorner_h => amp_y_llcorner, &
                             amp_times_h => amp_times, &
                             gapres_h => gapres, &
                             patm0_h => patm0, patm1_h => patm1
      !
      implicit none
      !
      integer :: itw, itw0, itw1, itspw
      integer :: blocks
      integer :: snap_threads
      integer :: snap_blocks
      integer :: istat
      real*4  :: meteo_t
      real*4  :: twfac
      real*4  :: yul, xll
      !
      yul = amp_y_llcorner_h + (amp_nrows_h - 1) * amp_dy_h + 0.5 * amp_dy_h
      xll = amp_x_llcorner_h + 0.5 * amp_dx_h
      !
      do itw = 1, 2
         !
         if (itw == 1) then
            meteo_t = real(meteo_t0_h, kind=4)
         else
            meteo_t = real(meteo_t1_h, kind=4)
         endif
         !
         ! Clamp meteo_t into [amp_times(1), amp_times(amp_nt)]
         !
         meteo_t = max(meteo_t, amp_times_h(1))
         meteo_t = min(meteo_t, amp_times_h(amp_nt_h))
         !
         ! Find time indices in amp file
         !
         itw0 = 1
         do itspw = 1, amp_nt_h
            if (amp_times_h(itspw) <= meteo_t) then
               itw0 = itspw
            endif
         enddo
         !
         itw1 = itw0 + 1
         itw1 = min(itw1, amp_nt_h)
         !
         meteo_t = min(meteo_t, amp_times_h(itw1))
         !
         twfac = (meteo_t - amp_times_h(itw0)) / max(amp_times_h(itw1) - amp_times_h(itw0), 1.0e-6)
         !
         ! Snapshot: blend amp_patm(itw0,...) and amp_patm(itw1,...) into amp_patm01
         !
         snap_threads = amp_nrows_h * amp_ncols_h
         snap_blocks  = (snap_threads + TPB - 1) / TPB
         !
         call k_amp_snapshot<<<snap_blocks, TPB>>>(itw0, itw1, twfac, &
            amp_nrows_h, amp_ncols_h)
         !
         istat = cudaDeviceSynchronize()
         !
         ! Spatial: bilinear interpolation of amp_patm01 onto SFINCS cells
         !
         blocks = (npn_local + TPB - 1) / TPB
         !
         call k_amp_spatial<<<blocks, TPB>>>(itw, npn_local, &
            amp_nrows_h, amp_ncols_h, &
            amp_dx_h, amp_dy_h, yul, xll, &
            real(gapres_h, kind=4))
         !
         istat = cudaDeviceSynchronize()
         !
      enddo
      !
      ! D2H staging — keep host patm0/patm1 in sync for downstream CPU
      ! consumers (still-CPU update_spiderweb_data merge base) and to
      ! make the bridge-IN H2D copy in update_meteo_forcing a no-op.
      ! Removed once SOR-740 (bridge-trim integration) lands.
      !
      patm0_h = patm0
      patm1_h = patm1
      !
   end subroutine update_amp_data
   !
   ! Snapshot kernel: amp_patm01(irow, icol) = blend of amp_patm slices
   ! at itw0 / itw1 by twfac. Mirrors CPU sibling lines 1009-1015.
   !
   attributes(global) subroutine k_amp_snapshot(itw0_in, itw1_in, twfac_in, &
                                                amp_nrows_in, amp_ncols_in)
      !
      implicit none
      !
      integer, value :: itw0_in
      integer, value :: itw1_in
      real*4,  value :: twfac_in
      integer, value :: amp_nrows_in
      integer, value :: amp_ncols_in
      !
      integer :: tid, irow, icol
      !
      tid = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (tid > amp_nrows_in * amp_ncols_in) return
      !
      irow = ((tid - 1) / amp_ncols_in) + 1
      icol = mod(tid - 1, amp_ncols_in) + 1
      !
      amp_patm01(irow, icol) = amp_patm(itw0_in, irow, icol) * (1.0 - twfac_in) &
                             + amp_patm(itw1_in, irow, icol) *        twfac_in
      !
   end subroutine k_amp_snapshot
   !
   ! Spatial kernel: bilinear interpolation of amp_patm01 onto each
   ! SFINCS cell. Mirrors CPU sibling lines 1019-1086.
   !
   attributes(global) subroutine k_amp_spatial(itw_in, npn_in, &
                                               amp_nrows_in, amp_ncols_in, &
                                               amp_dx_in, amp_dy_in, &
                                               yul_in, xll_in, gapres_in)
      !
      implicit none
      !
      integer, value :: itw_in
      integer, value :: npn_in
      integer, value :: amp_nrows_in
      integer, value :: amp_ncols_in
      real*4,  value :: amp_dx_in
      real*4,  value :: amp_dy_in
      real*4,  value :: yul_in
      real*4,  value :: xll_in
      real*4,  value :: gapres_in
      !
      integer :: nm
      integer :: ix, iy, ip
      integer :: ind1(4), ind2(4)
      real*4  :: x, y, di1, dj1, pr
      real*4  :: f(4)
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      x = z_xz(nm)
      y = z_yz(nm)
      !
      ! Row indices
      !
      iy = int((yul_in - y) / amp_dy_in) + 1
      ind1(1) = iy
      ind1(2) = iy
      ind1(3) = iy + 1
      ind1(4) = iy + 1
      dj1 = (yul_in - (iy - 1) * amp_dy_in - y) / amp_dy_in
      !
      ! Column indices
      !
      ix = int((x - xll_in) / amp_dx_in) + 1
      ind2(1) = ix
      ind2(2) = ix + 1
      ind2(3) = ix + 1
      ind2(4) = ix
      di1 = (x - (xll_in + (ix - 1) * amp_dx_in)) / amp_dx_in
      !
      if (iy <= 1 .or. iy >= amp_nrows_in .or. ix <= 0 .or. ix >= amp_ncols_in) then
         !
         ! Point outside rectangular amp grid
         !
         if (itw_in == 1) then
            patm0(nm) = gapres_in
         else
            patm1(nm) = gapres_in
         endif
         !
         return
         !
      endif
      !
      ! Bilinear weights
      !
      f(1) = (1.0 - di1) * (1.0 - dj1)
      f(2) = (      di1) * (1.0 - dj1)
      f(3) = (      di1) * (      dj1)
      f(4) = (1.0 - di1) * (      dj1)
      !
      pr = 0.0
      do ip = 1, 4
         pr = pr + f(ip) * amp_patm01(ind1(ip), ind2(ip))
      enddo
      !
      if (itw_in == 1) then
         patm0(nm) = pr
      else
         patm1(nm) = pr
      endif
      !
   end subroutine k_amp_spatial
   !
   ! -----------------------------------------------------------------
   ! GPU port of update_ampr_data. Mirrors CPU sibling
   ! sfincs_meteo_io.f90:1093-1226 — precipitation regular-grid
   ! bilinear interpolation onto SFINCS cells.
   !
   ! The outer do itw = 1, 2 loop fills prcp0 (itw=1) or prcp1 (itw=2).
   ! Per itw: a host-side time-find preamble computes itw0/itw1/twfac
   ! against ampr_times (with twfac forced to 0.0 when ampr_block is
   ! true — block function for rainfall, default), then two kernels run:
   !   - k_ampr_snapshot: ampr_nrows*ampr_ncols threads compute
   !     ampr_pr01 via blend of ampr_pr(itw0,...) and ampr_pr(itw1,...)
   !     by twfac.
   !   - k_ampr_spatial:  npn_local threads bilinearly interpolate
   !     ampr_pr01 onto each cell, writing prcp0/prcp1 in m/s.
   ! cudaDeviceSynchronize() between snapshot and spatial because the
   ! spatial kernel reads ampr_pr01 written by snapshot.
   !
   ! After both halves complete, a D2H staging block publishes the
   ! device-resident prcp0/prcp1 back to the host arrays. Needed during
   ! the staging period so (a) the still-CPU update_spiderweb_data
   ! reads host prcp0/prcp1 as a merge base, and (b) the bridge-IN H2D
   ! in update_meteo_forcing does not clobber the device writes with
   ! stale host values. The D2H block drops once the bridge-trim issue
   ! lands.
   ! -----------------------------------------------------------------
   subroutine update_ampr_data()
      !
      use sfincs_data, only: meteo_t0_h => meteo_t0, meteo_t1_h => meteo_t1, &
                             ampr_nt_h => ampr_nt, &
                             ampr_nrows_h => ampr_nrows, ampr_ncols_h => ampr_ncols, &
                             ampr_dx_h => ampr_dx, ampr_dy_h => ampr_dy, &
                             ampr_x_llcorner_h => ampr_x_llcorner, &
                             ampr_y_llcorner_h => ampr_y_llcorner, &
                             ampr_times_h => ampr_times, &
                             ampr_block_h => ampr_block, &
                             prcp0_h => prcp0, prcp1_h => prcp1
      !
      implicit none
      !
      integer :: itw, itw0, itw1, itspw
      integer :: blocks
      integer :: snap_threads
      integer :: snap_blocks
      integer :: istat
      real*4  :: meteo_t
      real*4  :: twfac
      real*4  :: yul, xll
      !
      yul = ampr_y_llcorner_h + (ampr_nrows_h - 1) * ampr_dy_h + 0.5 * ampr_dy_h
      xll = ampr_x_llcorner_h + 0.5 * ampr_dx_h
      !
      do itw = 1, 2
         !
         if (itw == 1) then
            meteo_t = real(meteo_t0_h, kind=4)
         else
            meteo_t = real(meteo_t1_h, kind=4)
         endif
         !
         ! Clamp meteo_t into [ampr_times(1), ampr_times(ampr_nt)]
         !
         meteo_t = max(meteo_t, ampr_times_h(1))
         meteo_t = min(meteo_t, ampr_times_h(ampr_nt_h))
         !
         ! Find time indices in ampr file
         !
         itw0 = 1
         do itspw = 1, ampr_nt_h
            if (ampr_times_h(itspw) <= meteo_t) then
               itw0 = itspw
            endif
         enddo
         !
         itw1 = itw0 + 1
         itw1 = min(itw1, ampr_nt_h)
         !
         meteo_t = min(meteo_t, ampr_times_h(itw1))
         !
         twfac = (meteo_t - ampr_times_h(itw0)) / max(ampr_times_h(itw1) - ampr_times_h(itw0), 1.0e-6)
         !
         if (ampr_block_h) then
            !
            ! Use block function for rainfall data from ampr files (default)
            !
            twfac = 0.0
            !
         endif
         !
         ! Snapshot: blend ampr_pr(itw0,...) and ampr_pr(itw1,...) into ampr_pr01
         !
         snap_threads = ampr_nrows_h * ampr_ncols_h
         snap_blocks  = (snap_threads + TPB - 1) / TPB
         !
         call k_ampr_snapshot<<<snap_blocks, TPB>>>(itw0, itw1, twfac, &
            ampr_nrows_h, ampr_ncols_h)
         !
         istat = cudaDeviceSynchronize()
         !
         ! Spatial: bilinear interpolation of ampr_pr01 onto SFINCS cells
         !
         blocks = (npn_local + TPB - 1) / TPB
         !
         call k_ampr_spatial<<<blocks, TPB>>>(itw, npn_local, &
            ampr_nrows_h, ampr_ncols_h, &
            ampr_dx_h, ampr_dy_h, yul, xll)
         !
         istat = cudaDeviceSynchronize()
         !
      enddo
      !
      ! D2H staging — keep host prcp0/prcp1 in sync for downstream CPU
      ! consumers (still-CPU update_spiderweb_data merge base) and to
      ! make the bridge-IN H2D copy in update_meteo_forcing a no-op.
      ! Removed once SOR-740 lands.
      !
      prcp0_h = prcp0
      prcp1_h = prcp1
      !
   end subroutine update_ampr_data
   !
   ! Snapshot kernel: ampr_pr01(irow, icol) = blend of ampr_pr slices
   ! at itw0 / itw1 by twfac. Mirrors CPU sibling lines 1146-1152.
   !
   attributes(global) subroutine k_ampr_snapshot(itw0_in, itw1_in, twfac_in, &
                                                 ampr_nrows_in, ampr_ncols_in)
      !
      implicit none
      !
      integer, value :: itw0_in
      integer, value :: itw1_in
      real*4,  value :: twfac_in
      integer, value :: ampr_nrows_in
      integer, value :: ampr_ncols_in
      !
      integer :: tid, irow, icol
      !
      tid = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (tid > ampr_nrows_in * ampr_ncols_in) return
      !
      irow = ((tid - 1) / ampr_ncols_in) + 1
      icol = mod(tid - 1, ampr_ncols_in) + 1
      !
      ampr_pr01(irow, icol) = ampr_pr(itw0_in, irow, icol) * (1.0 - twfac_in) &
                            + ampr_pr(itw1_in, irow, icol) *        twfac_in
      !
   end subroutine k_ampr_snapshot
   !
   ! Spatial kernel: bilinear interpolation of ampr_pr01 onto each
   ! SFINCS cell. Mirrors CPU sibling lines 1156-1223.
   !
   attributes(global) subroutine k_ampr_spatial(itw_in, npn_in, &
                                                ampr_nrows_in, ampr_ncols_in, &
                                                ampr_dx_in, ampr_dy_in, &
                                                yul_in, xll_in)
      !
      implicit none
      !
      integer, value :: itw_in
      integer, value :: npn_in
      integer, value :: ampr_nrows_in
      integer, value :: ampr_ncols_in
      real*4,  value :: ampr_dx_in
      real*4,  value :: ampr_dy_in
      real*4,  value :: yul_in
      real*4,  value :: xll_in
      !
      integer :: nm
      integer :: ix, iy, ip
      integer :: ind1(4), ind2(4)
      real*4  :: x, y, di1, dj1, prp
      real*4  :: f(4)
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      x = z_xz(nm)
      y = z_yz(nm)
      !
      ! Row indices
      !
      iy = int((yul_in - y) / ampr_dy_in) + 1
      ind1(1) = iy
      ind1(2) = iy
      ind1(3) = iy + 1
      ind1(4) = iy + 1
      dj1 = (yul_in - (iy - 1) * ampr_dy_in - y) / ampr_dy_in
      !
      ! Column indices
      !
      ix = int((x - xll_in) / ampr_dx_in) + 1
      ind2(1) = ix
      ind2(2) = ix + 1
      ind2(3) = ix + 1
      ind2(4) = ix
      di1 = (x - (xll_in + (ix - 1) * ampr_dx_in)) / ampr_dx_in
      !
      if (iy <= 1 .or. iy >= ampr_nrows_in .or. ix <= 0 .or. ix >= ampr_ncols_in) then
         !
         ! Point outside rectangular ampr grid
         !
         if (itw_in == 1) then
            prcp0(nm) = 0.0
         else
            prcp1(nm) = 0.0
         endif
         !
         return
         !
      endif
      !
      ! Bilinear weights
      !
      f(1) = (1.0 - di1) * (1.0 - dj1)
      f(2) = (      di1) * (1.0 - dj1)
      f(3) = (      di1) * (      dj1)
      f(4) = (1.0 - di1) * (      dj1)
      !
      prp = 0.0
      do ip = 1, 4
         prp = prp + f(ip) * ampr_pr01(ind1(ip), ind2(ip))
      enddo
      !
      if (itw_in == 1) then
         prcp0(nm) = prp / (1000.0 * 3600.0)   ! m/s
      else
         prcp1(nm) = prp / (1000.0 * 3600.0)   ! m/s
      endif
      !
   end subroutine k_ampr_spatial
   !
   ! -----------------------------------------------------------------
   ! Spiderweb spatial interpolation kernel. One thread per SFINCS cell.
   ! Translates the CPU IO loop body in sfincs_meteo_io.update_spiderweb_data
   ! (lines 543-778) — this is a translation, not a reimplementation.
   ! -----------------------------------------------------------------
   attributes(global) subroutine k_spiderweb_interp( &
      itw_in, npn_in, &
      spw_nrows_in, spw_ncols_in, &
      spw_radius_in, dradspw_in, dphispw_in, &
      spw_xe01_in, spw_ye01_in, &
      tspinup_fac_in, spw_merge_frac_in, &
      crsgeo_in, pi_in, gapres_in, rhoa_in, rhow_in, &
      cosrot_in, sinrot_in, &
      has_amu_in, has_amp_in, has_ampr_in, &
      patmos_in, spw_precip_in, precip_in, store_wind_in, &
      wind_reduction_in, waveage_in)
      !
      implicit none
      !
      integer, value :: itw_in
      integer, value :: npn_in
      integer, value :: spw_nrows_in
      integer, value :: spw_ncols_in
      real*4,  value :: spw_radius_in
      real*4,  value :: dradspw_in
      real*4,  value :: dphispw_in
      real*4,  value :: spw_xe01_in
      real*4,  value :: spw_ye01_in
      real*4,  value :: tspinup_fac_in
      real*4,  value :: spw_merge_frac_in
      logical, value :: crsgeo_in
      real*4,  value :: pi_in
      real*4,  value :: gapres_in
      real*4,  value :: rhoa_in
      real*4,  value :: rhow_in
      real*4,  value :: cosrot_in
      real*4,  value :: sinrot_in
      logical, value :: has_amu_in
      logical, value :: has_amp_in
      logical, value :: has_ampr_in
      logical, value :: patmos_in
      logical, value :: spw_precip_in
      logical, value :: precip_in
      logical, value :: store_wind_in
      logical, value :: wind_reduction_in
      real*4,  value :: waveage_in
      !
      integer :: nm
      integer :: idstspw, iphispw, ip, ivm, iwa, idir, id
      integer :: ind1_1, ind1_2, ind1_3, ind1_4
      integer :: ind2_1, ind2_2, ind2_3, ind2_4
      real*4  :: x, y, dxe, dye, dstspw, di1, dj1, phispw
      real*4  :: f1, f2, f3, f4
      real*4  :: wup, wvp, prp, pcp, vmag, cd
      real*4  :: merge_frac, wa, z0marine, z0l, fd, wdir, facint
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      x = z_xz(nm)
      y = z_yz(nm)
      !
      if (crsgeo_in) then
         dxe = (cos(spw_ye01_in * pi_in / 180.0) * 111111.0) * (x - spw_xe01_in)
         dye = 111111.0 * (y - spw_ye01_in)
      else
         dxe = x - spw_xe01_in
         dye = y - spw_ye01_in
      endif
      !
      dstspw = sqrt(dxe**2 + dye**2)
      !
      ! Initialize output to zero (or gapres for pressure) when the
      ! corresponding background module is absent. Mirrors CPU sibling
      ! lines 566-617.
      !
      if (itw_in == 1) then
         if (.not. has_amu_in) then
            tauwu0(nm) = 0.0
            tauwv0(nm) = 0.0
            if (store_wind_in) then
               windu0(nm) = 0.0
               windv0(nm) = 0.0
            endif
         endif
         if (patmos_in .and. .not. has_amp_in) then
            patm0(nm) = gapres_in
         endif
         if (precip_in .and. spw_precip_in .and. .not. has_ampr_in) then
            prcp0(nm) = 0.0
         endif
      else
         if (.not. has_amu_in) then
            tauwu1(nm) = 0.0
            tauwv1(nm) = 0.0
            if (store_wind_in) then
               windu1(nm) = 0.0
               windv1(nm) = 0.0
            endif
         endif
         if (patmos_in .and. .not. has_amp_in) then
            patm1(nm) = gapres_in
         endif
         if (precip_in .and. spw_precip_in .and. .not. has_ampr_in) then
            prcp1(nm) = 0.0
         endif
      endif
      !
      if (dstspw > spw_radius_in) return  ! Outside spiderweb
      !
      ! Row indices
      !
      idstspw = int(dstspw / dradspw_in)
      if (idstspw < 1) idstspw = 1
      ind1_1 = idstspw
      ind1_2 = idstspw
      ind1_3 = idstspw + 1
      ind1_4 = idstspw + 1
      if (ind1_3 > spw_nrows_in) return
      dj1 = (dstspw - dradspw_in * idstspw) / dradspw_in
      phispw = 0.5 * pi_in - atan2(dye, dxe)
      phispw = modulo(phispw, 2.0 * pi_in)
      !
      ! Column indices
      !
      iphispw = int(phispw / dphispw_in) + 1
      if (iphispw > spw_ncols_in) iphispw = spw_ncols_in
      ind2_1 = iphispw
      ind2_2 = iphispw + 1
      ind2_3 = iphispw + 1
      ind2_4 = iphispw
      if (ind2_2 > spw_ncols_in) ind2_2 = 1
      if (ind2_3 > spw_ncols_in) ind2_3 = 1
      di1 = (phispw - dphispw_in * (iphispw - 1)) / dphispw_in
      !
      ! Bilinear weights
      !
      f1 = (1.0 - di1) * (1.0 - dj1)
      f2 = (      di1) * (1.0 - dj1)
      f3 = (      di1) * (      dj1)
      f4 = (1.0 - di1) * (      dj1)
      !
      ! Interpolate polar buffers
      !
      wup = f1 * spw_wu01(ind1_1, ind2_1) + f2 * spw_wu01(ind1_2, ind2_2) &
          + f3 * spw_wu01(ind1_3, ind2_3) + f4 * spw_wu01(ind1_4, ind2_4)
      wvp = f1 * spw_wv01(ind1_1, ind2_1) + f2 * spw_wv01(ind1_2, ind2_2) &
          + f3 * spw_wv01(ind1_3, ind2_3) + f4 * spw_wv01(ind1_4, ind2_4)
      pcp = 0.0
      prp = 0.0
      if (patmos_in) then
         pcp = f1 * spw_pabs01(ind1_1, ind2_1) + f2 * spw_pabs01(ind1_2, ind2_2) &
             + f3 * spw_pabs01(ind1_3, ind2_3) + f4 * spw_pabs01(ind1_4, ind2_4)
      endif
      if (precip_in .and. spw_precip_in) then
         prp = f1 * spw_prcp01(ind1_1, ind2_1) + f2 * spw_prcp01(ind1_2, ind2_2) &
             + f3 * spw_prcp01(ind1_3, ind2_3) + f4 * spw_prcp01(ind1_4, ind2_4)
      endif
      !
      vmag = sqrt(wup**2 + wvp**2)
      !
      ! Determine Cd
      !
      if (waveage_in > 0.0) then
         wa  = max(min(waveage_in, 1.99), 0.1001)
         ivm = int(vmag / 2.0)
         if (ivm < 1) ivm = 1
         iwa = int(wa / 0.1)
         cd  = 0.001 * cdlgx(ivm, iwa)
      else
         cd  = cdval(int(vmag * 10.0) + 1)
      endif
      !
      ! Merge fraction
      !
      if (dstspw > spw_merge_frac_in * spw_radius_in) then
         merge_frac = (1.0 / (1.0 - min(spw_merge_frac_in, 0.999))) * (spw_radius_in - dstspw) / spw_radius_in
      else
         merge_frac = 1.0
      endif
      merge_frac = merge_frac * tspinup_fac_in
      !
      ! Wind reduction over land
      !
      if (wind_reduction_in) then
         z0marine = 0.001835 * cd * vmag**2
         wdir = 270.0 - atan2(wvp, wup) * 180.0 / pi_in
         if (wdir < 0.0)    wdir = wdir + 360.0
         if (wdir >= 360.0) wdir = wdir - 360.0
         idir = int(wdir / 30.0) + 1
         facint = (wdir - (idir - 1) * 30.0) / 30.0
         if (idir < 12) then
            z0l = z0land(idir, nm) + (z0land(idir + 1, nm) - z0land(idir, nm)) * facint
         else
            z0l = z0land(  12, nm) + (z0land(       1, nm) - z0land(  12, nm)) * facint
         endif
         if (z0l > z0marine) then
            id = int(0.2 * z0l / z0marine) + 1
            if (id > 101) id = 101
            fd = z0land_table(id)
            vmag = fd * vmag
            wup  = fd * wup
            wvp  = fd * wvp
         endif
      endif
      !
      ! Apply merge into the *0 / *1 device shadows.
      !
      if (itw_in == 1) then
         tauwu0(nm) = (1.0 - merge_frac) * tauwu0(nm) + merge_frac * vmag * ( cosrot_in * wup + sinrot_in * wvp) * rhoa_in * cd / rhow_in
         tauwv0(nm) = (1.0 - merge_frac) * tauwv0(nm) + merge_frac * vmag * (-sinrot_in * wup + cosrot_in * wvp) * rhoa_in * cd / rhow_in
         if (patmos_in) then
            patm0(nm) = (1.0 - merge_frac) * patm0(nm) + merge_frac * pcp
         endif
         if (precip_in .and. spw_precip_in) then
            prcp0(nm) = (1.0 - merge_frac) * prcp0(nm) + merge_frac * prp / (1000.0 * 3600.0)
         endif
         if (store_wind_in) then
            windu0(nm) = (1.0 - merge_frac) * windu0(nm) + merge_frac * wup
            windv0(nm) = (1.0 - merge_frac) * windv0(nm) + merge_frac * wvp
         endif
      else
         tauwu1(nm) = (1.0 - merge_frac) * tauwu1(nm) + merge_frac * vmag * ( cosrot_in * wup + sinrot_in * wvp) * rhoa_in * cd / rhow_in
         tauwv1(nm) = (1.0 - merge_frac) * tauwv1(nm) + merge_frac * vmag * (-sinrot_in * wup + cosrot_in * wvp) * rhoa_in * cd / rhow_in
         if (patmos_in) then
            patm1(nm) = (1.0 - merge_frac) * patm1(nm) + merge_frac * pcp
         endif
         if (precip_in .and. spw_precip_in) then
            prcp1(nm) = (1.0 - merge_frac) * prcp1(nm) + merge_frac * prp / (1000.0 * 3600.0)
         endif
         if (store_wind_in) then
            windu1(nm) = (1.0 - merge_frac) * windu1(nm) + merge_frac * wup
            windv1(nm) = (1.0 - merge_frac) * windv1(nm) + merge_frac * wvp
         endif
      endif
      !
   end subroutine k_spiderweb_interp
   !
   ! -----------------------------------------------------------------
   ! Regular-grid wind kernel. Translates the CPU IO loop body in
   ! sfincs_meteo_io.update_amuv_data (lines 846-957).
   ! -----------------------------------------------------------------
   attributes(global) subroutine k_amuv_interp( &
      itw_in, npn_in, &
      amuv_nrows_in, amuv_ncols_in, amuv_dx_in, amuv_dy_in, &
      amuv_xll_in, amuv_yll_in, &
      cosrot_in, sinrot_in, rhoa_in, rhow_in, &
      waveage_in, store_wind_in, radstr_in)
      !
      implicit none
      !
      integer, value :: itw_in
      integer, value :: npn_in
      integer, value :: amuv_nrows_in
      integer, value :: amuv_ncols_in
      real*4,  value :: amuv_dx_in
      real*4,  value :: amuv_dy_in
      real*4,  value :: amuv_xll_in
      real*4,  value :: amuv_yll_in
      real*4,  value :: cosrot_in
      real*4,  value :: sinrot_in
      real*4,  value :: rhoa_in
      real*4,  value :: rhow_in
      real*4,  value :: waveage_in
      logical, value :: store_wind_in
      logical, value :: radstr_in
      !
      integer :: nm, ix, iy, ivm, iwa
      integer :: ind1_1, ind1_2, ind1_3, ind1_4
      integer :: ind2_1, ind2_2, ind2_3, ind2_4
      real*4  :: x, y, yul, xll, di1, dj1
      real*4  :: f1, f2, f3, f4
      real*4  :: wup, wvp, vmag, cd, wa
      !
      nm = (blockIdx%x - 1) * blockDim%x + threadIdx%x
      if (nm > npn_in) return
      !
      yul = amuv_yll_in + (amuv_nrows_in - 1) * amuv_dy_in + 0.5 * amuv_dy_in
      xll = amuv_xll_in + 0.5 * amuv_dx_in
      !
      x = z_xz(nm)
      y = z_yz(nm)
      !
      iy = int((yul - y) / amuv_dy_in) + 1
      ind1_1 = iy
      ind1_2 = iy
      ind1_3 = iy + 1
      ind1_4 = iy + 1
      dj1 = (yul - (iy - 1) * amuv_dy_in - y) / amuv_dy_in
      !
      ix = int((x - xll) / amuv_dx_in) + 1
      ind2_1 = ix
      ind2_2 = ix + 1
      ind2_3 = ix + 1
      ind2_4 = ix
      di1 = (x - (xll + (ix - 1) * amuv_dx_in)) / amuv_dx_in
      !
      if (iy <= 1 .or. iy >= amuv_nrows_in .or. ix <= 0 .or. ix >= amuv_ncols_in) then
         if (itw_in == 1) then
            tauwu0(nm) = 0.0
            tauwv0(nm) = 0.0
         else
            tauwu1(nm) = 0.0
            tauwv1(nm) = 0.0
         endif
         return
      endif
      !
      f1 = (1.0 - di1) * (1.0 - dj1)
      f2 = (      di1) * (1.0 - dj1)
      f3 = (      di1) * (      dj1)
      f4 = (1.0 - di1) * (      dj1)
      !
      wup = f1 * amuv_wu01(ind1_1, ind2_1) + f2 * amuv_wu01(ind1_2, ind2_2) &
          + f3 * amuv_wu01(ind1_3, ind2_3) + f4 * amuv_wu01(ind1_4, ind2_4)
      wvp = f1 * amuv_wv01(ind1_1, ind2_1) + f2 * amuv_wv01(ind1_2, ind2_2) &
          + f3 * amuv_wv01(ind1_3, ind2_3) + f4 * amuv_wv01(ind1_4, ind2_4)
      !
      vmag = sqrt(wup**2 + wvp**2)
      !
      if (waveage_in > 0.0) then
         wa  = max(min(waveage_in, 1.99), 0.1001)
         ivm = int(vmag / 2.0)
         if (ivm < 1) ivm = 1
         iwa = int(wa / 0.1)
         cd  = 0.001 * cdlgx(ivm, iwa)
      else
         cd  = cdval(int(vmag * 10.0) + 1)
      endif
      !
      if (radstr_in) then
         if (itw_in == 1) then
            tauwu0(nm) = ( cosrot_in * wup + sinrot_in * wvp) / rhow_in
            tauwv0(nm) = (-sinrot_in * wup + cosrot_in * wvp) / rhow_in
         else
            tauwu1(nm) = ( cosrot_in * wup + sinrot_in * wvp) / rhow_in
            tauwv1(nm) = (-sinrot_in * wup + cosrot_in * wvp) / rhow_in
         endif
      else
         if (itw_in == 1) then
            tauwu0(nm) = vmag * ( cosrot_in * wup + sinrot_in * wvp) * rhoa_in * cd / rhow_in
            tauwv0(nm) = vmag * (-sinrot_in * wup + cosrot_in * wvp) * rhoa_in * cd / rhow_in
            if (store_wind_in) then
               windu0(nm) = wup
               windv0(nm) = wvp
            endif
         else
            tauwu1(nm) = vmag * ( cosrot_in * wup + sinrot_in * wvp) * rhoa_in * cd / rhow_in
            tauwv1(nm) = vmag * (-sinrot_in * wup + cosrot_in * wvp) * rhoa_in * cd / rhow_in
            if (store_wind_in) then
               windu1(nm) = wup
               windv1(nm) = wvp
            endif
         endif
      endif
      !
   end subroutine k_amuv_interp
   !
end module sfincs_meteo
