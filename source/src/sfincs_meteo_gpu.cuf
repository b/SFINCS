         ! Spatial: bilinear interpolation of amp_patm01 onto SFINCS cells.
         ! Halo-extended iteration (SOR-38, Defect 3): refresh halo
         ! positions of patm0/patm1 so the time-interp kernel reads a
         ! consistent value at halo cells on every rank.
         !
         blocks = (npn_local + halo_cell_count + TPB - 1) / TPB
         !
         call k_amp_spatial<<<blocks, TPB>>>(itw, npn_local + halo_cell_count, &
            amp_nrows_h, amp_ncols_h, &
            amp_dx_h, amp_dy_h, yul, xll, &
            real(gapres_h, kind=4))
