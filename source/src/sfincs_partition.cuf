   !
   subroutine halo_exchange_zs()
      !
      ! Per-step halo exchange of cell water levels (zs) across rank
      ! boundaries. CUDA-aware MPI consumes the device-side staging
      ! buffers directly; the gather/scatter kernels read/write the
      ! local-indexed device shadow of zs directly through the
      ! local-indexed halo_*_local_idx descriptors (no
      ! local_to_global_d translation — that step was needed only while
      ! the device shadow was full-size global-indexed).
      !
      integer :: nbr_slot, i, n
      integer :: ierr, istat
      integer, allocatable :: request_recv(:), request_send(:)
      integer, allocatable :: statuses_recv(:,:), statuses_send(:,:)
      !
      ! Single-rank fast path: no neighbors, nothing to exchange.
      !
      if (halo_n_neighbors == 0) return
      !
      allocate(request_recv(halo_n_neighbors))
      allocate(request_send(halo_n_neighbors))
      allocate(statuses_recv(MPI_STATUS_SIZE, halo_n_neighbors))
      allocate(statuses_send(MPI_STATUS_SIZE, halo_n_neighbors))
      !
      ! Step 1: post all receives first so they are ready when sends arrive.
      ! CUDA-aware MPI accepts halo_recv_buf_zs's device pointer directly.
      !
      do nbr_slot = 1, halo_n_neighbors
         call MPI_Irecv(halo_recv_buf_zs(:, nbr_slot), halo_recv_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_ZS, &
                        MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
      end do
      !
      ! Step 2: gather owned halo source cells into halo_send_buf_zs. The
      ! local-indexed halo_send_local_idx is translated through
      ! local_to_global_d to address the full-size global-indexed zs.
      ! zs is real*8; the wire format is real*4 to match MPI_REAL.
      !
      do nbr_slot = 1, halo_n_neighbors
         n = halo_send_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            halo_send_buf_zs(i, nbr_slot) = real( zs( halo_send_local_idx(i, nbr_slot) ), kind=4 )
         end do
      end do
      !
      ! Synchronize so the gathered halo_send_buf_zs is fully resident in
      ! device memory before MPI reads from it; the !$cuf kernel launches
      ! on the default stream and HPC-X's CUDA-aware path does not order
      ! itself against that stream automatically.
      !
      istat = cudaDeviceSynchronize()
      !
      ! Step 3: post sends.
      !
      do nbr_slot = 1, halo_n_neighbors
         call MPI_Isend(halo_send_buf_zs(:, nbr_slot), halo_send_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_ZS, &
                        MPI_COMM_WORLD, request_send(nbr_slot), ierr)
      end do
      !
      ! Step 4: wait for the receives so the scatter has data to write.
      !
      call MPI_Waitall(halo_n_neighbors, request_recv, statuses_recv, ierr)
      !
      ! Step 5: scatter halo_recv_buf_zs into the device shadow of zs at
      ! the global positions of our halo cells.
      !
      do nbr_slot = 1, halo_n_neighbors
         n = halo_recv_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            zs( halo_recv_local_idx(i, nbr_slot) ) = real( halo_recv_buf_zs(i, nbr_slot), kind=8 )
         end do
      end do
      !
      ! Make scattered halo cells visible to subsequent kernels before
      ! returning to the time loop.
      !
      istat = cudaDeviceSynchronize()
      !
      ! Step 6: wait for the sends so halo_send_buf_zs is reusable next step.
      !
      call MPI_Waitall(halo_n_neighbors, request_send, statuses_send, ierr)
      !
      deallocate(request_recv, request_send, statuses_recv, statuses_send)
      !
   end subroutine halo_exchange_zs
   !
   subroutine halo_exchange_q_uv()
      !
      ! Per-step halo exchange of edge fluxes (q) and edge velocities (uv)
      ! across rank boundaries. Two sequential CUDA-aware MPI exchanges,
      ! each modeled on halo_exchange_zs: gather owned edges into the
      ! device staging buffer, Isend/Irecv with HPC-X consuming the
      ! device pointers directly, scatter the received halo values back
      ! into the local-indexed device shadows of q / uv at the local
      ! edge positions in halo_uv_*_local_idx (no local_to_global_uv_d
      ! translation now that the device shadows are local-indexed).
      !
      integer :: nbr_slot, i, n
      integer :: ierr, istat
      integer, allocatable :: request_recv(:), request_send(:)
      integer, allocatable :: statuses_recv(:,:), statuses_send(:,:)
      !
      ! Single-rank fast path: no neighbors, nothing to exchange.
      !
      if (halo_uv_n_neighbors == 0) return
      !
      allocate(request_recv(halo_uv_n_neighbors))
      allocate(request_send(halo_uv_n_neighbors))
      allocate(statuses_recv(MPI_STATUS_SIZE, halo_uv_n_neighbors))
      allocate(statuses_send(MPI_STATUS_SIZE, halo_uv_n_neighbors))
      !
      ! ===== Exchange #1: q =================================================
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         call MPI_Irecv(halo_recv_buf_q(:, nbr_slot), halo_uv_recv_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_Q, &
                        MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
      end do
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         n = halo_uv_send_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            halo_send_buf_q(i, nbr_slot) = q( halo_uv_send_local_idx(i, nbr_slot) )
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         call MPI_Isend(halo_send_buf_q(:, nbr_slot), halo_uv_send_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_Q, &
                        MPI_COMM_WORLD, request_send(nbr_slot), ierr)
      end do
      !
      call MPI_Waitall(halo_uv_n_neighbors, request_recv, statuses_recv, ierr)
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         n = halo_uv_recv_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            q( halo_uv_recv_local_idx(i, nbr_slot) ) = halo_recv_buf_q(i, nbr_slot)
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      call MPI_Waitall(halo_uv_n_neighbors, request_send, statuses_send, ierr)
      !
      ! ===== Exchange #2: uv ================================================
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         call MPI_Irecv(halo_recv_buf_uv(:, nbr_slot), halo_uv_recv_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_UV, &
                        MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
      end do
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         n = halo_uv_send_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            halo_send_buf_uv(i, nbr_slot) = uv( halo_uv_send_local_idx(i, nbr_slot) )
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         call MPI_Isend(halo_send_buf_uv(:, nbr_slot), halo_uv_send_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_UV, &
                        MPI_COMM_WORLD, request_send(nbr_slot), ierr)
      end do
      !
      call MPI_Waitall(halo_uv_n_neighbors, request_recv, statuses_recv, ierr)
      !
      do nbr_slot = 1, halo_uv_n_neighbors
         n = halo_uv_recv_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            uv( halo_uv_recv_local_idx(i, nbr_slot) ) = halo_recv_buf_uv(i, nbr_slot)
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      call MPI_Waitall(halo_uv_n_neighbors, request_send, statuses_send, ierr)
      !
      deallocate(request_recv, request_send, statuses_recv, statuses_send)
      !
   end subroutine halo_exchange_q_uv
   !
   subroutine halo_exchange_meteo()
      !
      ! Per-step halo exchange of meteo cell state across rank boundaries
      ! (SOR-3). Synchronizes patm, tauwu, tauwv at this rank's halo cell
      ! positions with the neighbor-rank owned values written there.
      !
      ! Structural root cause: spiderweb / amp / amuv / wind-timeseries
      ! kernels in sfincs_meteo_gpu.cuf (k_spw_spatial, k_amp_spatial,
      ! k_amuv_spatial, k_meteo_time_interp, k_wind_uniform) all iterate
      ! nm = 1..npn_local — each rank writes patm / tauwu / tauwv only at
      ! its OWNED cell positions, leaving the halo slots [npn_local+1,
      ! npn_total] unwritten from one step to the next. The momentum
      ! kernel k_compute_fluxes then reads patm(nm) - patm(nmu) for the
      ! pressure-gradient term and tauwu(nm) / tauwv(nm) for the wind-
      ! stress term across every owned edge — including edges at the
      ! partition boundary where nm or nmu is a halo cell. With the
      ! halo's patm stuck at its initial value (gapres for spiderweb
      ! cases) while the neighbor rank's owned cells track the moving
      ! eye's pressure deficit, the cross-rank pressure gradient term
      ! spans ~6 kPa per spw step, driving spurious surge that
      ! accumulates step-after-step. tauwu / tauwv at halo positions
      ! cause an analogous wind-stress mismatch on rank-boundary edges.
      !
      ! Why SOR-1013's halo_exchange_q_uv + halo_exchange_zs chain alone
      ! does not cover this: that chain propagates q / uv / zs through
      ! halos but never touches meteo state — patm / tauwu / tauwv are
      ! written by the meteo path, not the momentum/continuity path.
      !
      ! Three sequential exchanges (one per array) modeled on
      ! halo_exchange_zs. allocated() guards keep this a no-op when the
      ! corresponding meteo path isn't active (e.g., patmos == .false.
      ! leaves patm unallocated, in which case the patm exchange is
      ! skipped). Reuses halo_send_buf_zs / halo_recv_buf_zs (both real*4,
      ! sized to max(halo_*_count)) since the meteo arrays share zs's
      ! cell-shape and per-neighbor counts.
      !
      integer :: nbr_slot, i, n
      integer :: ierr, istat
      integer, allocatable :: request_recv(:), request_send(:)
      integer, allocatable :: statuses_recv(:,:), statuses_send(:,:)
      !
      ! Single-rank fast path: no neighbors, nothing to exchange.
      !
      if (halo_n_neighbors == 0) return
      !
      allocate(request_recv(halo_n_neighbors))
      allocate(request_send(halo_n_neighbors))
      allocate(statuses_recv(MPI_STATUS_SIZE, halo_n_neighbors))
      allocate(statuses_send(MPI_STATUS_SIZE, halo_n_neighbors))
      !
      ! ===== Exchange #1: patm ==============================================
      !
      if (allocated(patm)) then
         do nbr_slot = 1, halo_n_neighbors
            call MPI_Irecv(halo_recv_buf_zs(:, nbr_slot), halo_recv_count(nbr_slot), &
                           MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_PATM, &
                           MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
         end do
         !
         do nbr_slot = 1, halo_n_neighbors
            n = halo_send_count(nbr_slot)
            !$cuf kernel do(1) <<<*,*>>>
            do i = 1, n
               halo_send_buf_zs(i, nbr_slot) = patm( halo_send_local_idx(i, nbr_slot) )
            end do
         end do
         !
         istat = cudaDeviceSynchronize()
         !
         do nbr_slot = 1, halo_n_neighbors
            call MPI_Isend(halo_send_buf_zs(:, nbr_slot), halo_send_count(nbr_slot), &
                           MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_PATM, &
                           MPI_COMM_WORLD, request_send(nbr_slot), ierr)
         end do
         !
         call MPI_Waitall(halo_n_neighbors, request_recv, statuses_recv, ierr)
         !
         do nbr_slot = 1, halo_n_neighbors
            n = halo_recv_count(nbr_slot)
            !$cuf kernel do(1) <<<*,*>>>
            do i = 1, n
               patm( halo_recv_local_idx(i, nbr_slot) ) = halo_recv_buf_zs(i, nbr_slot)
            end do
         end do
         !
         istat = cudaDeviceSynchronize()
         !
         call MPI_Waitall(halo_n_neighbors, request_send, statuses_send, ierr)
      end if
      !
      ! ===== Exchange #2: tauwu =============================================
      !
      if (allocated(tauwu)) then
         do nbr_slot = 1, halo_n_neighbors
            call MPI_Irecv(halo_recv_buf_zs(:, nbr_slot), halo_recv_count(nbr_slot), &
                           MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_TAUWU, &
                           MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
         end do
         !
         do nbr_slot = 1, halo_n_neighbors
            n = halo_send_count(nbr_slot)
            !$cuf kernel do(1) <<<*,*>>>
            do i = 1, n
               halo_send_buf_zs(i, nbr_slot) = tauwu( halo_send_local_idx(i, nbr_slot) )
            end do
         end do
         !
         istat = cudaDeviceSynchronize()
         !
         do nbr_slot = 1, halo_n_neighbors
            call MPI_Isend(halo_send_buf_zs(:, nbr_slot), halo_send_count(nbr_slot), &
                           MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_TAUWU, &
                           MPI_COMM_WORLD, request_send(nbr_slot), ierr)
         end do
         !
         call MPI_Waitall(halo_n_neighbors, request_recv, statuses_recv, ierr)
         !
         do nbr_slot = 1, halo_n_neighbors
            n = halo_recv_count(nbr_slot)
            !$cuf kernel do(1) <<<*,*>>>
            do i = 1, n
               tauwu( halo_recv_local_idx(i, nbr_slot) ) = halo_recv_buf_zs(i, nbr_slot)
            end do
         end do
         !
         istat = cudaDeviceSynchronize()
         !
         call MPI_Waitall(halo_n_neighbors, request_send, statuses_send, ierr)
      end if
      !
      ! ===== Exchange #3: tauwv =============================================
      !
      if (allocated(tauwv)) then
         do nbr_slot = 1, halo_n_neighbors
            call MPI_Irecv(halo_recv_buf_zs(:, nbr_slot), halo_recv_count(nbr_slot), &
                           MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_TAUWV, &
                           MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
         end do
         !
         do nbr_slot = 1, halo_n_neighbors
            n = halo_send_count(nbr_slot)
            !$cuf kernel do(1) <<<*,*>>>
            do i = 1, n
               halo_send_buf_zs(i, nbr_slot) = tauwv( halo_send_local_idx(i, nbr_slot) )
            end do
         end do
         !
         istat = cudaDeviceSynchronize()
         !
         do nbr_slot = 1, halo_n_neighbors
            call MPI_Isend(halo_send_buf_zs(:, nbr_slot), halo_send_count(nbr_slot), &
                           MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_TAUWV, &
                           MPI_COMM_WORLD, request_send(nbr_slot), ierr)
         end do
         !
         call MPI_Waitall(halo_n_neighbors, request_recv, statuses_recv, ierr)
         !
         do nbr_slot = 1, halo_n_neighbors
            n = halo_recv_count(nbr_slot)
            !$cuf kernel do(1) <<<*,*>>>
            do i = 1, n
               tauwv( halo_recv_local_idx(i, nbr_slot) ) = halo_recv_buf_zs(i, nbr_slot)
            end do
         end do
         !
         istat = cudaDeviceSynchronize()
         !
         call MPI_Waitall(halo_n_neighbors, request_send, statuses_send, ierr)
      end if
      !
      deallocate(request_recv, request_send, statuses_recv, statuses_send)
      !
   end subroutine halo_exchange_meteo
   !
   subroutine halo_exchange_z_volume()
      !
      ! Per-step halo exchange of subgrid cell volume (z_volume) across rank
      ! boundaries (SOR-3). Synchronizes z_volume at this rank's halo cell
      ! positions with the neighbor-rank owned values written by the
      ! previous step's continuity update.
      !
      ! Structural root cause: subgrid continuity (k_subgrid_main in
      ! sfincs_continuity_gpu.cuf) iterates nm = 1..npn_local and writes
      ! z_volume(nm) only at owned cells. The next step's momentum kernel
      ! k_compute_fluxes (sfincs_momentum_gpu.cuf:632-633) reads
      ! z_volume(nm) AND z_volume(nmu) at every owned edge — including
      ! cross-rank edges where one of nm/nmu is a halo cell — to apply
      ! the over-drainage cap `if z_volume(nm/nmu) < 0 then clamp q`.
      ! Without this exchange the halo's z_volume stays at its
      ! initialize_initial_conditions value while the neighbor rank's
      ! owned cell drains negative; this rank's view misses the cap and
      ! lets q flow OUT of a cell that is physically empty on the
      ! neighbor, producing a small spurious mass injection at the
      ! partition boundary that accumulates step-after-step into
      ! observable ratio drift on long subgrid+SPW+QINF runs (case
      ! production: ~9 mm at the storm-surge hot spot).
      !
      ! Why neither halo_exchange_zs nor halo_exchange_meteo covers this:
      ! zs propagates the surface water level (read at the edge cap
      ! `zs < zb`), patm/tauwu/tauwv propagate the meteo forcing, but
      ! z_volume is the subgrid catalog's primary state variable —
      ! its halo staleness is invisible to those two surfaces.
      !
      ! Modeled on halo_exchange_zs: same descriptor (halo_*_local_idx /
      ! halo_*_count, halo_send_buf_zs / halo_recv_buf_zs sized for cell
      ! rank), real*8 device shadow truncated to real*4 on the wire (cap
      ! detection at zero is unaffected by the truncation, and z_volume's
      ! consumer at the halo position is solely the cap predicate).
      ! Guarded by allocated(z_volume) — single-precision (non-subgrid)
      ! runs have no z_volume and this routine is a no-op.
      !
      integer :: nbr_slot, i, n
      integer :: ierr, istat
      integer, allocatable :: request_recv(:), request_send(:)
      integer, allocatable :: statuses_recv(:,:), statuses_send(:,:)
      !
      ! Single-rank fast path: no neighbors, nothing to exchange.
      !
      if (halo_n_neighbors == 0) return
      !
      ! Subgrid disabled (no z_volume allocated): nothing to exchange.
      !
      if (.not. allocated(z_volume)) return
      !
      allocate(request_recv(halo_n_neighbors))
      allocate(request_send(halo_n_neighbors))
      allocate(statuses_recv(MPI_STATUS_SIZE, halo_n_neighbors))
      allocate(statuses_send(MPI_STATUS_SIZE, halo_n_neighbors))
      !
      do nbr_slot = 1, halo_n_neighbors
         call MPI_Irecv(halo_recv_buf_zs(:, nbr_slot), halo_recv_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_ZVOL, &
                        MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
      end do
      !
      do nbr_slot = 1, halo_n_neighbors
         n = halo_send_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            halo_send_buf_zs(i, nbr_slot) = real( z_volume( halo_send_local_idx(i, nbr_slot) ), kind=4 )
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      do nbr_slot = 1, halo_n_neighbors
         call MPI_Isend(halo_send_buf_zs(:, nbr_slot), halo_send_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_ZVOL, &
                        MPI_COMM_WORLD, request_send(nbr_slot), ierr)
      end do
      !
      call MPI_Waitall(halo_n_neighbors, request_recv, statuses_recv, ierr)
      !
      do nbr_slot = 1, halo_n_neighbors
         n = halo_recv_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            z_volume( halo_recv_local_idx(i, nbr_slot) ) = real( halo_recv_buf_zs(i, nbr_slot), kind=8 )
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      call MPI_Waitall(halo_n_neighbors, request_send, statuses_send, ierr)
      !
      deallocate(request_recv, request_send, statuses_recv, statuses_send)
      !
   end subroutine halo_exchange_z_volume
   !
   ! ===================================================================
   ! SOR-10 cross-rank halo exchange of zsderv (subgrid second derivative
   ! of the water level).
   !
   ! Structural defect this closes (identified by the env-gated diagnostic
   ! at the top of dump_halo_diagnostic, confirmed on the SOR-3
   ! pre-cherry-picked build of case_production:gpu_n2):
   !
   !   * Writer: k_subgrid_main in sfincs_continuity_gpu.cuf iterates
   !     nm = 1..npn_local and writes zsderv(nm) only at OWNED cell
   !     positions. The halo slots [npn_local+1, npn_total] are left at
   !     their Phase-4 init value (zero from the read_initial_conditions
   !     allocation in initialize_domain).
   !
   !   * Reader: k_compute_fluxes in sfincs_momentum_gpu.cuf reads
   !     `abs(zsderv(nm) - zsderv(nmu))` for the wiggle-suppression term
   !     across every owned edge whose endpoints (nm, nmu) span the
   !     partition boundary -- nm or nmu is then a halo cell.
   !
   !   * Diagnostic finding: with SOR-3's parallel halo additions
   !     cherry-picked in to mask the dominant SPW / z_volume defects,
   !     the env-gated dump shows 81/108 zsderv samples diverging across
   !     ranks (rank 0 halo zsderv = 0.0 vs rank 1 owned zsderv = 1.44e-3
   !     at the first diagnostic step, analogous mismatches every step in
   !     the case_production hotspot 322900..323400 x 5043800..5044700).
   !     The dominant SPW / wind-stress / z_volume halo paths show zero
   !     mismatches; zsderv is the residual surface.
   !
   !   * Why the SOR-708 halo_exchange_zs / SOR-709 halo_exchange_q_uv
   !     chain does not cover this: those exchanges propagate zs / q / uv
   !     through halos but never touch zsderv -- zsderv is a per-step
   !     derived quantity (`zs - 2*zs0 + zs00`) written by the continuity
   !     update, not the momentum update.
   !
   ! Modeled on halo_exchange_zs: same single-array exchange pattern,
   ! distinct MPI tag (HALO_TAG_ZSDERV) so concurrent exchanges cannot
   ! collide. zsderv is real*4 on host and device, so no wire-format
   ! conversion is needed (the zs exchange downcasts real*8 to real*4 for
   ! the wire; this one does not). Reuses halo_send_buf_zs /
   ! halo_recv_buf_zs (both real*4, sized to max(halo_*_count)) since the
   ! per-neighbor cell counts and layouts are identical to zs.
   !
   ! No-op for mpi_size == 1 (halo_n_neighbors == 0) and for builds
   ! without wiggle_suppression (`if (allocated(zsderv))` guard); the
   ! cost on multi-rank wiggle-suppression builds is one gather kernel +
   ! one MPI_Isend/Irecv pair per neighbor per step, identical to the
   ! existing halo_exchange_zs and bounded by the rank-pair halo size.
   ! ===================================================================
   subroutine halo_exchange_zsderv()
      !
      integer :: nbr_slot, i, n
      integer :: ierr, istat
      integer, allocatable :: request_recv(:), request_send(:)
      integer, allocatable :: statuses_recv(:,:), statuses_send(:,:)
      !
      if (halo_n_neighbors == 0) return
      if (.not. allocated(zsderv)) return
      !
      allocate(request_recv(halo_n_neighbors))
      allocate(request_send(halo_n_neighbors))
      allocate(statuses_recv(MPI_STATUS_SIZE, halo_n_neighbors))
      allocate(statuses_send(MPI_STATUS_SIZE, halo_n_neighbors))
      !
      do nbr_slot = 1, halo_n_neighbors
         call MPI_Irecv(halo_recv_buf_zs(:, nbr_slot), halo_recv_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_ZSDERV, &
                        MPI_COMM_WORLD, request_recv(nbr_slot), ierr)
      end do
      !
      do nbr_slot = 1, halo_n_neighbors
         n = halo_send_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            halo_send_buf_zs(i, nbr_slot) = zsderv( halo_send_local_idx(i, nbr_slot) )
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      do nbr_slot = 1, halo_n_neighbors
         call MPI_Isend(halo_send_buf_zs(:, nbr_slot), halo_send_count(nbr_slot), &
                        MPI_REAL, halo_neighbor_ranks(nbr_slot), HALO_TAG_ZSDERV, &
                        MPI_COMM_WORLD, request_send(nbr_slot), ierr)
      end do
      !
      call MPI_Waitall(halo_n_neighbors, request_recv, statuses_recv, ierr)
      !
      do nbr_slot = 1, halo_n_neighbors
         n = halo_recv_count(nbr_slot)
         !$cuf kernel do(1) <<<*,*>>>
         do i = 1, n
            zsderv( halo_recv_local_idx(i, nbr_slot) ) = halo_recv_buf_zs(i, nbr_slot)
         end do
      end do
      !
      istat = cudaDeviceSynchronize()
      !
      call MPI_Waitall(halo_n_neighbors, request_send, statuses_send, ierr)
      !
      deallocate(request_recv, request_send, statuses_recv, statuses_send)
      !
   end subroutine halo_exchange_zsderv
   !
   ! ===================================================================
   ! SOR-10 env-gated halo diagnostic dump.
   !
   ! When SFINCS_DEBUG_HALO_DUMP is set to a positive integer N, every Nth
   ! call writes per-rank CSV rows for the suspect device arrays sampled at
   ! both OWNED and HALO cell positions whose host (x, y) lies inside the
   ! diagnostic spatial box (case_production storm-surge hot-spot at the
   ! partition split):
   !
   !   x in [SFINCS_DEBUG_HALO_DUMP_XMIN .. _XMAX]   (default 322900..323400)
   !   y in [SFINCS_DEBUG_HALO_DUMP_YMIN .. _YMAX]   (default 5043800..5044700)
   !
   ! Output: sfincs_halo_dump_rank<N>.csv in the current working directory.
   ! Each row carries (step, t, rank, kind, global_index, x, y, dx_from_split,
   ! array_name, value) so a small post-processing script can pivot per
   ! (step, global_index, array_name) and compare rank0's owned value
   ! against rank1's halo value (and vice versa). An array whose halo cell
   ! diverges from the owning rank's owned cell at the same global index
   ! is missing a halo-exchange / bridge / renumber path covering it.
   !
   ! Cost: zero when SFINCS_DEBUG_HALO_DUMP is unset (single getenv at call
   ! site, integer parse, early-return on N <= 0). When enabled, the dump
   ! reads device shadows back to small host workbufs (one per array, sized
   ! to the diagnostic box), so the runtime cost is bounded by box size
   ! rather than full domain size.
   !
   ! The dump persists in-tree behind the gate so future cross-rank
   ! regressions in the same kernel-level halo machinery can be triaged
   ! with the same harness.
   ! ===================================================================
   subroutine dump_halo_diagnostic(step, t)
      !
      use sfincs_data, only: z_xz_h => z_xz, z_yz_h => z_yz, &
                             subgrid_h => subgrid, &
                             coriolis_h => coriolis, &
                             wiggle_suppression_h => wiggle_suppression, &
                             wind_h => wind, patmos_h => patmos, &
                             precip_h => precip
      !
      implicit none
      !
      integer, intent(in) :: step
      real*8,  intent(in) :: t
      !
      character(len=64)  :: env_period, env_xmin, env_xmax, env_ymin, env_ymax, env_xsplit
      character(len=256) :: filename
      integer :: period
      integer :: ios
      integer :: i, g
      integer :: unit
      logical :: opened
      real*4  :: xmin, xmax, ymin, ymax, xsplit
      real*4  :: xv, yv, dx
      character(len=16) :: kind
      logical, save :: header_written = .false.
      !
      ! Cell-rank workbufs for snapshot of device arrays.
      !
      real*8, allocatable :: zs_buf(:)
      real*8, allocatable :: z_volume_buf(:)
      real*4, allocatable :: zsderv_buf(:)
      real*4, allocatable :: patm_buf(:)
      real*4, allocatable :: tauwu_buf(:)
      real*4, allocatable :: tauwv_buf(:)
      real*4, allocatable :: fcorio2d_buf(:)
      real*4, allocatable :: prcp_buf(:)
      real*4, allocatable :: netprcp_buf(:)
      real*4, allocatable :: zsmax_buf(:)
      integer :: nc
      !
      ! Read the env var. The runtime cost when the var is unset is just
      ! this getenv + integer parse.
      !
      call get_environment_variable('SFINCS_DEBUG_HALO_DUMP', env_period)
      if (len_trim(env_period) == 0) return
      !
      read(env_period, *, iostat=ios) period
      if (ios /= 0 .or. period <= 0) return
      if (mod(step, period) /= 0) return
      !
      ! Optional override of the diagnostic box (defaults are the
      ! case_production storm-surge hot-spot at the partition split).
      !
      xmin   = 322900.0
      xmax   = 323400.0
      ymin   = 5043800.0
      ymax   = 5044700.0
      xsplit = 322906.0
      call get_environment_variable('SFINCS_DEBUG_HALO_DUMP_XMIN', env_xmin)
      if (len_trim(env_xmin) > 0) read(env_xmin, *, iostat=ios) xmin
      call get_environment_variable('SFINCS_DEBUG_HALO_DUMP_XMAX', env_xmax)
      if (len_trim(env_xmax) > 0) read(env_xmax, *, iostat=ios) xmax
      call get_environment_variable('SFINCS_DEBUG_HALO_DUMP_YMIN', env_ymin)
      if (len_trim(env_ymin) > 0) read(env_ymin, *, iostat=ios) ymin
      call get_environment_variable('SFINCS_DEBUG_HALO_DUMP_YMAX', env_ymax)
      if (len_trim(env_ymax) > 0) read(env_ymax, *, iostat=ios) ymax
      call get_environment_variable('SFINCS_DEBUG_HALO_DUMP_XSPLIT', env_xsplit)
      if (len_trim(env_xsplit) > 0) read(env_xsplit, *, iostat=ios) xsplit
      !
      nc = npn_local + halo_cell_count
      if (nc <= 0) return
      !
      ! Snapshot the suspect cell-rank device arrays into host workbufs
      ! covering the full local range (owned + halo). The kernel-read sites
      ! whose halo cells could leak (k_compute_fluxes at nm / nmu of owned
      ! edges crossing the partition split) span exactly this range, so
      ! sampling here captures the value the next kernel will see.
      !
      if (allocated(zs)) then
         allocate(zs_buf(nc));         zs_buf       = zs(1:nc)
      end if
      if (allocated(z_volume)) then
         allocate(z_volume_buf(nc));   z_volume_buf = z_volume(1:nc)
      end if
      if (allocated(zsderv)) then
         allocate(zsderv_buf(nc));     zsderv_buf   = zsderv(1:nc)
      end if
      if (allocated(patm)) then
         allocate(patm_buf(nc));       patm_buf     = patm(1:nc)
      end if
      if (allocated(tauwu)) then
         allocate(tauwu_buf(nc));      tauwu_buf    = tauwu(1:nc)
      end if
      if (allocated(tauwv)) then
         allocate(tauwv_buf(nc));      tauwv_buf    = tauwv(1:nc)
      end if
      if (allocated(fcorio2d)) then
         allocate(fcorio2d_buf(nc));   fcorio2d_buf = fcorio2d(1:nc)
      end if
      if (allocated(prcp)) then
         allocate(prcp_buf(nc));       prcp_buf     = prcp(1:nc)
      end if
      if (allocated(netprcp)) then
         allocate(netprcp_buf(nc));    netprcp_buf  = netprcp(1:nc)
      end if
      if (allocated(zsmax)) then
         allocate(zsmax_buf(nc));      zsmax_buf    = zsmax(1:nc)
      end if
      !
      write(filename, '(a,i0,a)') 'sfincs_halo_dump_rank', mpi_rank, '.csv'
      unit = 50 + mpi_rank
      inquire(unit=unit, opened=opened)
      if (.not. opened) then
         if (header_written) then
            open(unit=unit, file=trim(filename), status='old', position='append', action='write')
         else
            open(unit=unit, file=trim(filename), status='replace', action='write')
            write(unit, '(a)') 'step,t,rank,kind,global_index,x,y,dx_from_split,array,value'
            header_written = .true.
         end if
      end if
      !
      do i = 1, nc
         g = local_to_global(i)
         if (g <= 0) cycle
         if (.not. allocated(z_xz_h) .or. .not. allocated(z_yz_h)) cycle
         if (g > size(z_xz_h) .or. g > size(z_yz_h)) cycle
         xv = real(z_xz_h(g), kind=4)
         yv = real(z_yz_h(g), kind=4)
         if (xv < xmin .or. xv > xmax) cycle
         if (yv < ymin .or. yv > ymax) cycle
         dx = xv - xsplit
         if (i <= npn_local) then
            kind = 'cell-owned'
         else
            kind = 'cell-halo'
         end if
         !
         if (allocated(zs_buf)) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'zs', real(zs_buf(i), kind=8))
         if (allocated(z_volume_buf)) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'z_volume', real(z_volume_buf(i), kind=8))
         if (allocated(zsderv_buf) .and. (subgrid_h .and. wiggle_suppression_h)) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'zsderv', real(zsderv_buf(i), kind=8))
         if (allocated(patm_buf) .and. patmos_h) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'patm', real(patm_buf(i), kind=8))
         if (allocated(tauwu_buf) .and. wind_h) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'tauwu', real(tauwu_buf(i), kind=8))
         if (allocated(tauwv_buf) .and. wind_h) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'tauwv', real(tauwv_buf(i), kind=8))
         if (allocated(fcorio2d_buf) .and. coriolis_h) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'fcorio2d', real(fcorio2d_buf(i), kind=8))
         if (allocated(prcp_buf) .and. precip_h) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'prcp', real(prcp_buf(i), kind=8))
         if (allocated(netprcp_buf) .and. precip_h) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'netprcp', real(netprcp_buf(i), kind=8))
         if (allocated(zsmax_buf)) &
            call write_diag_row(unit, step, t, mpi_rank, trim(kind), g, xv, yv, dx, 'zsmax', real(zsmax_buf(i), kind=8))
      end do
      !
      flush(unit)
      !
      if (allocated(zs_buf))       deallocate(zs_buf)
      if (allocated(z_volume_buf)) deallocate(z_volume_buf)
      if (allocated(zsderv_buf))   deallocate(zsderv_buf)
      if (allocated(patm_buf))     deallocate(patm_buf)
      if (allocated(tauwu_buf))    deallocate(tauwu_buf)
      if (allocated(tauwv_buf))    deallocate(tauwv_buf)
      if (allocated(fcorio2d_buf)) deallocate(fcorio2d_buf)
      if (allocated(prcp_buf))     deallocate(prcp_buf)
      if (allocated(netprcp_buf))  deallocate(netprcp_buf)
      if (allocated(zsmax_buf))    deallocate(zsmax_buf)
      !
   end subroutine dump_halo_diagnostic
   !
   subroutine write_diag_row(unit, step, t, rank, kind, g, x, y, dx, name, value)
      integer,          intent(in) :: unit
      integer,          intent(in) :: step
      real*8,           intent(in) :: t
      integer,          intent(in) :: rank
      character(len=*), intent(in) :: kind
      integer,          intent(in) :: g
      real*4,           intent(in) :: x, y, dx
      character(len=*), intent(in) :: name
      real*8,           intent(in) :: value
      !
      write(unit, '(i0,",",es24.16,",",i0,",",a,",",i0,",",es16.8,",",es16.8,",",es16.8,",",a,",",es24.16)') &
         step, t, rank, kind, g, x, y, dx, name, value
   end subroutine write_diag_row
   !
   subroutine device_to_host_for_output()
      !
      ! Pull every device-resident state array consumed by the netCDF / binary
      ! output writers back to rank 0's full-size global host array, so that
      ! the subsequent write_output(...) call on rank 0 sees the FULL global
      ! state in original cell ordering.
      !
      ! Per array (cell- or uv-indexed): each rank packs its rank-local slice
      ! from the device shadow into a host workbuf, MPI_Gatherv-s to rank 0,
      ! and rank 0 permutes the rank-contiguous gathered buffer back to the
      ! original global cell ordering using gather_perrank_local_to_global
      ! (or _uv). For mpi_size == 1 the helper short-circuits to a direct
      ! arr_h = arr_d D2H copy (the gather/permutation are degenerate).
      !
      ! This is a collective; every rank must enter so the MPI_Gatherv calls
      ! are matched. The rank-0 gating of write_output happens in the caller
      ! (sfincs_lib.F90), AFTER this routine returns.
      !
      ! --- Hydrodynamic state -----------------------------------------------
      !
      if (allocated(zs_h)             .and. allocated(zs))             call gather_to_rank0_in_global_order(zs,             zs_h,             'cell')
      if (allocated(q_h)              .and. allocated(q))              call gather_to_rank0_in_global_order(q,              q_h,              'uv')
      if (allocated(uv_h)             .and. allocated(uv))             call gather_to_rank0_in_global_order(uv,             uv_h,             'uv')
      if (allocated(zsmax_h)          .and. allocated(zsmax))          call gather_to_rank0_in_global_order(zsmax,          zsmax_h,          'cell')
      if (allocated(maxzsm_h)         .and. allocated(maxzsm))         call gather_to_rank0_in_global_order(maxzsm,         maxzsm_h,         'cell')
      if (allocated(qmax_h)           .and. allocated(qmax))           call gather_to_rank0_in_global_order(qmax,           qmax_h,           'cell')
      if (allocated(vmax_h)           .and. allocated(vmax))           call gather_to_rank0_in_global_order(vmax,           vmax_h,           'cell')
      if (allocated(twet_h)           .and. allocated(twet))           call gather_to_rank0_in_global_order(twet,           twet_h,           'cell')
      if (allocated(zsm_h)            .and. allocated(zsm))            call gather_to_rank0_in_global_order(zsm,            zsm_h,            'cell')
      if (allocated(z_volume_h)       .and. allocated(z_volume))       call gather_to_rank0_in_global_order(z_volume,       z_volume_h,       'cell')
      if (allocated(storage_volume_h) .and. allocated(storage_volume)) call gather_to_rank0_in_global_order(storage_volume, storage_volume_h, 'cell')
      !
      ! uvmean is sized nkcuv2 (boundary U/V cell count), not npn_h or
      ! npuv_h, so neither the cell nor uv gather descriptors apply. The
      ! boundary forcing broadcast (SOR-710) keeps every rank's uvmean in
      ! sync with rank 0's, so a plain D2H on rank 0 gives the right value
      ! for restart output. Other ranks skip the copy; the host array is
      ! unused there.
      !
      if (mpi_rank == 0) then
         if (allocated(uvmean_h) .and. allocated(uvmean)) uvmean_h = uvmean
      end if
      !
      ! --- Meteo ------------------------------------------------------------
      !
      if (allocated(windu_h)          .and. allocated(windu))          call gather_to_rank0_in_global_order(windu,          windu_h,          'cell')
      if (allocated(windv_h)          .and. allocated(windv))          call gather_to_rank0_in_global_order(windv,          windv_h,          'cell')
      if (allocated(windmax_h)        .and. allocated(windmax))        call gather_to_rank0_in_global_order(windmax,        windmax_h,        'cell')
      if (allocated(patm_h)           .and. allocated(patm))           call gather_to_rank0_in_global_order(patm,           patm_h,           'cell')
      if (allocated(prcp_h)           .and. allocated(prcp))           call gather_to_rank0_in_global_order(prcp,           prcp_h,           'cell')
      if (allocated(cumprcp_h)        .and. allocated(cumprcp))        call gather_to_rank0_in_global_order(cumprcp,        cumprcp_h,        'cell')
      if (allocated(netprcp_h)        .and. allocated(netprcp))        call gather_to_rank0_in_global_order(netprcp,        netprcp_h,        'cell')
      !
      ! --- Infiltration -----------------------------------------------------
      !
      if (allocated(qinfmap_h)        .and. allocated(qinfmap))        call gather_to_rank0_in_global_order(qinfmap,        qinfmap_h,        'cell')
      if (allocated(cuminf_h)         .and. allocated(cuminf))         call gather_to_rank0_in_global_order(cuminf,         cuminf_h,         'cell')
      if (allocated(scs_Se_h)         .and. allocated(scs_Se))         call gather_to_rank0_in_global_order(scs_Se,         scs_Se_h,         'cell')
      if (allocated(GA_sigma_h)       .and. allocated(GA_sigma))       call gather_to_rank0_in_global_order(GA_sigma,       GA_sigma_h,       'cell')
      if (allocated(GA_F_h)           .and. allocated(GA_F))           call gather_to_rank0_in_global_order(GA_F,           GA_F_h,           'cell')
      if (allocated(rain_T1_h)        .and. allocated(rain_T1))        call gather_to_rank0_in_global_order(rain_T1,        rain_T1_h,        'cell')
      !
      ! --- Discharges / drains ----------------------------------------------
      !
      ! qtsrc is sized by source-point count, replicated identically on every
      ! rank from the input file, so a plain D2H reproduces the correct
      ! global state without a gather.
      !
      if (allocated(qtsrc_h)          .and. allocated(qtsrc))          qtsrc_h          = qtsrc
      !
   end subroutine device_to_host_for_output
   !
   subroutine gather_to_rank0_real4(arr_d, arr_h, kind)
      !
      ! Real(4) cell- or uv-indexed gather. See gather_to_rank0_real8 for
      ! the algorithm; this is the single-precision specialisation.
      !
      real(4), device,  intent(in)    :: arr_d(:)
      real(4),          intent(inout) :: arr_h(:)
      character(len=*), intent(in)    :: kind
      !
      integer :: ierr, i, k, n_local, total
      real(4), allocatable          :: workbuf(:), recvbuf(:)
      real(4), device, allocatable  :: workbuf_d(:)
      !
      ! mpi_size == 1 fast path: rank 0 already owns every cell; the gather
      ! and permutation degenerate to a contiguous copy. Skip the workbuf +
      ! collective overhead and emit a single cudaMemcpy(DeviceToHost),
      ! preserving the pre-multi-rank baseline (SOR-705) bit-identically.
      !
      if (mpi_size == 1) then
         arr_h = arr_d
         return
      end if
      !
      if (kind == 'cell') then
         n_local = npn_local
      else
         n_local = npuv_local
      end if
      !
      ! Step 1: D2H copy the leading n_local owned-cells/edges slice. The
      ! device shadow is now local-indexed (post Phase-4 shrink) so the
      ! pack reduces to a contiguous copy: positions 1..n_local hold the
      ! owned slice in the same order as local_to_global(1:n_local). Use a
      ! cuf kernel to force a device-side copy; PGI's whole-array slice
      ! assignment between device arrays on n>1 ranks did not always
      ! propagate the data on NVHPC 25.9 (rank 1's owned slice came back
      ! all-zero on rank 0 after the MPI gather).
      !
      allocate(workbuf_d(max(n_local, 1)))
      !$cuf kernel do(1) <<<*,*>>>
      do i = 1, n_local
         workbuf_d(i) = arr_d(i)
      end do
      ierr = cudaDeviceSynchronize()
      allocate(workbuf(max(n_local, 1)))
      workbuf = workbuf_d
      deallocate(workbuf_d)
      !
      ! Step 2: MPI_Gatherv to rank 0. Non-root ranks ignore the recv buffer
      ! but still allocate a placeholder so the dummy argument is associated.
      !
      if (kind == 'cell') then
         total = sum(gather_recvcounts)
      else
         total = sum(gather_uv_recvcounts)
      end if
      if (mpi_rank == 0) then
         allocate(recvbuf(max(total, 1)))
      else
         allocate(recvbuf(1))
      end if
      if (kind == 'cell') then
         call mpi_gatherv(workbuf, n_local, MPI_REAL, &
                          recvbuf, gather_recvcounts, gather_displacements, MPI_REAL, &
                          0, MPI_COMM_WORLD, ierr)
      else
         call mpi_gatherv(workbuf, n_local, MPI_REAL, &
                          recvbuf, gather_uv_recvcounts, gather_uv_displacements, MPI_REAL, &
                          0, MPI_COMM_WORLD, ierr)
      end if
      !
      ! Step 3: rank 0 permutes the rank-contiguous flat buffer back to the
      ! original global cell ordering. Position k in the flat buffer holds
      ! the value of global cell gather_perrank_local_to_global(k) (or _uv).
      !
      if (mpi_rank == 0) then
         if (kind == 'cell') then
            do k = 1, total
               arr_h(gather_perrank_local_to_global(k)) = recvbuf(k)
            end do
         else
            do k = 1, total
               arr_h(gather_perrank_local_to_global_uv(k)) = recvbuf(k)
            end do
         end if
      end if
      !
      deallocate(workbuf, recvbuf)
      !
   end subroutine gather_to_rank0_real4
   !
   subroutine gather_to_rank0_real8(arr_d, arr_h, kind)
      !
      ! Real(8) cell- or uv-indexed gather. Mirror of gather_to_rank0_real4
      ! with MPI_DOUBLE_PRECISION and double-precision workbuf / recvbuf.
      ! The catalog has only two real(8) entries (zs, z_volume), both cell-
      ! indexed, but the helper accepts 'uv' for symmetry.
      !
      real(8), device,  intent(in)    :: arr_d(:)
      real(8),          intent(inout) :: arr_h(:)
      character(len=*), intent(in)    :: kind
      !
      integer :: ierr, i, k, n_local, total
      real(8), allocatable          :: workbuf(:), recvbuf(:)
      real(8), device, allocatable  :: workbuf_d(:)
      !
      if (mpi_size == 1) then
         arr_h = arr_d
         return
      end if
      !
      if (kind == 'cell') then
         n_local = npn_local
      else
         n_local = npuv_local
      end if
      !
      ! Pack rank-local slice (see real4 sibling for the reasoning behind
      ! the explicit cuf kernel rather than a slice assignment).
      !
      allocate(workbuf_d(max(n_local, 1)))
      !$cuf kernel do(1) <<<*,*>>>
      do i = 1, n_local
         workbuf_d(i) = arr_d(i)
      end do
      allocate(workbuf(max(n_local, 1)))
      workbuf = workbuf_d
      deallocate(workbuf_d)
      !
      if (kind == 'cell') then
         total = sum(gather_recvcounts)
      else
         total = sum(gather_uv_recvcounts)
      end if
      if (mpi_rank == 0) then
         allocate(recvbuf(max(total, 1)))
      else
         allocate(recvbuf(1))
      end if
      if (kind == 'cell') then
         call mpi_gatherv(workbuf, n_local, MPI_DOUBLE_PRECISION, &
                          recvbuf, gather_recvcounts, gather_displacements, MPI_DOUBLE_PRECISION, &
                          0, MPI_COMM_WORLD, ierr)
      else
         call mpi_gatherv(workbuf, n_local, MPI_DOUBLE_PRECISION, &
                          recvbuf, gather_uv_recvcounts, gather_uv_displacements, MPI_DOUBLE_PRECISION, &
                          0, MPI_COMM_WORLD, ierr)
      end if
      !
      if (mpi_rank == 0) then
         if (kind == 'cell') then
            do k = 1, total
               arr_h(gather_perrank_local_to_global(k)) = recvbuf(k)
            end do
         else
            do k = 1, total
               arr_h(gather_perrank_local_to_global_uv(k)) = recvbuf(k)
            end do
         end if
      end if
      !
      deallocate(workbuf, recvbuf)
      !
   end subroutine gather_to_rank0_real8
   !
end module sfincs_partition
