      if (allocated(hm0_ig_h))                then; allocate(hm0_ig,                mold=hm0_ig_h);                hm0_ig                = hm0_ig_h;                end if
      !
      ! ===== gpu-meteo-spatial-interp supplemental ====
      !
      ! cdval and cdlgx are non-allocatable fixed-size on both host and
      ! device sides; copy them unconditionally. Everything else here
      ! follows the standard mold/copy pattern, gated by allocated() so
      ! we tolerate runs that don't use spiderweb / amuv / amp / ampr.
      !
      cdval = cdval_h
      cdlgx = cdlgx_h
