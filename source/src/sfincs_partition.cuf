module sfincs_partition
   !
   ! GPU partition / device-binding / halo-exchange entry points.
   !
   ! This module owns the bridge between the host-side state in sfincs_data
   ! and its device shadow in sfincs_data_device. Multi-rank partition and
   ! halo discovery are implemented here; halo-exchange execution bodies
   ! for zs (SOR-708) and q/uv (SOR-709) live below. SOR-710 adds the
   ! boundary broadcast; SOR-711 adds SnapWave gather/scatter; SOR-712
   ! adds the output gather. For mpi_size == 1 the partition is
   ! degenerate and the catalog copyin produces device-side arrays
   ! bit-identical to the prior single-rank code path.
   !
   use cudafor
   use mpi
   use sfincs_data_device
   !
   ! Host-side counterparts. The catalog mirrors source/src/sfincs_openacc.f90
   ! lines 15-39. NOTE: the architect mandate refers to a host-side scalar
   ! `npn`; the actual identifier in sfincs_data is `np` (rank-local cell
   ! count). It is renamed here as `npn_h` so the device-side `npn_local`
   ! still maps to a recognisable host name.
   !
   use sfincs_data, only: &
      npn_h => np, npuv_h => npuv, ncuv_h => ncuv, &
      z_xz_h => z_xz, z_yz_h => z_yz, &
      kcs_h => kcs, kfuv_h => kfuv, kcuv_h => kcuv, &
      zs_h => zs, zs0_h => zs0, zsderv_h => zsderv, &
      q_h => q, q0_h => q0, uv_h => uv, uv0_h => uv0, &
      zb_h => zb, zbuv_h => zbuv, zbuvmx_h => zbuvmx, &
      zsmax_h => zsmax, maxzsm_h => maxzsm, qmax_h => qmax, vmax_h => vmax, &
      twet_h => twet, zsm_h => zsm, z_volume_h => z_volume, &
      z_flags_iref_h => z_flags_iref, uv_flags_iref_h => uv_flags_iref, &
      uv_flags_type_h => uv_flags_type, uv_flags_dir_h => uv_flags_dir, &
      mask_adv_h => mask_adv, &
      index_kcuv2_h => index_kcuv2, nmikcuv2_h => nmikcuv2, &
      nmbkcuv2_h => nmbkcuv2, ibkcuv2_h => ibkcuv2, &
      zsb_h => zsb, zsb0_h => zsb0, ibuvdir_h => ibuvdir, uvmean_h => uvmean, &
      subgrid_uv_zmin_h => subgrid_uv_zmin, subgrid_uv_zmax_h => subgrid_uv_zmax, &
      subgrid_uv_havg_h => subgrid_uv_havg, subgrid_uv_nrep_h => subgrid_uv_nrep, &
      subgrid_uv_pwet_h => subgrid_uv_pwet, &
      subgrid_uv_havg_zmax_h => subgrid_uv_havg_zmax, &
      subgrid_uv_nrep_zmax_h => subgrid_uv_nrep_zmax, &
      subgrid_uv_fnfit_h => subgrid_uv_fnfit, subgrid_uv_navg_w_h => subgrid_uv_navg_w, &
      subgrid_z_zmin_h => subgrid_z_zmin, subgrid_z_zmax_h => subgrid_z_zmax, &
      subgrid_z_dep_h => subgrid_z_dep, subgrid_z_volmax_h => subgrid_z_volmax, &
      z_index_uv_md_h => z_index_uv_md, z_index_uv_nd_h => z_index_uv_nd, &
      z_index_uv_mu_h => z_index_uv_mu, z_index_uv_nu_h => z_index_uv_nu, &
      z_index_uv_md1_h => z_index_uv_md1, z_index_uv_md2_h => z_index_uv_md2, &
      z_index_uv_mu1_h => z_index_uv_mu1, z_index_uv_mu2_h => z_index_uv_mu2, &
      z_index_uv_nd1_h => z_index_uv_nd1, z_index_uv_nd2_h => z_index_uv_nd2, &
      z_index_uv_nu1_h => z_index_uv_nu1, z_index_uv_nu2_h => z_index_uv_nu2, &
      uv_index_z_nm_h => uv_index_z_nm, uv_index_z_nmu_h => uv_index_z_nmu, &
      uv_index_u_nmd_h => uv_index_u_nmd, uv_index_u_nmu_h => uv_index_u_nmu, &
      uv_index_u_ndm_h => uv_index_u_ndm, uv_index_u_num_h => uv_index_u_num, &
      uv_index_v_ndm_h => uv_index_v_ndm, uv_index_v_ndmu_h => uv_index_v_ndmu, &
      uv_index_v_nm_h => uv_index_v_nm, uv_index_v_nmu_h => uv_index_v_nmu, &
      nmindsrc_h => nmindsrc, qtsrc_h => qtsrc, &
      drainage_type_h => drainage_type, drainage_params_h => drainage_params, &
      z_index_wavemaker_h => z_index_wavemaker, wavemaker_uvmean_h => wavemaker_uvmean, &
      wavemaker_nmd_h => wavemaker_nmd, wavemaker_nmu_h => wavemaker_nmu, &
      wavemaker_ndm_h => wavemaker_ndm, wavemaker_num_h => wavemaker_num, &
      structure_uv_index_h => structure_uv_index, &
      structure_parameters_h => structure_parameters, &
      structure_type_h => structure_type, structure_length_h => structure_length, &
      fwuv_h => fwuv, &
      tauwu_h => tauwu, tauwv_h => tauwv, &
      tauwu0_h => tauwu0, tauwv0_h => tauwv0, &
      tauwu1_h => tauwu1, tauwv1_h => tauwv1, &
      windu_h => windu, windv_h => windv, &
      windu0_h => windu0, windv0_h => windv0, &
      windu1_h => windu1, windv1_h => windv1, windmax_h => windmax, &
      patm_h => patm, patm0_h => patm0, patm1_h => patm1, patmb_h => patmb, &
      nmindbnd_h => nmindbnd, &
      prcp_h => prcp, prcp0_h => prcp0, prcp1_h => prcp1, &
      cumprcp_h => cumprcp, netprcp_h => netprcp, qext_h => qext, &
      dxminv_h => dxminv, dxrinv_h => dxrinv, dyrinv_h => dyrinv, &
      dxm2inv_h => dxm2inv, dxr2inv_h => dxr2inv, dyr2inv_h => dyr2inv, &
      dxrinvc_h => dxrinvc, dyrinvc_h => dyrinvc, &
      dxm_h => dxm, dxrm_h => dxrm, dyrm_h => dyrm, &
      cell_area_m2_h => cell_area_m2, cell_area_h => cell_area, &
      gn2uv_h => gn2uv, fcorio2d_h => fcorio2d, &
      storage_volume_h => storage_volume, nuvisc_h => nuvisc, &
      cuv_index_uv_h => cuv_index_uv, cuv_index_uv1_h => cuv_index_uv1, &
      cuv_index_uv2_h => cuv_index_uv2, &
      x73_h => x73, gnapp2_h => gnapp2, &
      timestep_analysis_required_timestep_h => timestep_analysis_required_timestep, &
      timestep_analysis_average_required_timestep_h => timestep_analysis_average_required_timestep, &
      timestep_analysis_times_wet_h => timestep_analysis_times_wet, &
      timestep_analysis_times_limiting_h => timestep_analysis_times_limiting, &
      qinffield_h => qinffield, qinfmap_h => qinfmap, cuminf_h => cuminf, &
      scs_rain_h => scs_rain, scs_Se_h => scs_Se, scs_P1_h => scs_P1, &
      scs_F1_h => scs_F1, scs_S1_h => scs_S1, rain_T1_h => rain_T1, &
      ksfield_h => ksfield, &
      GA_head_h => GA_head, GA_sigma_h => GA_sigma, GA_sigma_max_h => GA_sigma_max, &
      GA_F_h => GA_F, GA_Lu_h => GA_Lu, inf_kr_h => inf_kr, &
      horton_kd_h => horton_kd, horton_fc_h => horton_fc, horton_f0_h => horton_f0
   !
   ! ===== gpu-wavemaker-snapwave-coupling supplemental ====
   !
   use sfincs_data, only: &
      wavemaker_index_uv_h    => wavemaker_index_uv, &
      wavemaker_index_nmi_h   => wavemaker_index_nmi, &
      wavemaker_index_nmb_h   => wavemaker_index_nmb, &
      wavemaker_index_wmfp1_h => wavemaker_index_wmfp1, &
      wavemaker_index_wmfp2_h => wavemaker_index_wmfp2, &
      wavemaker_fac_wmfp_h    => wavemaker_fac_wmfp, &
      wavemaker_idir_h        => wavemaker_idir, &
      wavemaker_angfac_h      => wavemaker_angfac, &
      wavemaker_uvtrend_h     => wavemaker_uvtrend, &
      hm0_h                   => hm0, &
      hm0_ig_h                => hm0_ig
   !
   ! ===== gpu-meteo-spatial-interp supplemental ====
   !
   use sfincs_data, only: &
      spw_times_h     => spw_times, &
      spw_xe_h        => spw_xe, &
      spw_ye_h        => spw_ye, &
      spw_wu_h        => spw_wu, &
      spw_wv_h        => spw_wv, &
      spw_pabs_h      => spw_pabs, &
      spw_prcp_h      => spw_prcp, &
      spw_wu01_h      => spw_wu01, &
      spw_wv01_h      => spw_wv01, &
      spw_pabs01_h    => spw_pabs01, &
      spw_prcp01_h    => spw_prcp01, &
      amuv_times_h    => amuv_times, &
      amuv_wu_h       => amuv_wu, &
      amuv_wv_h       => amuv_wv, &
      amuv_wu01_h     => amuv_wu01, &
      amuv_wv01_h     => amuv_wv01, &
      amp_times_h     => amp_times, &
      amp_patm_h      => amp_patm, &
      amp_patm01_h    => amp_patm01, &
      ampr_times_h    => ampr_times, &
      ampr_pr_h       => ampr_pr, &
      ampr_pr01_h     => ampr_pr01, &
      z_xz_h          => z_xz, &
      z_yz_h          => z_yz, &
      cdval_h         => cdval, &
      cdlgx_h         => cdlgx, &
      z0land_h        => z0land, &
      z0land_table_h  => z0land_table
   !
   implicit none
   !
   ! MPI message tags for the halo exchanges. Distinct tags let zs / q / uv
   ! exchanges be in flight concurrently without payload mismatch on the
   ! receiver side. Reserved here per the SOR-708 architect note.
   !
   integer, parameter :: HALO_TAG_ZS = 7081
   integer, parameter :: HALO_TAG_Q  = 7082
   integer, parameter :: HALO_TAG_UV = 7083
   !
   ! Meteo cell-state halo exchange tags (SOR-3). One per array so the three
   ! sequential exchanges in halo_exchange_meteo can never collide.
   !
   integer, parameter :: HALO_TAG_PATM  = 7086
   integer, parameter :: HALO_TAG_TAUWU = 7087
   integer, parameter :: HALO_TAG_TAUWV = 7088
   !
   ! Subgrid z_volume cell-state halo tag (SOR-3). Per-step exchange so the
   ! next step's k_compute_fluxes sees a non-stale z_volume at halo cells
   ! when it checks the `z_volume(nm/nmu) < 0` over-drainage caps.
   !
   integer, parameter :: HALO_TAG_ZVOL  = 7089
   !
   ! Tags reserved for the SOR-1013 debug-gated halo descriptor sanity
   ! exchange. Run only when SFINCS_DEBUG_HALO_CHECK is set in the env, so
   ! they never collide with the runtime halo exchanges above.
   !
   integer, parameter :: HALO_TAG_DBG_COUNT  = 7084
   integer, parameter :: HALO_TAG_DBG_GLOBAL = 7085
   !
   ! SOR-10: tag for the zsderv halo exchange. zsderv is written by
   ! k_subgrid_main at owned cells only and then read by k_compute_fluxes
   ! at halo cell indices via the wiggle-suppression term
   ! `abs(zsderv(nm) - zsderv(nmu))` for owned edges that straddle the
   ! partition boundary. Without the exchange the halo positions stay at
   ! their init value (0.0), so the cross-rank wiggle-suppression view
   ! diverges from the single-rank view whenever |zsderv| crosses
   ! wiggle_threshold. The SOR-10 env-gated diagnostic confirms the
   ! divergence (rank 0 halo zsderv(1423) = 0 at step 50 while rank 1
   ! owned zsderv(1423) = 1.44e-3; analogous mismatches at every
   ! diagnostic step in the case_production hotspot).
   !
   integer, parameter :: HALO_TAG_ZSDERV = 7090
   !
   ! CUDA-aware MPI confirmation. HPC-X / UCX bundled in NVHPC SDK 25.9
   ! provides MPIX_Query_cuda_support; declare an explicit C interface so
   ! the call doesn't depend on whether the host MPI's `mpi_ext` Fortran
   ! module is available.
   !
   interface
      function MPIX_Query_cuda_support() bind(C, name="MPIX_Query_cuda_support")
         use iso_c_binding, only: c_int
         integer(c_int) :: MPIX_Query_cuda_support
      end function MPIX_Query_cuda_support
   end interface
   !
   public  :: partition_and_localize, device_finalize, &
              halo_exchange_zs, halo_exchange_q_uv, &
              halo_exchange_zsderv, &
              halo_exchange_meteo, &
              halo_exchange_z_volume, &
              device_to_host_for_output, &
              allocate_structure_device_shadows, &
              refresh_kcuv_device_shadow, &
              allocate_discharges_device_shadows, &
              allocate_wavemaker_device_shadows, &
              bridge_in_cell_real4, bridge_in_cell_real8, &
              bridge_in_edge_real4, &
              bridge_out_cell_real4, bridge_out_cell_real8, bridge_out_cell_int1, bridge_out_cell_int4, &
              bridge_out_edge_real4, bridge_out_edge_int1, &
              dump_halo_diagnostic
   private :: compute_quadtree_geometric_partition, &
              build_local_index_maps, &
              build_halo_descriptors, &
              validate_halo_descriptors, &
              copyin_phase4_degenerate, &
              sort_indices_by_key, qsort_recursive, &
              gather_to_rank0_in_global_order, &
              gather_to_rank0_real4, gather_to_rank0_real8, &
              gather_cell_int1, gather_cell_int4, gather_cell_real4, gather_cell_real8, &
              gather_edge_int1, gather_edge_real4, &
              gather_edge_wide_int1, gather_edge_wide_real4, &
              gather_cell_int4_renumber_edge, &
              gather_edge_int4_renumber_cell, gather_edge_int4_renumber_edge, &
              renumber_to_local_cell, renumber_to_local_edge, &
              write_diag_row
   !
   ! SOR-712: per-array gather of the rank-local slice of a device shadow
   ! into rank 0's full-size global host array. The two MPI types we need
   ! are real(4) (the bulk of the catalog) and real(8) (zs, z_volume); the
   ! 'kind' string selects the cell- vs uv-indexed partition descriptors.
   !
   interface gather_to_rank0_in_global_order
      module procedure :: gather_to_rank0_real4
      module procedure :: gather_to_rank0_real8
   end interface gather_to_rank0_in_global_order
   !
contains
   !
   subroutine partition_and_localize()
      !
      integer :: ierr
      integer :: nGpus, istat
      logical :: flag
      !
      ! Local partition state. cell_part is owned by this routine and
      ! deallocated before return. local_to_global / local_to_global_uv /
      ! global_to_local / global_to_local_uv live at module scope in
      ! sfincs_data_device.cuf: halo_exchange_zs / halo_exchange_q_uv,
      ! the per-step bridge-IN gathers and bridge-OUT scatters in
      ! source/src/sfincs_*_gpu.cuf, and the deferred shadow allocators
      ! (allocate_structure / allocate_discharges / allocate_wavemaker
      ! device shadows) all need them at runtime.
      !
      integer, allocatable :: cell_part(:)
      integer :: npn_total, npuv_total
      !
      ! --- Phase 1: MPI bootstrap -------------------------------------------
      ! The orchestrator (sfincs_lib) may have already called mpi_init in the
      ! same PR; guard with mpi_initialized so we never double-init.
      !
      call mpi_initialized(flag, ierr)
      if (.not. flag) then
         call mpi_init(ierr)
      end if
      call mpi_comm_rank(MPI_COMM_WORLD, mpi_rank, ierr)
      call mpi_comm_size(MPI_COMM_WORLD, mpi_size, ierr)
      !
      ! --- Phase 1b: CUDA-aware MPI confirmation ----------------------------
      ! Halo exchange passes attributes(device) buffers directly to MPI; this
      ! requires GPUDirect-capable MPI (HPC-X / UCX). Probe once on rank 0,
      ! broadcast, abort everywhere if missing so we never hang in Isend.
      !
      block
         integer :: cuda_aware
         cuda_aware = 0
         if (mpi_rank == 0) then
            cuda_aware = MPIX_Query_cuda_support()
         end if
         call mpi_bcast(cuda_aware, 1, MPI_INTEGER, 0, MPI_COMM_WORLD, ierr)
         if (cuda_aware /= 1) then
            error stop 'CUDA-aware MPI required for halo exchange; HPC-X with GPUDirect needed'
         end if
      end block
      !
      ! --- Phase 2: Device binding ------------------------------------------
      !
      istat = cudaGetDeviceCount(nGpus)
      local_rank = mod(mpi_rank, nGpus)
      istat = cudaSetDevice(local_rank)
      if (istat /= cudaSuccess) then
         error stop 'cudaSetDevice failed'
      end if
      !
      ! --- Phase 3: Quadtree-aware geometric partition ----------------------
      ! compute_quadtree_geometric_partition fills cell_part(1:npn_h) with
      ! 0-based rank ids. build_local_index_maps consumes cell_part plus the
      ! host-side connectivity arrays to produce the cell- and edge-level
      ! local_to_global / global_to_local maps that Phase 4 needs to gather
      ! and renumber catalog arrays. npn_local, npuv_local, halo counts and
      ! cell_index_first/last are set inside build_local_index_maps. For
      ! mpi_size == 1 the partition is degenerate: cell_part(:) == 0,
      ! npn_local == npn_h, npuv_local == npuv_h, halo_count_* == 0 and the
      ! maps are identities, which is what guarantees the N=1 device-side
      ! state stays bit-identical to the prior single-rank path.
      !
      allocate(cell_part(max(npn_h, 1)))
      call compute_quadtree_geometric_partition(cell_part)
      call build_local_index_maps(cell_part, npn_total, npuv_total)
      !
      ! Halo extent scalars consumed by Phase-4 shrink and the per-step
      ! bridge-IN gathers in source/src/sfincs_*_gpu.cuf. Layout:
      ! local indices 1..npn_local own; npn_local+1..npn_local+halo_cell_count
      ! mirror neighbor-rank cells in halo_neighbor_ranks order. Same for edges.
      !
      halo_cell_count = npn_total  - npn_local
      halo_edge_count = npuv_total - npuv_local
      !
      ! --- Phase 4: Allocate device shadows + copyin ------------------------
      ! Every cell-rank device shadow is allocated with size
      ! npn_local + halo_cell_count and gathered from its full-size host
      ! counterpart through local_to_global. Edge-rank device shadows shrink
      ! to npuv_local + halo_edge_count via local_to_global_uv. Connectivity
      ! arrays whose entries are global cell or edge indices are renumbered
      ! through the inverse maps (global_to_local / global_to_local_uv) so
      ! kernel reads into the now-local-indexed device shadows resolve to the
      ! correct local position. Other-sized shadows (boundary-, source-,
      ! struct-, wavemaker-, quadtree-level-, fixed-sized) keep their host
      ! shape via the legacy mold/copy pattern. For mpi_size == 1 the maps
      ! degenerate to identity and halo_*_count == 0, reproducing the
      ! pre-PR single-rank state bit-identically.
      !
      call copyin_phase4_degenerate()
      !
      ! --- Phase 5: Halo descriptor build -----------------------------------
      ! Populates halo_recv_local_idx, halo_recv_remote_idx,
      ! halo_send_local_idx, halo_recv_count, halo_send_count,
      ! halo_neighbor_ranks, halo_n_neighbors and the matching halo_uv_*
      ! arrays declared in sfincs_data_device.cuf. For mpi_size == 1 the
      ! routine returns with halo_n_neighbors == 0 and no allocations
      ! beyond the zero-length neighbor-rank vector.
      !
      call build_halo_descriptors(cell_part)
      !
      ! --- Phase 6: Halo-exchange runtime allocations -----------------------
      ! Mirror local_to_global to the device so the gather/scatter kernels in
      ! halo_exchange_zs can index zs by global position; size the per-zs
      ! send/recv staging buffers to maxval(halo_*_count) so a single 2D
      ! buffer covers every neighbor slot. mpi_size == 1 leaves
      ! halo_n_neighbors == 0 and skips the buffer allocations entirely
      ! (halo_exchange_zs early-returns on that condition).
      !
      if (allocated(local_to_global)) then
         allocate(local_to_global_d(size(local_to_global)))
         local_to_global_d = local_to_global
      end if
      if (allocated(local_to_global_uv)) then
         allocate(local_to_global_uv_d(size(local_to_global_uv)))
         local_to_global_uv_d = local_to_global_uv
      end if
      if (halo_n_neighbors > 0) then
         block
            integer :: max_send_zs, max_recv_zs
            max_send_zs = max(maxval(halo_send_count), 1)
            max_recv_zs = max(maxval(halo_recv_count), 1)
            allocate(halo_send_buf_zs(max_send_zs, halo_n_neighbors))
            allocate(halo_recv_buf_zs(max_recv_zs, halo_n_neighbors))
         end block
      end if
      if (halo_uv_n_neighbors > 0) then
         block
            integer :: max_send_uv, max_recv_uv
            max_send_uv = max(maxval(halo_uv_send_count), 1)
            max_recv_uv = max(maxval(halo_uv_recv_count), 1)
            allocate(halo_send_buf_q (max_send_uv, halo_uv_n_neighbors))
            allocate(halo_recv_buf_q (max_recv_uv, halo_uv_n_neighbors))
            allocate(halo_send_buf_uv(max_send_uv, halo_uv_n_neighbors))
            allocate(halo_recv_buf_uv(max_recv_uv, halo_uv_n_neighbors))
         end block
      end if
      !
      ! --- SOR-1013 descriptor sanity check (env-gated, no-op by default) ---
      !
      call validate_halo_descriptors()
      !
      ! --- Phase 7: SnapWave gather/scatter metadata (SOR-711) --------------
      ! Build per-rank gather metadata for the SnapWave coupling. The CPU
      ! SnapWave solver runs on rank 0 against the full unpartitioned mesh,
      ! so every dtwave step the rank-local slices of zs / windu / windv are
      ! MPI_Gatherv-ed to rank 0 and the resulting fwuv is MPI_Scatterv-ed
      ! back. Counts and displacements are needed on every rank (both sides
      ! of the collectives use them); the per-rank flat local_to_global
      ! permutation is only meaningful on rank 0. The mapping is fixed
      ! across the run because the partition is fixed, so this set-up runs
      ! once here. mpi_size == 1 produces a degenerate (identity) mapping
      ! and the runtime gather/scatter degenerate to local copies.
      !
      allocate(gather_recvcounts(max(mpi_size, 1)))
      allocate(gather_displacements(max(mpi_size, 1)))
      allocate(gather_uv_recvcounts(max(mpi_size, 1)))
      allocate(gather_uv_displacements(max(mpi_size, 1)))
      call mpi_allgather(npn_local,  1, MPI_INTEGER, &
                         gather_recvcounts,  1, MPI_INTEGER, &
                         MPI_COMM_WORLD, ierr)
      call mpi_allgather(npuv_local, 1, MPI_INTEGER, &
                         gather_uv_recvcounts, 1, MPI_INTEGER, &
                         MPI_COMM_WORLD, ierr)
      block
         integer :: r
         gather_displacements(1)    = 0
         gather_uv_displacements(1) = 0
         do r = 2, mpi_size
            gather_displacements(r)    = gather_displacements(r - 1)    + gather_recvcounts(r - 1)
            gather_uv_displacements(r) = gather_uv_displacements(r - 1) + gather_uv_recvcounts(r - 1)
         end do
      end block
      !
      ! Per-rank local_to_global permutations: rank 0 receives every rank's
      ! local_to_global(1:npn_local) into a flat npn_h-sized buffer in
      ! gather_displacements order, so position k of the gathered data
      ! buffer maps to global cell id gather_perrank_local_to_global(k).
      ! Other ranks allocate a placeholder (MPI_Gatherv ignores the recv
      ! buffer on non-root ranks).
      !
      if (mpi_rank == 0) then
         allocate(gather_perrank_local_to_global   (max(npn_h,  1)))
         allocate(gather_perrank_local_to_global_uv(max(npuv_h, 1)))
      else
         allocate(gather_perrank_local_to_global   (1))
         allocate(gather_perrank_local_to_global_uv(1))
      end if
      call mpi_gatherv(local_to_global,    npn_local,  MPI_INTEGER, &
                       gather_perrank_local_to_global, &
                       gather_recvcounts, gather_displacements, MPI_INTEGER, &
                       0, MPI_COMM_WORLD, ierr)
      call mpi_gatherv(local_to_global_uv, npuv_local, MPI_INTEGER, &
                       gather_perrank_local_to_global_uv, &
                       gather_uv_recvcounts, gather_uv_displacements, MPI_INTEGER, &
                       0, MPI_COMM_WORLD, ierr)
      !
      ! Drop host-side temporaries. The state that needs to live past this
      ! routine is the device-resident catalog plus the halo descriptor
      ! arrays and local_to_global / local_to_global_uv / global_to_local /
      ! global_to_local_uv (module scope in sfincs_data_device, deallocated
      ! by device_finalize).
      !
      if (allocated(cell_part)) deallocate(cell_part)
      !
   end subroutine partition_and_localize
   !
   subroutine allocate_structure_device_shadows()
      !
      ! Pre-allocate the four structure-catalog device shadows so that the
      ! per-step Copy-IN inside compute_fluxes_over_structures resolves to a
      ! plain cudaMemcpy against correctly-sized device storage instead of
      ! triggering CUDA Fortran's lazy auto-realloc-on-assignment path on
      ! first call. Called from sfincs_lib immediately after read_structures()
      ! has populated the host counterparts (which is after
      ! partition_and_localize, so this site is the earliest point at which
      ! the host arrays carry the right shape).
      !
      ! structure_uv_index is nstruc-sized; entries are global edge indices.
      ! Renumber through global_to_local_uv so kernels can index
      ! structure_uv_index(i) directly into the local-indexed device shadows
      ! of kcuv / uv / q. Other three are data values, not indices, so they
      ! keep verbatim mold/copy semantics.
      !
      if (allocated(structure_uv_index_h)) then
         allocate(structure_uv_index, mold=structure_uv_index_h)
         call renumber_to_local_edge(structure_uv_index, structure_uv_index_h)
      end if
      if (allocated(structure_parameters_h)) then; allocate(structure_parameters, mold=structure_parameters_h); structure_parameters = structure_parameters_h; end if
      if (allocated(structure_type_h))       then; allocate(structure_type,       mold=structure_type_h);       structure_type       = structure_type_h;       end if
      if (allocated(structure_length_h))     then; allocate(structure_length,     mold=structure_length_h);     structure_length     = structure_length_h;     end if
      !
   end subroutine allocate_structure_device_shadows
   !
   subroutine refresh_kcuv_device_shadow()
      !
      ! Re-upload kcuv to device after read_structures() has mutated the host
      ! counterpart. read_thin_dams sets kcuv_h(ip) = 0 for thin-dam UV points
      ! and read_structure_file sets kcuv_h(ip) = 3 for weir UV points; both
      ! run after copyin_phase4_degenerate has already copied the
      ! pre-structures kcuv to device, so without this refresh the device
      ! shadow stays stale. k_compute_fluxes (sfincs_momentum_gpu.cuf:269)
      ! gates on kcuv == 1/6 to early-return on weirs and thindams, and
      ! k_update_boundary_fluxes (sfincs_boundaries_gpu.cuf:579) special-cases
      ! kcuv == 3; with stale device kcuv, weir/thindam UVs leak into the
      ! momentum kernel and their min_dt candidates contaminate the global
      ! atomic-min, drifting GPU dt away from CPU dt every step.
      !
      if (allocated(kcuv_h) .and. allocated(kcuv)) then
         kcuv = kcuv_h(local_to_global_uv(1:npuv_local + halo_edge_count + ncuv_h + 1))
      end if
      !
   end subroutine refresh_kcuv_device_shadow
   !
   subroutine allocate_discharges_device_shadows()
      !
      ! Pre-allocate the four discharges/drainage catalog device shadows so
      ! that k_source_interp and k_drainage (sfincs_discharges_gpu.cuf) read
      ! device storage that is correctly sized and bit-equal to its host
      ! counterpart. Called from sfincs_lib immediately after read_discharges()
      ! has populated the host counterparts (which is after
      ! partition_and_localize, so this site is the earliest point at which
      ! the host arrays carry the right shape).
      !
      ! nmindsrc is nsrcdrn-sized; entries are global SFINCS cell indices.
      ! Renumber through global_to_local. qtsrc / drainage_type /
      ! drainage_params carry data values (not indices) so they keep
      ! verbatim mold/copy semantics.
      !
      if (allocated(nmindsrc_h)) then
         allocate(nmindsrc, mold=nmindsrc_h)
         call renumber_to_local_cell(nmindsrc, nmindsrc_h)
      end if
      if (allocated(qtsrc_h))           then; allocate(qtsrc,           mold=qtsrc_h);           qtsrc           = qtsrc_h;           end if
      if (allocated(drainage_type_h))   then; allocate(drainage_type,   mold=drainage_type_h);   drainage_type   = drainage_type_h;   end if
      if (allocated(drainage_params_h)) then; allocate(drainage_params, mold=drainage_params_h); drainage_params = drainage_params_h; end if
      !
   end subroutine allocate_discharges_device_shadows
   !
   subroutine allocate_wavemaker_device_shadows()
      !
      ! Pre-allocate the fifteen wavemaker per-uv catalog device shadows so
      ! that k_wavemaker_fluxes (sfincs_wavemaker_gpu.cuf) reads device
      ! storage that is correctly sized and bit-equal to its host counterpart.
      ! Called from sfincs_lib immediately after initialize_wavemakers() has
      ! populated the host arrays (which is after partition_and_localize, so
      ! this site is the earliest point at which the host arrays carry the
      ! right shape).
      !
      ! Wavemaker arrays sized by wavemaker count (iwm), wavemaker-cell count
      ! (nok), and wavemaker forcing-point count (wavemaker_nr_uv_points)
      ! stay full-size; only entries that hold global SFINCS cell or edge
      ! indices are renumbered. The cell-rank z_index_wavemaker (np-sized)
      ! shrinks; its entries are wavemaker positions (1..nok), not cell or
      ! edge indices, so no entry renumber is required.
      !
      if (allocated(wavemaker_index_uv_h)) then
         allocate(wavemaker_index_uv, mold=wavemaker_index_uv_h)
         call renumber_to_local_edge(wavemaker_index_uv, wavemaker_index_uv_h)
      end if
      if (allocated(wavemaker_index_nmi_h)) then
         allocate(wavemaker_index_nmi, mold=wavemaker_index_nmi_h)
         call renumber_to_local_cell(wavemaker_index_nmi, wavemaker_index_nmi_h)
      end if
      if (allocated(wavemaker_index_nmb_h)) then
         allocate(wavemaker_index_nmb, mold=wavemaker_index_nmb_h)
         call renumber_to_local_cell(wavemaker_index_nmb, wavemaker_index_nmb_h)
      end if
      if (allocated(wavemaker_index_wmfp1_h)) then; allocate(wavemaker_index_wmfp1, mold=wavemaker_index_wmfp1_h); wavemaker_index_wmfp1 = wavemaker_index_wmfp1_h; end if
      if (allocated(wavemaker_index_wmfp2_h)) then; allocate(wavemaker_index_wmfp2, mold=wavemaker_index_wmfp2_h); wavemaker_index_wmfp2 = wavemaker_index_wmfp2_h; end if
      if (allocated(wavemaker_fac_wmfp_h))    then; allocate(wavemaker_fac_wmfp,    mold=wavemaker_fac_wmfp_h);    wavemaker_fac_wmfp    = wavemaker_fac_wmfp_h;    end if
      if (allocated(wavemaker_idir_h))        then; allocate(wavemaker_idir,        mold=wavemaker_idir_h);        wavemaker_idir        = wavemaker_idir_h;        end if
      if (allocated(wavemaker_angfac_h))      then; allocate(wavemaker_angfac,      mold=wavemaker_angfac_h);      wavemaker_angfac      = wavemaker_angfac_h;      end if
      if (allocated(wavemaker_uvmean_h))      then; allocate(wavemaker_uvmean,      mold=wavemaker_uvmean_h);      wavemaker_uvmean      = wavemaker_uvmean_h;      end if
      if (allocated(wavemaker_uvtrend_h))     then; allocate(wavemaker_uvtrend,     mold=wavemaker_uvtrend_h);     wavemaker_uvtrend     = wavemaker_uvtrend_h;     end if
      if (allocated(wavemaker_nmd_h))         then; allocate(wavemaker_nmd,         mold=wavemaker_nmd_h);         wavemaker_nmd         = wavemaker_nmd_h;         end if
      if (allocated(wavemaker_nmu_h))         then; allocate(wavemaker_nmu,         mold=wavemaker_nmu_h);         wavemaker_nmu         = wavemaker_nmu_h;         end if
      if (allocated(wavemaker_ndm_h))         then; allocate(wavemaker_ndm,         mold=wavemaker_ndm_h);         wavemaker_ndm         = wavemaker_ndm_h;         end if
      if (allocated(wavemaker_num_h))         then; allocate(wavemaker_num,         mold=wavemaker_num_h);         wavemaker_num         = wavemaker_num_h;         end if
      !
      ! z_index_wavemaker is cell-rank (np-sized) — shrink to npn_local +
      ! halo_cell_count. Entries are wavemaker positions (no renumber).
      !
      if (allocated(z_index_wavemaker_h)) then
         allocate(z_index_wavemaker(npn_local + halo_cell_count))
         call gather_cell_int4(z_index_wavemaker, z_index_wavemaker_h)
      end if
      !
      ! Re-upload kcs and kcuv to device after initialize_wavemakers() has
      ! mutated the host counterparts. initialize_wavemakers (sfincs_wavemaker_io.f90)
      ! sets kcs_h(ip) = 4 for wavemaker z-points (line 450) and
      ! kcuv_h(ip) = 4 for wavemaker uv-faces (line 1136); both run after
      ! copyin_phase4_degenerate has already copied the pre-wavemaker kcs /
      ! kcuv to device, so without this refresh the device shadows stay stale.
      ! k_compute_continuity (sfincs_continuity_gpu.cuf:519) branches on
      ! kcs(nm) == 4 to apply the wavemaker discharge term, and
      ! k_compute_fluxes (sfincs_momentum_gpu.cuf:269) gates on
      ! kcuv(ip) == 1 .or. kcuv(ip) == 6; with stale device kcs/kcuv the
      ! GPU never sees wavemaker cells / faces and zsmax diverges from CPU
      ! by ~50% on a wavemaker case.
      !
      if (allocated(kcs_h))  kcs  = kcs_h(local_to_global   (1:npn_local  + halo_cell_count))
      if (allocated(kcuv_h)) kcuv = kcuv_h(local_to_global_uv(1:npuv_local + halo_edge_count + ncuv_h + 1))
      !
   end subroutine allocate_wavemaker_device_shadows
   !
   subroutine copyin_phase4_degenerate()
      !
      ! Allocate device shadows and copyin from host counterparts. Cell-rank
      ! shadows shrink to npn_local + halo_cell_count and are gathered
      ! through local_to_global; edge-rank shadows shrink to
      ! npuv_local + halo_edge_count and are gathered through
      ! local_to_global_uv. Connectivity arrays whose entries are global
      ! cell or edge indices are renumbered through global_to_local /
      ! global_to_local_uv before being shipped to device. Sentinel /
      ! out-of-range entries (<= 0 or > npn_h / > npuv_h) pass through
      ! unchanged. Other-sized shadows (boundary-, source-, struct-,
      ! wavemaker-, quadtree-level-, fixed-sized) keep their host shape via
      ! the legacy mold/copy pattern. For mpi_size == 1 the maps degenerate
      ! to identity and halo_*_count == 0, so this routine reproduces the
      ! pre-shrink single-rank state bit-identically.
      !
      ! Helpers below (gather_*_*) factor the four most common patterns to
      ! keep the body short. Connectivity renumbering uses inline blocks.
      !
      integer :: nc, ne, nw
      !
      nc = npn_local  + halo_cell_count
      ne = npuv_local + halo_edge_count
      nw = ne + ncuv_h + 1   ! wide edge size: q/q0/uv/uv0/kcuv mirror npuv_h+ncuv_h+1
      !
      ! ---- Cell-rank shadows (no renumber) ---------------------------------
      ! Shrink to nc; gather from host through local_to_global. The trailing
      ! halo entries mirror neighbor-rank cells; halo_exchange_zs refreshes
      ! the zs slice every step at runtime, but Phase 4 still seeds the
      ! halo region from the local rank's host alias because every rank
      ! reads the full input file before partition_and_localize runs (so
      ! kcs_h, zb_h, ... are bit-identical across ranks at this point).
      !
      if (allocated(kcs_h)) then
         allocate(kcs(nc))
         call gather_cell_int1(kcs, kcs_h)
      end if
      if (allocated(z_flags_iref_h)) then
         allocate(z_flags_iref(nc))
         call gather_cell_int1(z_flags_iref, z_flags_iref_h)
      end if
      if (allocated(zs_h)) then
         allocate(zs(nc))
         call gather_cell_real8(zs, zs_h)
      end if
      if (allocated(zs0_h)) then
         allocate(zs0(nc))
         call gather_cell_real4(zs0, zs0_h)
      end if
      if (allocated(zsderv_h)) then
         allocate(zsderv(nc))
         call gather_cell_real4(zsderv, zsderv_h)
      end if
      if (allocated(zb_h)) then
         allocate(zb(nc))
         call gather_cell_real4(zb, zb_h)
      end if
      if (allocated(zsmax_h)) then
         allocate(zsmax(nc))
         call gather_cell_real4(zsmax, zsmax_h)
      end if
      if (allocated(maxzsm_h)) then
         allocate(maxzsm(nc))
         call gather_cell_real4(maxzsm, maxzsm_h)
      end if
      if (allocated(qmax_h)) then
         allocate(qmax(nc))
         call gather_cell_real4(qmax, qmax_h)
      end if
      if (allocated(vmax_h)) then
         allocate(vmax(nc))
         call gather_cell_real4(vmax, vmax_h)
      end if
      if (allocated(twet_h)) then
         allocate(twet(nc))
         call gather_cell_real4(twet, twet_h)
      end if
      if (allocated(zsm_h)) then
         allocate(zsm(nc))
         call gather_cell_real4(zsm, zsm_h)
      end if
      if (allocated(z_volume_h)) then
         allocate(z_volume(nc))
         call gather_cell_real8(z_volume, z_volume_h)
      end if
      if (allocated(cell_area_m2_h)) then
         allocate(cell_area_m2(nc))
         call gather_cell_real4(cell_area_m2, cell_area_m2_h)
      end if
      if (allocated(dxm_h)) then
         allocate(dxm(nc))
         call gather_cell_real4(dxm, dxm_h)
      end if
      if (allocated(fcorio2d_h)) then
         allocate(fcorio2d(nc))
         call gather_cell_real4(fcorio2d, fcorio2d_h)
      end if
      if (allocated(storage_volume_h)) then
         allocate(storage_volume(nc))
         call gather_cell_real4(storage_volume, storage_volume_h)
      end if
      if (allocated(windu_h)) then
         allocate(windu(nc))
         call gather_cell_real4(windu, windu_h)
      end if
      if (allocated(windv_h)) then
         allocate(windv(nc))
         call gather_cell_real4(windv, windv_h)
      end if
      if (allocated(windu0_h)) then
         allocate(windu0(nc))
         call gather_cell_real4(windu0, windu0_h)
      end if
      if (allocated(windv0_h)) then
         allocate(windv0(nc))
         call gather_cell_real4(windv0, windv0_h)
      end if
      if (allocated(windu1_h)) then
         allocate(windu1(nc))
         call gather_cell_real4(windu1, windu1_h)
      end if
      if (allocated(windv1_h)) then
         allocate(windv1(nc))
         call gather_cell_real4(windv1, windv1_h)
      end if
      if (allocated(windmax_h)) then
         allocate(windmax(nc))
         call gather_cell_real4(windmax, windmax_h)
      end if
      if (allocated(patm_h)) then
         allocate(patm(nc))
         call gather_cell_real4(patm, patm_h)
      end if
      if (allocated(patm0_h)) then
         allocate(patm0(nc))
         call gather_cell_real4(patm0, patm0_h)
      end if
      if (allocated(patm1_h)) then
         allocate(patm1(nc))
         call gather_cell_real4(patm1, patm1_h)
      end if
      if (allocated(patmb_h)) then
         allocate(patmb(nc))
         call gather_cell_real4(patmb, patmb_h)
      end if
      if (allocated(prcp_h)) then
         allocate(prcp(nc))
         call gather_cell_real4(prcp, prcp_h)
      end if
      if (allocated(prcp0_h)) then
         allocate(prcp0(nc))
         call gather_cell_real4(prcp0, prcp0_h)
      end if
      if (allocated(prcp1_h)) then
         allocate(prcp1(nc))
         call gather_cell_real4(prcp1, prcp1_h)
      end if
      if (allocated(cumprcp_h)) then
         allocate(cumprcp(nc))
         call gather_cell_real4(cumprcp, cumprcp_h)
      end if
      if (allocated(netprcp_h)) then
         allocate(netprcp(nc))
         call gather_cell_real4(netprcp, netprcp_h)
      end if
      if (allocated(qext_h)) then
         allocate(qext(nc))
         call gather_cell_real4(qext, qext_h)
      end if
      if (allocated(tauwu_h)) then
         allocate(tauwu(nc))
         call gather_cell_real4(tauwu, tauwu_h)
      end if
      if (allocated(tauwv_h)) then
         allocate(tauwv(nc))
         call gather_cell_real4(tauwv, tauwv_h)
      end if
      if (allocated(tauwu0_h)) then
         allocate(tauwu0(nc))
         call gather_cell_real4(tauwu0, tauwu0_h)
      end if
      if (allocated(tauwv0_h)) then
         allocate(tauwv0(nc))
         call gather_cell_real4(tauwv0, tauwv0_h)
      end if
      if (allocated(tauwu1_h)) then
         allocate(tauwu1(nc))
         call gather_cell_real4(tauwu1, tauwu1_h)
      end if
      if (allocated(tauwv1_h)) then
         allocate(tauwv1(nc))
         call gather_cell_real4(tauwv1, tauwv1_h)
      end if
      if (allocated(qinffield_h)) then
         allocate(qinffield(nc))
         call gather_cell_real4(qinffield, qinffield_h)
      end if
      if (allocated(qinfmap_h)) then
         allocate(qinfmap(nc))
         call gather_cell_real4(qinfmap, qinfmap_h)
      end if
      if (allocated(cuminf_h)) then
         allocate(cuminf(nc))
         call gather_cell_real4(cuminf, cuminf_h)
      end if
      if (allocated(scs_rain_h)) then
         allocate(scs_rain(nc))
         call gather_cell_int1(scs_rain, scs_rain_h)
      end if
      if (allocated(scs_Se_h)) then
         allocate(scs_Se(nc))
         call gather_cell_real4(scs_Se, scs_Se_h)
      end if
      if (allocated(scs_P1_h)) then
         allocate(scs_P1(nc))
         call gather_cell_real4(scs_P1, scs_P1_h)
      end if
      if (allocated(scs_F1_h)) then
         allocate(scs_F1(nc))
         call gather_cell_real4(scs_F1, scs_F1_h)
      end if
      if (allocated(scs_S1_h)) then
         allocate(scs_S1(nc))
         call gather_cell_real4(scs_S1, scs_S1_h)
      end if
      if (allocated(rain_T1_h)) then
         allocate(rain_T1(nc))
         call gather_cell_real4(rain_T1, rain_T1_h)
      end if
      if (allocated(ksfield_h)) then
         allocate(ksfield(nc))
         call gather_cell_real4(ksfield, ksfield_h)
      end if
      if (allocated(GA_head_h)) then
         allocate(GA_head(nc))
         call gather_cell_real4(GA_head, GA_head_h)
      end if
      if (allocated(GA_sigma_h)) then
         allocate(GA_sigma(nc))
         call gather_cell_real4(GA_sigma, GA_sigma_h)
      end if
      if (allocated(GA_sigma_max_h)) then
         allocate(GA_sigma_max(nc))
         call gather_cell_real4(GA_sigma_max, GA_sigma_max_h)
      end if
      if (allocated(GA_F_h)) then
         allocate(GA_F(nc))
         call gather_cell_real4(GA_F, GA_F_h)
      end if
      if (allocated(GA_Lu_h)) then
         allocate(GA_Lu(nc))
         call gather_cell_real4(GA_Lu, GA_Lu_h)
      end if
      if (allocated(inf_kr_h)) then
         allocate(inf_kr(nc))
         call gather_cell_real4(inf_kr, inf_kr_h)
      end if
      if (allocated(horton_kd_h)) then
         allocate(horton_kd(nc))
         call gather_cell_real4(horton_kd, horton_kd_h)
      end if
      if (allocated(horton_fc_h)) then
         allocate(horton_fc(nc))
         call gather_cell_real4(horton_fc, horton_fc_h)
      end if
      if (allocated(horton_f0_h)) then
         allocate(horton_f0(nc))
         call gather_cell_real4(horton_f0, horton_f0_h)
      end if
      if (allocated(z_xz_h)) then
         allocate(z_xz(nc))
         call gather_cell_real4(z_xz, z_xz_h)
      end if
      if (allocated(z_yz_h)) then
         allocate(z_yz(nc))
         call gather_cell_real4(z_yz, z_yz_h)
      end if
      ! timestep_analysis_* are edge-rank (sized npuv on host); see
      ! sfincs_timestep_analysis.f90:12-15.
      if (allocated(hm0_h)) then
         allocate(hm0(nc))
         call gather_cell_real4(hm0, hm0_h)
      end if
      if (allocated(hm0_ig_h)) then
         allocate(hm0_ig(nc))
         call gather_cell_real4(hm0_ig, hm0_ig_h)
      end if
      !
      ! Cell-rank subgrid Z scalars (1D over cells)
      !
      if (allocated(subgrid_z_zmin_h)) then
         allocate(subgrid_z_zmin(nc))
         call gather_cell_real4(subgrid_z_zmin, subgrid_z_zmin_h)
      end if
      if (allocated(subgrid_z_zmax_h)) then
         allocate(subgrid_z_zmax(nc))
         call gather_cell_real4(subgrid_z_zmax, subgrid_z_zmax_h)
      end if
      if (allocated(subgrid_z_volmax_h)) then
         allocate(subgrid_z_volmax(nc))
         call gather_cell_real4(subgrid_z_volmax, subgrid_z_volmax_h)
      end if
      !
      ! Cell-rank subgrid Z table (subgrid_nlevels, np). Trailing dim is
      ! cell-rank: shrink only that dim and gather columns through
      ! local_to_global.
      !
      if (allocated(subgrid_z_dep_h)) then
         allocate(subgrid_z_dep(size(subgrid_z_dep_h, 1), nc))
         subgrid_z_dep = subgrid_z_dep_h(:, local_to_global(1:nc))
      end if
      !
      ! ---- Edge-rank shadows (no renumber) ---------------------------------
      !
      if (allocated(kfuv_h)) then
         allocate(kfuv(ne))
         call gather_edge_int1(kfuv, kfuv_h)
      end if
      if (allocated(kcuv_h)) then
         allocate(kcuv(nw))
         call gather_edge_wide_int1(kcuv, kcuv_h)
      end if
      if (allocated(q_h)) then
         allocate(q(nw))
         call gather_edge_wide_real4(q, q_h)
      end if
      if (allocated(q0_h)) then
         allocate(q0(nw))
         call gather_edge_wide_real4(q0, q0_h)
      end if
      if (allocated(uv_h)) then
         allocate(uv(nw))
         call gather_edge_wide_real4(uv, uv_h)
      end if
      if (allocated(uv0_h)) then
         allocate(uv0(nw))
         call gather_edge_wide_real4(uv0, uv0_h)
      end if
      if (allocated(zbuv_h)) then
         allocate(zbuv(ne))
         call gather_edge_real4(zbuv, zbuv_h)
      end if
      if (allocated(zbuvmx_h)) then
         allocate(zbuvmx(ne))
         call gather_edge_real4(zbuvmx, zbuvmx_h)
      end if
      if (allocated(uv_flags_iref_h)) then
         allocate(uv_flags_iref(ne))
         call gather_edge_int1(uv_flags_iref, uv_flags_iref_h)
      end if
      if (allocated(uv_flags_type_h)) then
         allocate(uv_flags_type(ne))
         call gather_edge_int1(uv_flags_type, uv_flags_type_h)
      end if
      if (allocated(uv_flags_dir_h)) then
         allocate(uv_flags_dir(ne))
         call gather_edge_int1(uv_flags_dir, uv_flags_dir_h)
      end if
      if (allocated(mask_adv_h)) then
         allocate(mask_adv(ne))
         call gather_edge_int1(mask_adv, mask_adv_h)
      end if
      if (allocated(gn2uv_h)) then
         allocate(gn2uv(ne))
         call gather_edge_real4(gn2uv, gn2uv_h)
      end if
      if (allocated(dxminv_h)) then
         allocate(dxminv(ne))
         call gather_edge_real4(dxminv, dxminv_h)
      end if
      if (allocated(dxm2inv_h)) then
         allocate(dxm2inv(ne))
         call gather_edge_real4(dxm2inv, dxm2inv_h)
      end if
      if (allocated(gnapp2_h)) then
         allocate(gnapp2(ne))
         call gather_edge_real4(gnapp2, gnapp2_h)
      end if
      if (allocated(fwuv_h)) then
         allocate(fwuv(ne))
         call gather_edge_real4(fwuv, fwuv_h)
      end if
      !
      if (allocated(timestep_analysis_required_timestep_h)) then
         allocate(timestep_analysis_required_timestep(ne))
         call gather_edge_real4(timestep_analysis_required_timestep, timestep_analysis_required_timestep_h)
      end if
      if (allocated(timestep_analysis_average_required_timestep_h)) then
         allocate(timestep_analysis_average_required_timestep(ne))
         call gather_edge_real4(timestep_analysis_average_required_timestep, timestep_analysis_average_required_timestep_h)
      end if
      ! gather_edge_int4 helpers don't exist; use a 2-line manual gather.
      if (allocated(timestep_analysis_times_wet_h)) then
         allocate(timestep_analysis_times_wet(npuv_local + halo_edge_count))
         timestep_analysis_times_wet = timestep_analysis_times_wet_h(local_to_global_uv(1:npuv_local + halo_edge_count))
      end if
      if (allocated(timestep_analysis_times_limiting_h)) then
         allocate(timestep_analysis_times_limiting(npuv_local + halo_edge_count))
         timestep_analysis_times_limiting = timestep_analysis_times_limiting_h(local_to_global_uv(1:npuv_local + halo_edge_count))
      end if
      !
      ! Edge-rank subgrid UV scalars (1D over edges)
      !
      if (allocated(subgrid_uv_zmin_h)) then
         allocate(subgrid_uv_zmin(ne))
         call gather_edge_real4(subgrid_uv_zmin, subgrid_uv_zmin_h)
      end if
      if (allocated(subgrid_uv_zmax_h)) then
         allocate(subgrid_uv_zmax(ne))
         call gather_edge_real4(subgrid_uv_zmax, subgrid_uv_zmax_h)
      end if
      if (allocated(subgrid_uv_havg_zmax_h)) then
         allocate(subgrid_uv_havg_zmax(ne))
         call gather_edge_real4(subgrid_uv_havg_zmax, subgrid_uv_havg_zmax_h)
      end if
      if (allocated(subgrid_uv_nrep_zmax_h)) then
         allocate(subgrid_uv_nrep_zmax(ne))
         call gather_edge_real4(subgrid_uv_nrep_zmax, subgrid_uv_nrep_zmax_h)
      end if
      if (allocated(subgrid_uv_fnfit_h)) then
         allocate(subgrid_uv_fnfit(ne))
         call gather_edge_real4(subgrid_uv_fnfit, subgrid_uv_fnfit_h)
      end if
      if (allocated(subgrid_uv_navg_w_h)) then
         allocate(subgrid_uv_navg_w(ne))
         call gather_edge_real4(subgrid_uv_navg_w, subgrid_uv_navg_w_h)
      end if
      !
      ! Edge-rank subgrid UV tables (subgrid_nlevels, npuv). Trailing dim
      ! is edge-rank.
      !
      if (allocated(subgrid_uv_havg_h)) then
         allocate(subgrid_uv_havg(size(subgrid_uv_havg_h, 1), ne))
         subgrid_uv_havg = subgrid_uv_havg_h(:, local_to_global_uv(1:ne))
      end if
      if (allocated(subgrid_uv_nrep_h)) then
         allocate(subgrid_uv_nrep(size(subgrid_uv_nrep_h, 1), ne))
         subgrid_uv_nrep = subgrid_uv_nrep_h(:, local_to_global_uv(1:ne))
      end if
      if (allocated(subgrid_uv_pwet_h)) then
         allocate(subgrid_uv_pwet(size(subgrid_uv_pwet_h, 1), ne))
         subgrid_uv_pwet = subgrid_uv_pwet_h(:, local_to_global_uv(1:ne))
      end if
      !
      ! ---- Cell-rank connectivity (entries are EDGE indices) ---------------
      ! Each entry is renumbered through global_to_local_uv. Sentinel /
      ! out-of-range entries pass through unchanged.
      !
      if (allocated(z_index_uv_md_h)) then
         allocate(z_index_uv_md(nc))
         call gather_cell_int4_renumber_edge(z_index_uv_md, z_index_uv_md_h)
      end if
      if (allocated(z_index_uv_nd_h)) then
         allocate(z_index_uv_nd(nc))
         call gather_cell_int4_renumber_edge(z_index_uv_nd, z_index_uv_nd_h)
      end if
      if (allocated(z_index_uv_mu_h)) then
         allocate(z_index_uv_mu(nc))
         call gather_cell_int4_renumber_edge(z_index_uv_mu, z_index_uv_mu_h)
      end if
      if (allocated(z_index_uv_nu_h)) then
         allocate(z_index_uv_nu(nc))
         call gather_cell_int4_renumber_edge(z_index_uv_nu, z_index_uv_nu_h)
      end if
      !
      ! ---- Edge-rank connectivity (entries are CELL indices) ---------------
      !
      if (allocated(uv_index_z_nm_h)) then
         allocate(uv_index_z_nm(ne))
         call gather_edge_int4_renumber_cell(uv_index_z_nm, uv_index_z_nm_h)
      end if
      if (allocated(uv_index_z_nmu_h)) then
         allocate(uv_index_z_nmu(ne))
         call gather_edge_int4_renumber_cell(uv_index_z_nmu, uv_index_z_nmu_h)
      end if
      !
      ! ---- Edge-rank connectivity (entries are EDGE indices) ---------------
      !
      if (allocated(uv_index_u_nmd_h)) then
         allocate(uv_index_u_nmd(ne))
         call gather_edge_int4_renumber_edge(uv_index_u_nmd, uv_index_u_nmd_h)
      end if
      if (allocated(uv_index_u_nmu_h)) then
         allocate(uv_index_u_nmu(ne))
         call gather_edge_int4_renumber_edge(uv_index_u_nmu, uv_index_u_nmu_h)
      end if
      if (allocated(uv_index_u_ndm_h)) then
         allocate(uv_index_u_ndm(ne))
         call gather_edge_int4_renumber_edge(uv_index_u_ndm, uv_index_u_ndm_h)
      end if
      if (allocated(uv_index_u_num_h)) then
         allocate(uv_index_u_num(ne))
         call gather_edge_int4_renumber_edge(uv_index_u_num, uv_index_u_num_h)
      end if
      if (allocated(uv_index_v_ndm_h)) then
         allocate(uv_index_v_ndm(ne))
         call gather_edge_int4_renumber_edge(uv_index_v_ndm, uv_index_v_ndm_h)
      end if
      if (allocated(uv_index_v_ndmu_h)) then
         allocate(uv_index_v_ndmu(ne))
         call gather_edge_int4_renumber_edge(uv_index_v_ndmu, uv_index_v_ndmu_h)
      end if
      if (allocated(uv_index_v_nm_h)) then
         allocate(uv_index_v_nm(ne))
         call gather_edge_int4_renumber_edge(uv_index_v_nm, uv_index_v_nm_h)
      end if
      if (allocated(uv_index_v_nmu_h)) then
         allocate(uv_index_v_nmu(ne))
         call gather_edge_int4_renumber_edge(uv_index_v_nmu, uv_index_v_nmu_h)
      end if
      !
      ! cuv_index_uv* are sized ncuv (combined-uv-rank), NOT npuv. The
      ! quadtree's combined-UV table is globally constant: every rank
      ! reads the same ncuv-sized table. Keep host shape on device,
      ! renumber the entries (global edge indices) through
      ! global_to_local_uv so kernel-side q(cuv_index_uv*(icuv)) reads
      ! resolve to the local-indexed edge shadows.
      !
      if (allocated(cuv_index_uv_h)) then
         allocate(cuv_index_uv, mold=cuv_index_uv_h)
         call renumber_to_local_edge(cuv_index_uv, cuv_index_uv_h)
      end if
      if (allocated(cuv_index_uv1_h)) then
         allocate(cuv_index_uv1, mold=cuv_index_uv1_h)
         call renumber_to_local_edge(cuv_index_uv1, cuv_index_uv1_h)
      end if
      if (allocated(cuv_index_uv2_h)) then
         allocate(cuv_index_uv2, mold=cuv_index_uv2_h)
         call renumber_to_local_edge(cuv_index_uv2, cuv_index_uv2_h)
      end if
      !
      ! ---- Boundary-sized arrays (size ngbnd or nkcuv2) --------------------
      ! These keep host shape; entries (where they index cells or edges)
      ! are renumbered through the appropriate map. zsb / zsb0 / ibuvdir /
      ! uvmean carry data values, not indices, so they keep verbatim
      ! mold/copy semantics. ibkcuv2 likewise stays verbatim: its entries
      ! are grid-boundary indices (1..ngbnd) used as zsb(ibkcuv2(ib)),
      ! not edge indices, so global_to_local_uv would corrupt them.
      !
      if (allocated(nmindbnd_h)) then
         allocate(nmindbnd, mold=nmindbnd_h)
         call renumber_to_local_cell(nmindbnd, nmindbnd_h)
      end if
      if (allocated(zsb_h))      then; allocate(zsb,      mold=zsb_h);      zsb      = zsb_h;      end if
      if (allocated(zsb0_h))     then; allocate(zsb0,     mold=zsb0_h);     zsb0     = zsb0_h;     end if
      if (allocated(ibuvdir_h))  then; allocate(ibuvdir,  mold=ibuvdir_h);  ibuvdir  = ibuvdir_h;  end if
      if (allocated(uvmean_h))   then; allocate(uvmean,   mold=uvmean_h);   uvmean   = uvmean_h;   end if
      if (allocated(index_kcuv2_h)) then
         allocate(index_kcuv2, mold=index_kcuv2_h)
         call renumber_to_local_edge(index_kcuv2, index_kcuv2_h)
      end if
      if (allocated(nmikcuv2_h)) then
         allocate(nmikcuv2, mold=nmikcuv2_h)
         call renumber_to_local_cell(nmikcuv2, nmikcuv2_h)
      end if
      if (allocated(nmbkcuv2_h)) then
         allocate(nmbkcuv2, mold=nmbkcuv2_h)
         call renumber_to_local_cell(nmbkcuv2, nmbkcuv2_h)
      end if
      if (allocated(ibkcuv2_h))  then; allocate(ibkcuv2,  mold=ibkcuv2_h);  ibkcuv2  = ibkcuv2_h;  end if
      !
      ! ---- Quadtree-level-sized arrays (size nref) -------------------------
      ! Verbatim mold/copy: kernels index these by z_flags_iref / uv_flags_iref
      ! values, not by cell/edge indices.
      !
      if (allocated(dxrinv_h))   then; allocate(dxrinv,   mold=dxrinv_h);   dxrinv   = dxrinv_h;   end if
      if (allocated(dyrinv_h))   then; allocate(dyrinv,   mold=dyrinv_h);   dyrinv   = dyrinv_h;   end if
      if (allocated(dxr2inv_h))  then; allocate(dxr2inv,  mold=dxr2inv_h);  dxr2inv  = dxr2inv_h;  end if
      if (allocated(dyr2inv_h))  then; allocate(dyr2inv,  mold=dyr2inv_h);  dyr2inv  = dyr2inv_h;  end if
      if (allocated(dxrinvc_h))  then; allocate(dxrinvc,  mold=dxrinvc_h);  dxrinvc  = dxrinvc_h;  end if
      if (allocated(dyrinvc_h))  then; allocate(dyrinvc,  mold=dyrinvc_h);  dyrinvc  = dyrinvc_h;  end if
      if (allocated(dxrm_h))     then; allocate(dxrm,     mold=dxrm_h);     dxrm     = dxrm_h;     end if
      if (allocated(dyrm_h))     then; allocate(dyrm,     mold=dyrm_h);     dyrm     = dyrm_h;     end if
      if (allocated(cell_area_h))then; allocate(cell_area,mold=cell_area_h);cell_area= cell_area_h;end if
      if (allocated(nuvisc_h))   then; allocate(nuvisc,   mold=nuvisc_h);   nuvisc   = nuvisc_h;   end if
      !
      ! ---- Fixed-shape arrays (x73 etc.) -----------------------------------
      !
      if (allocated(x73_h)) then; allocate(x73, mold=x73_h); x73 = x73_h; end if
      !
      ! ---- Discharges/drainage/wavemaker/structure deferred ---------------
      ! Their host counterparts aren't populated until read_discharges /
      ! initialize_wavemakers / read_structures runs (post partition); the
      ! corresponding device shadows are allocated from
      ! allocate_discharges_device_shadows / allocate_wavemaker_device_shadows /
      ! allocate_structure_device_shadows.
      !
      ! ===== gpu-meteo-spatial-interp supplemental ====
      !
      ! cdval and cdlgx are non-allocatable fixed-size on both host and
      ! device sides; copy them unconditionally. spw_/amuv_/amp_/ampr_
      ! tables index by source space (spiderweb segment, raster cell), not
      ! by SFINCS cell/edge, so they keep mold/copy semantics. z0land /
      ! z0land_table are land-use tables, similarly source-indexed.
      !
      cdval = cdval_h
      cdlgx = cdlgx_h
      if (allocated(spw_times_h))    then; allocate(spw_times,    mold=spw_times_h);    spw_times    = spw_times_h;    end if
      if (allocated(spw_xe_h))       then; allocate(spw_xe,       mold=spw_xe_h);       spw_xe       = spw_xe_h;       end if
      if (allocated(spw_ye_h))       then; allocate(spw_ye,       mold=spw_ye_h);       spw_ye       = spw_ye_h;       end if
      if (allocated(spw_wu_h))       then; allocate(spw_wu,       mold=spw_wu_h);       spw_wu       = spw_wu_h;       end if
      if (allocated(spw_wv_h))       then; allocate(spw_wv,       mold=spw_wv_h);       spw_wv       = spw_wv_h;       end if
      if (allocated(spw_pabs_h))     then; allocate(spw_pabs,     mold=spw_pabs_h);     spw_pabs     = spw_pabs_h;     end if
      if (allocated(spw_prcp_h))     then; allocate(spw_prcp,     mold=spw_prcp_h);     spw_prcp     = spw_prcp_h;     end if
      if (allocated(spw_wu01_h))     then; allocate(spw_wu01,     mold=spw_wu01_h);     spw_wu01     = spw_wu01_h;     end if
      if (allocated(spw_wv01_h))     then; allocate(spw_wv01,     mold=spw_wv01_h);     spw_wv01     = spw_wv01_h;     end if
      if (allocated(spw_pabs01_h))   then; allocate(spw_pabs01,   mold=spw_pabs01_h);   spw_pabs01   = spw_pabs01_h;   end if
      if (allocated(spw_prcp01_h))   then; allocate(spw_prcp01,   mold=spw_prcp01_h);   spw_prcp01   = spw_prcp01_h;   end if
      if (allocated(amuv_times_h))   then; allocate(amuv_times,   mold=amuv_times_h);   amuv_times   = amuv_times_h;   end if
      if (allocated(amuv_wu_h))      then; allocate(amuv_wu,      mold=amuv_wu_h);      amuv_wu      = amuv_wu_h;      end if
      if (allocated(amuv_wv_h))      then; allocate(amuv_wv,      mold=amuv_wv_h);      amuv_wv      = amuv_wv_h;      end if
      if (allocated(amuv_wu01_h))    then; allocate(amuv_wu01,    mold=amuv_wu01_h);    amuv_wu01    = amuv_wu01_h;    end if
      if (allocated(amuv_wv01_h))    then; allocate(amuv_wv01,    mold=amuv_wv01_h);    amuv_wv01    = amuv_wv01_h;    end if
      if (allocated(amp_times_h))    then; allocate(amp_times,    mold=amp_times_h);    amp_times    = amp_times_h;    end if
      if (allocated(amp_patm_h))     then; allocate(amp_patm,     mold=amp_patm_h);     amp_patm     = amp_patm_h;     end if
      if (allocated(amp_patm01_h))   then; allocate(amp_patm01,   mold=amp_patm01_h);   amp_patm01   = amp_patm01_h;   end if
      if (allocated(ampr_times_h))   then; allocate(ampr_times,   mold=ampr_times_h);   ampr_times   = ampr_times_h;   end if
      if (allocated(ampr_pr_h))      then; allocate(ampr_pr,      mold=ampr_pr_h);      ampr_pr      = ampr_pr_h;      end if
      if (allocated(ampr_pr01_h))    then; allocate(ampr_pr01,    mold=ampr_pr01_h);    ampr_pr01    = ampr_pr01_h;    end if
      if (allocated(z0land_h))       then; allocate(z0land,       mold=z0land_h);       z0land       = z0land_h;       end if
      if (allocated(z0land_table_h)) then; allocate(z0land_table, mold=z0land_table_h); z0land_table = z0land_table_h; end if
      !
   end subroutine copyin_phase4_degenerate
   !
   ! ===================================================================
   ! Phase-4 / shadow-allocator helpers. Cell-rank gather pattern:
   !    allocate dev to size npn_local + halo_cell_count
   !    dev = host(local_to_global(1:size(dev)))
   ! Edge-rank: same with local_to_global_uv and npuv_local +
   ! halo_edge_count. Renumber-aware variants substitute connectivity
   ! entries through global_to_local / global_to_local_uv. In every case
   ! the host counterpart full-sized array stays untouched.
   ! ===================================================================
   !
   ! NOTE: the helpers below take a pre-allocated device dummy. Allocating
   ! through an `allocatable, intent(inout)` device dummy did not propagate
   ! the allocation status back to the module-scope actual argument under
   ! NVHPC 25.9 — the kernel side then dereferenced a NULL device pointer
   ! and compute-sanitizer flagged "Access to 0x0 is out of bounds". The
   ! caller now allocates the device shadow first, then calls the helper
   ! with a non-allocatable `intent(out)` device dummy that the helper
   ! fills via the gather expression.
   !
   subroutine gather_cell_int1(dev, host)
      integer*1, device, intent(out)     :: dev(:)
      integer*1, allocatable, intent(in) :: host(:)
      dev = host(local_to_global(1:size(dev)))
   end subroutine gather_cell_int1
   !
   subroutine gather_cell_int4(dev, host)
      integer*4, device, intent(out)     :: dev(:)
      integer*4, allocatable, intent(in) :: host(:)
      dev = host(local_to_global(1:size(dev)))
   end subroutine gather_cell_int4
   !
   subroutine gather_cell_real4(dev, host)
      real*4, device, intent(out)     :: dev(:)
      real*4, allocatable, intent(in) :: host(:)
      dev = host(local_to_global(1:size(dev)))
   end subroutine gather_cell_real4
   !
   subroutine gather_cell_real8(dev, host)
      real*8, device, intent(out)     :: dev(:)
      real*8, allocatable, intent(in) :: host(:)
      dev = host(local_to_global(1:size(dev)))
   end subroutine gather_cell_real8
   !
   subroutine gather_edge_int1(dev, host)
      integer*1, device, intent(out)     :: dev(:)
      integer*1, allocatable, intent(in) :: host(:)
      dev = host(local_to_global_uv(1:size(dev)))
   end subroutine gather_edge_int1
   !
   subroutine gather_edge_real4(dev, host)
      real*4, device, intent(out)     :: dev(:)
      real*4, allocatable, intent(in) :: host(:)
      dev = host(local_to_global_uv(1:size(dev)))
   end subroutine gather_edge_real4
   !
   subroutine gather_edge_wide_int1(dev, host)
      ! Wide edge-rank int*1: kcuv. Host is sized npuv_h + ncuv_h + 1 to
      ! cover combined-UV refinement transitions plus a sentinel slot;
      ! device shadow mirrors that shape with size
      ! (npuv_local + halo_edge_count) + ncuv_h + 1. local_to_global_uv
      ! has been extended with the matching tail entries so a single
      ! gather covers both portions.
      integer*1, device, intent(out)     :: dev(:)
      integer*1, allocatable, intent(in) :: host(:)
      dev = host(local_to_global_uv(1:size(dev)))
   end subroutine gather_edge_wide_int1
   !
   subroutine gather_edge_wide_real4(dev, host)
      ! Wide edge-rank real*4: q, q0, uv, uv0. See gather_edge_wide_int1.
      real*4, device, intent(out)     :: dev(:)
      real*4, allocatable, intent(in) :: host(:)
      dev = host(local_to_global_uv(1:size(dev)))
   end subroutine gather_edge_wide_real4
   !
   subroutine gather_cell_int4_renumber_edge(dev, host)
      ! Cell-rank int*4 with edge-index entries. Entries in
      ! [1..npuv_h] map to the local owned/halo edge slice; entries in
      ! [npuv_h+1..npuv_h+ncuv_h+1] map to combined-UV / sentinel slots
      ! at the wide tail (global_to_local_uv has been extended to cover
      ! both ranges). Entries outside that range pass through unchanged.
      integer*4, device, intent(out)     :: dev(:)
      integer*4, allocatable, intent(in) :: host(:)
      integer*4, allocatable :: tmp(:)
      integer :: i, e, nc, gmax
      nc   = size(dev)
      gmax = npuv_h + ncuv_h + 1
      allocate(tmp(nc))
      do i = 1, nc
         e = host(local_to_global(i))
         if (e <= 0 .or. e > gmax) then
            tmp(i) = e
         else
            tmp(i) = global_to_local_uv(e)
         end if
      end do
      dev = tmp
      deallocate(tmp)
   end subroutine gather_cell_int4_renumber_edge
   !
   subroutine gather_edge_int4_renumber_cell(dev, host)
      ! Edge-rank int*4 with cell-index entries.
      integer*4, device, intent(out)     :: dev(:)
      integer*4, allocatable, intent(in) :: host(:)
      integer*4, allocatable :: tmp(:)
      integer :: i, c, ne
      ne = size(dev)
      allocate(tmp(ne))
      do i = 1, ne
         c = host(local_to_global_uv(i))
         if (c <= 0 .or. c > npn_h) then
            tmp(i) = c
         else
            tmp(i) = global_to_local(c)
         end if
      end do
      dev = tmp
      deallocate(tmp)
   end subroutine gather_edge_int4_renumber_cell
   !
   subroutine gather_edge_int4_renumber_edge(dev, host)
      ! Edge-rank int*4 with edge-index entries (uv_index_u_*, uv_index_v_*,
      ! cuv_index_uv*). Entries can be in [1..npuv_h] (regular edges),
      ! [npuv_h+1..npuv_h+ncuv_h] (combined-UV) or npuv_h+ncuv_h+1
      ! (sentinel). global_to_local_uv has been extended to cover the full
      ! [1..npuv_h+ncuv_h+1] range so a single map lookup suffices.
      integer*4, device, intent(out)     :: dev(:)
      integer*4, allocatable, intent(in) :: host(:)
      integer*4, allocatable :: tmp(:)
      integer :: i, e, ne, gmax
      ne   = size(dev)
      gmax = npuv_h + ncuv_h + 1
      allocate(tmp(ne))
      do i = 1, ne
         e = host(local_to_global_uv(i))
         if (e <= 0 .or. e > gmax) then
            tmp(i) = e
         else
            tmp(i) = global_to_local_uv(e)
         end if
      end do
      dev = tmp
      deallocate(tmp)
   end subroutine gather_edge_int4_renumber_edge
   !
   subroutine renumber_to_local_cell(dev, host)
      ! Other-sized int*4 with cell-index entries: keep host shape,
      ! renumber entries through global_to_local. Used for nmindbnd
      ! (ngbnd-sized), nmikcuv2 / nmbkcuv2 (nkcuv2-sized).
      integer*4, device, intent(inout) :: dev(:)
      integer*4, intent(in)            :: host(:)
      integer*4, allocatable :: tmp(:)
      integer :: i, c, n
      n = size(host)
      allocate(tmp(n))
      do i = 1, n
         c = host(i)
         if (c <= 0 .or. c > npn_h) then
            tmp(i) = c
         else
            tmp(i) = global_to_local(c)
         end if
      end do
      dev = tmp
      deallocate(tmp)
   end subroutine renumber_to_local_cell
   !
   subroutine renumber_to_local_edge(dev, host)
      ! Other-sized int*4 with edge-index entries: keep host shape,
      ! renumber entries through global_to_local_uv. Used for index_kcuv2
      ! (nkcuv2-sized), structure_uv_index (nstruc-sized),
      ! wavemaker_index_uv (iwm-sized), and cuv_index_uv / cuv_index_uv1 /
      ! cuv_index_uv2 (ncuv-sized). Entries can also be combined-UV
      ! (npuv_h+1..npuv_h+ncuv_h) or sentinel (npuv_h+ncuv_h+1); the
      ! extended global_to_local_uv covers both. NOT used for ibkcuv2 —
      ! its entries are grid-boundary indices (1..ngbnd), not edge indices.
      integer*4, device, intent(inout) :: dev(:)
      integer*4, intent(in)            :: host(:)
      integer*4, allocatable :: tmp(:)
      integer :: i, e, n, gmax
      n    = size(host)
      gmax = npuv_h + ncuv_h + 1
      allocate(tmp(n))
      do i = 1, n
         e = host(i)
         if (e <= 0 .or. e > gmax) then
            tmp(i) = e
         else
            tmp(i) = global_to_local_uv(e)
         end if
      end do
      dev = tmp
      deallocate(tmp)
   end subroutine renumber_to_local_edge
   !
   ! ===================================================================
   ! Per-step bridge-IN gather and bridge-OUT scatter helpers, used by
   ! source/src/sfincs_*_gpu.cuf to copy host <-> device while the device
   ! shadow is local-indexed.
   !
   ! Bridge-IN gathers the FULL local range (1..npn_local + halo_cell_count
   ! for cell-rank, 1..npuv_local + halo_edge_count for edge-rank). Halo
   ! positions get whatever the host alias holds at the corresponding
   ! global index; this matches the pre-shrink behavior where bulk H2D
   ! overwrote the post-halo-exchange halo slice with the host's stale
   ! halo values, and is corrected each step by halo_exchange_zs /
   ! halo_exchange_q_uv at the end of the time-step.
   !
   ! Bridge-OUT scatters ONLY the owned slice (1..npn_local or 1..npuv_local).
   ! Halo entries on this rank's host alias are left untouched: they are
   ! authoritative on the OWNING rank, not this one. The output gather
   ! (gather_to_rank0_in_global_order) is what reconstructs the
   ! global-ordered host array on rank 0 for write_output / BMI getters.
   !
   ! Bridge-IN copies ONLY the owned slice into 1..npn_local (cell) or
   ! 1..npuv_local (edge) of the device shadow. The halo region of the
   ! device shadow (npn_local+1..nc, npuv_local+1..ne) is intentionally
   ! left untouched: those entries are populated by halo_exchange_zs /
   ! halo_exchange_q_uv at the end of each time step from neighbor-rank
   ! data. Touching them in bridge-IN would clobber the cross-rank halo
   ! values with stale host aliases (each rank's <name>_h is only kept
   ! current for its OWN owned slice, via bridge-OUT). For wide edge
   ! shadows (q, q0, uv, uv0, kcuv) the combined-UV tail at positions
   ! ne+1..nw is also copied because that portion of the host array is
   ! kept consistent across ranks by the boundary broadcast.
   ! ===================================================================
   !
   subroutine bridge_in_cell_real4(dev, host)
      real*4, device, intent(inout) :: dev(:)
      real*4, intent(in)            :: host(:)
      integer :: n
      n = npn_local
      if (n <= 0) return
      dev(1:n) = host(local_to_global(1:n))
   end subroutine bridge_in_cell_real4
   !
   subroutine bridge_in_cell_real8(dev, host)
      real*8, device, intent(inout) :: dev(:)
      real*8, intent(in)            :: host(:)
      integer :: n
      n = npn_local
      if (n <= 0) return
      dev(1:n) = host(local_to_global(1:n))
   end subroutine bridge_in_cell_real8
   !
   subroutine bridge_in_edge_real4(dev, host)
      ! Gather host -> device ONLY for the OWNED edge slice (1..npuv_local).
      ! The halo region (npuv_local+1..narrow) is populated by
      ! halo_exchange_q_uv. The combined-UV tail (narrow+1..size(dev)) is
      ! NOT touched here either -- it is recomputed each step on device by
      ! k_combined_uv (sfincs_momentum_gpu.cuf) from the neighbor-edge
      ! values, so the host alias is stale; copying host values into the
      ! tail would clobber the previous step's GPU-computed combined-UV
      ! averages and contaminate the next compute_fluxes / continuity
      ! reads.
      real*4, device, intent(inout) :: dev(:)
      real*4, intent(in)            :: host(:)
      if (npuv_local > 0) then
         dev(1:npuv_local) = host(local_to_global_uv(1:npuv_local))
      end if
   end subroutine bridge_in_edge_real4
   !
   subroutine bridge_out_cell_real4(host, dev)
      real*4, intent(inout)         :: host(:)
      real*4, device, intent(in)    :: dev(:)
      real*4, allocatable :: tmp(:)
      integer :: i, n
      n = npn_local
      if (n <= 0) return
      allocate(tmp(n))
      tmp = dev(1:n)
      do i = 1, n
         host(local_to_global(i)) = tmp(i)
      end do
      deallocate(tmp)
   end subroutine bridge_out_cell_real4
   !
   subroutine bridge_out_cell_real8(host, dev)
      real*8, intent(inout)         :: host(:)
      real*8, device, intent(in)    :: dev(:)
      real*8, allocatable :: tmp(:)
      integer :: i, n
      n = npn_local
      if (n <= 0) return
      allocate(tmp(n))
      tmp = dev(1:n)
      do i = 1, n
         host(local_to_global(i)) = tmp(i)
      end do
      deallocate(tmp)
   end subroutine bridge_out_cell_real8
   !
   subroutine bridge_out_cell_int1(host, dev)
      integer*1, intent(inout)         :: host(:)
      integer*1, device, intent(in)    :: dev(:)
      integer*1, allocatable :: tmp(:)
      integer :: i, n
      n = npn_local
      if (n <= 0) return
      allocate(tmp(n))
      tmp = dev(1:n)
      do i = 1, n
         host(local_to_global(i)) = tmp(i)
      end do
      deallocate(tmp)
   end subroutine bridge_out_cell_int1
   !
   subroutine bridge_out_cell_int4(host, dev)
      integer*4, intent(inout)         :: host(:)
      integer*4, device, intent(in)    :: dev(:)
      integer*4, allocatable :: tmp(:)
      integer :: i, n
      n = npn_local
      if (n <= 0) return
      allocate(tmp(n))
      tmp = dev(1:n)
      do i = 1, n
         host(local_to_global(i)) = tmp(i)
      end do
      deallocate(tmp)
   end subroutine bridge_out_cell_int4
   !
   subroutine bridge_out_edge_real4(host, dev)
      ! Scatter dev -> host for owned edges (1..npuv_local) and, if dev is
      ! wide-sized (size > npuv_local + halo_edge_count), the combined-UV
      ! tail at the end. Halo entries (between owned and tail) are
      ! authoritative on the owning rank and stay untouched in this rank's
      ! host alias. local_to_global_uv has been extended with tail entries
      ! that map to host positions npuv_h + 1 .. npuv_h + ncuv_h + 1.
      real*4, intent(inout)         :: host(:)
      real*4, device, intent(in)    :: dev(:)
      real*4, allocatable :: tmp(:)
      integer :: i, n_total, narrow
      n_total = size(dev)
      narrow  = npuv_local + halo_edge_count
      if (n_total <= 0) return
      allocate(tmp(n_total))
      tmp = dev(1:n_total)
      do i = 1, npuv_local
         host(local_to_global_uv(i)) = tmp(i)
      end do
      if (n_total > narrow) then
         do i = narrow + 1, n_total
            host(local_to_global_uv(i)) = tmp(i)
         end do
      end if
      deallocate(tmp)
   end subroutine bridge_out_edge_real4
   !
   subroutine bridge_out_edge_int1(host, dev)
      integer*1, intent(inout)         :: host(:)
      integer*1, device, intent(in)    :: dev(:)
      integer*1, allocatable :: tmp(:)
      integer :: i, n_total, narrow
      n_total = size(dev)
      narrow  = npuv_local + halo_edge_count
      if (n_total <= 0) return
      allocate(tmp(n_total))
      tmp = dev(1:n_total)
      do i = 1, npuv_local
         host(local_to_global_uv(i)) = tmp(i)
      end do
      if (n_total > narrow) then
         do i = narrow + 1, n_total
            host(local_to_global_uv(i)) = tmp(i)
         end do
      end if
      deallocate(tmp)
   end subroutine bridge_out_edge_int1
   !
   subroutine compute_quadtree_geometric_partition(cell_part)
      !
      ! Strategy: quadtree-aware geometric split. METIS not used (avoids
      ! external configure dep, vendoring, C-binding wrapper).
      !
      ! Algorithm:
      !   1. Compute the bounding box of cells with kcs_h > 0.
      !   2. Choose the longer-axis (x or y) as split axis.
      !   3. Sort active cells by the chosen-axis centroid (z_xz_h or z_yz_h).
      !   4. Walk the sorted list, splitting it into mpi_size contiguous
      !      slabs of size (n_active / mpi_size). At each cut, snap forward
      !      past any z_flags_iref_h > 1 cells so quadtree children stay on
      !      the same rank as their coarse parent. For regular grids this
      !      snap is a no-op.
      !   5. Cells with kcs_h <= 0 are assigned to rank 0 by default; halo
      !      discovery treats them as belonging to a foreign rank from the
      !      perspective of any rank > 0, which is wasteful but harmless
      !      because their kcs is zero so kernels skip them.
      !   6. For mpi_size == 1 the loop body never runs and cell_part(:)
      !      stays at zero.
      !
      integer, intent(out) :: cell_part(:)
      !
      integer :: i, k, n_active, lo, hi
      real*4 :: xmin, xmax, ymin, ymax
      real*4 :: extent_x, extent_y
      integer :: split_axis
      integer, allocatable :: active_idx(:)
      real*4,  allocatable :: keys(:)
      !
      cell_part(:) = 0
      if (mpi_size <= 1)  return
      if (npn_h    <= 0)  return
      if (.not. allocated(kcs_h))  return
      if (.not. allocated(z_xz_h)) return
      if (.not. allocated(z_yz_h)) return
      !
      xmin =  huge(0.0_4); xmax = -huge(0.0_4)
      ymin =  huge(0.0_4); ymax = -huge(0.0_4)
      n_active = 0
      do i = 1, npn_h
         if (kcs_h(i) > 0) then
            n_active = n_active + 1
            if (z_xz_h(i) < xmin) xmin = z_xz_h(i)
            if (z_xz_h(i) > xmax) xmax = z_xz_h(i)
            if (z_yz_h(i) < ymin) ymin = z_yz_h(i)
            if (z_yz_h(i) > ymax) ymax = z_yz_h(i)
         end if
      end do
      if (n_active <= 0) return
      !
      extent_x = xmax - xmin
      extent_y = ymax - ymin
      if (extent_x >= extent_y) then
         split_axis = 1
      else
         split_axis = 2
      end if
      !
      allocate(active_idx(n_active))
      allocate(keys(n_active))
      k = 0
      do i = 1, npn_h
         if (kcs_h(i) > 0) then
            k = k + 1
            active_idx(k) = i
            if (split_axis == 1) then
               keys(k) = z_xz_h(i)
            else
               keys(k) = z_yz_h(i)
            end if
         end if
      end do
      call sort_indices_by_key(active_idx, keys, n_active)
      !
      lo = 1
      do k = 0, mpi_size - 1
         if (k < mpi_size - 1) then
            hi = (n_active * (k + 1)) / mpi_size
            if (allocated(z_flags_iref_h)) then
               do while (hi < n_active)
                  if (z_flags_iref_h(active_idx(hi + 1)) > 1) then
                     hi = hi + 1
                  else
                     exit
                  end if
               end do
            end if
         else
            hi = n_active
         end if
         do i = lo, hi
            cell_part(active_idx(i)) = k
         end do
         lo = hi + 1
      end do
      !
      deallocate(active_idx)
      deallocate(keys)
      !
   end subroutine compute_quadtree_geometric_partition
   !
   subroutine sort_indices_by_key(idx, keys, n)
      integer, intent(inout) :: idx(:)
      real*4,  intent(inout) :: keys(:)
      integer, intent(in)    :: n
      if (n > 1) call qsort_recursive(idx, keys, 1, n)
   end subroutine sort_indices_by_key
   !
   recursive subroutine qsort_recursive(idx, keys, lo, hi)
      integer, intent(inout) :: idx(:)
      real*4,  intent(inout) :: keys(:)
      integer, intent(in)    :: lo, hi
      integer :: i, j, tmp_i
      real*4  :: pivot, tmp_k
      if (lo >= hi) return
      pivot = keys((lo + hi) / 2)
      i = lo - 1
      j = hi + 1
      do
         do
            i = i + 1
            if (keys(i) >= pivot) exit
         end do
         do
            j = j - 1
            if (keys(j) <= pivot) exit
         end do
         if (i >= j) exit
         tmp_k   = keys(i); keys(i) = keys(j); keys(j) = tmp_k
         tmp_i   = idx(i);  idx(i)  = idx(j);  idx(j)  = tmp_i
      end do
      call qsort_recursive(idx, keys, lo, j)
      call qsort_recursive(idx, keys, j + 1, hi)
   end subroutine qsort_recursive
   !
   subroutine build_local_index_maps(cell_part, npn_total, npuv_total)
      !
      ! Walks owned cells, discovers one-cell-deep cell and edge halos, and
      ! produces the local_to_global / global_to_local maps consumed by
      ! Phase 4 copyin (shrink + connectivity renumber) and Phase 5
      ! halo-descriptor build. Halo cells are laid out contiguously after
      ! owned cells, grouped by neighbor rank in halo_neighbor_ranks order,
      ! so that the per-neighbor receive slices in halo_recv_local_idx are
      ! contiguous local-index ranges. All four maps live module-scope in
      ! sfincs_data_device.cuf so they outlive partition_and_localize: the
      ! halo-exchange runtime, the per-step bridge-IN/OUT helpers in
      ! source/src/sfincs_*_gpu.cuf, and the deferred shadow allocators
      ! (allocate_structure / allocate_discharges / allocate_wavemaker
      ! device shadows) all read them.
      !
      integer, intent(in)  :: cell_part(:)
      integer, intent(out) :: npn_total, npuv_total
      !
      logical, allocatable :: is_halo_cell(:), is_halo_edge(:)
      integer, allocatable :: edge_owner(:)
      logical, allocatable :: neighbor_present(:)
      integer, allocatable :: nbr_ranks(:)
      integer :: nm, iuv, nm_a, nm_b, nm_other
      integer :: edge_slot
      integer :: i, k, r, ridx, n_neighbors
      !
      ! Initialise scalars/output arrays to safe defaults for the
      ! mpi_size == 1 / unallocated-input fast path.
      !
      npn_local         = 0
      npuv_local        = 0
      cell_index_first  = 0
      cell_index_last   = 0
      halo_n_neighbors  = 0
      halo_uv_n_neighbors = 0
      !
      ! Reset module-scope translation maps in case partition_and_localize
      ! is re-entered (defensive — only one call site today).
      !
      if (allocated(local_to_global))    deallocate(local_to_global)
      if (allocated(local_to_global_uv)) deallocate(local_to_global_uv)
      if (allocated(global_to_local))    deallocate(global_to_local)
      if (allocated(global_to_local_uv)) deallocate(global_to_local_uv)
      !
      if (npn_h <= 0) then
         allocate(local_to_global(0))
         allocate(global_to_local(0))
         allocate(local_to_global_uv(0))
         allocate(global_to_local_uv(0))
         npn_total  = 0
         npuv_total = 0
         return
      end if
      !
      allocate(is_halo_cell(npn_h));  is_halo_cell = .false.
      allocate(is_halo_edge(max(npuv_h, 1)))
      is_halo_edge = .false.
      !
      ! Edge ownership rule per architect contract: the owner rank of edge
      ! iuv is the rank that owns uv_index_z_nm_h(iuv) (the "first cell"
      ! side of the edge). Edges with no first-cell-side fall back to the
      ! second-cell side; otherwise they are assigned to rank 0.
      !
      allocate(edge_owner(max(npuv_h, 1)))
      edge_owner = 0
      if (allocated(uv_index_z_nm_h)) then
         do iuv = 1, npuv_h
            nm_a = uv_index_z_nm_h(iuv)
            if (nm_a > 0 .and. nm_a <= npn_h) then
               edge_owner(iuv) = cell_part(nm_a)
            else if (allocated(uv_index_z_nmu_h)) then
               nm_b = uv_index_z_nmu_h(iuv)
               if (nm_b > 0 .and. nm_b <= npn_h) then
                  edge_owner(iuv) = cell_part(nm_b)
               end if
            end if
         end do
      end if
      !
      ! Halo discovery: walk owned cells, classify referenced neighbors and
      ! edges. Each rank's halo_send_to_rank / halo_uv_send_to_rank flags
      ! are reconstructed by build_halo_descriptors from cell_part + the
      ! same neighbor walk; here we only need the receive flags because
      ! they are what defines local_to_global's halo region.
      !
      ! For cross-refinement-level quadtree edges we MUST enumerate the
      ! split *_md1/md2/mu1/mu2/nd1/nd2/nu1/nu2 arrays rather than the
      ! collapsed *_md/_mu/_nd/_nu arrays. When a coarse cell has finer
      ! neighbors on a side, sfincs_domain assigns the collapsed slot to
      ! a "combined" cuv_index_uv pseudo-index that lies outside the
      ! 1..npuv range, so the coarse-owning rank skips that slot and
      ! never sees the cross-level halo cells / edges. The fine-owning
      ! rank, in contrast, walks each fine cell's md1/mu1/nd1/nu1 (which
      ! is a real iuv) and enumerates the cross-level edge -- producing
      ! send/recv counts that the coarse rank does not match. The split
      ! arrays always store real iuv values and are populated on both
      ! sides of every cross-level edge, so walking them recovers
      ! send/recv symmetry on the cross-rank quadtree boundary.
      !
      if (mpi_size > 1 .and. allocated(z_index_uv_md1_h) .and. &
          allocated(z_index_uv_md2_h) .and. &
          allocated(z_index_uv_mu1_h) .and. allocated(z_index_uv_mu2_h) .and. &
          allocated(z_index_uv_nd1_h) .and. allocated(z_index_uv_nd2_h) .and. &
          allocated(z_index_uv_nu1_h) .and. allocated(z_index_uv_nu2_h) .and. &
          allocated(uv_index_z_nm_h) .and. allocated(uv_index_z_nmu_h)) then
         do nm = 1, npn_h
            if (cell_part(nm) /= mpi_rank) cycle
            do edge_slot = 1, 8
               select case (edge_slot)
                  case (1); iuv = z_index_uv_md1_h(nm)
                  case (2); iuv = z_index_uv_md2_h(nm)
                  case (3); iuv = z_index_uv_nd1_h(nm)
                  case (4); iuv = z_index_uv_nd2_h(nm)
                  case (5); iuv = z_index_uv_mu1_h(nm)
                  case (6); iuv = z_index_uv_mu2_h(nm)
                  case (7); iuv = z_index_uv_nu1_h(nm)
                  case (8); iuv = z_index_uv_nu2_h(nm)
               end select
               if (iuv <= 0 .or. iuv > npuv_h) cycle
               nm_a = uv_index_z_nm_h(iuv)
               nm_b = uv_index_z_nmu_h(iuv)
               if (nm_a == nm) then
                  nm_other = nm_b
               else if (nm_b == nm) then
                  nm_other = nm_a
               else
                  nm_other = 0
               end if
               if (nm_other > 0 .and. nm_other <= npn_h) then
                  if (cell_part(nm_other) /= mpi_rank) is_halo_cell(nm_other) = .true.
               end if
               if (edge_owner(iuv) /= mpi_rank) is_halo_edge(iuv) = .true.
            end do
         end do
      end if
      !
      ! Determine neighbor ranks (ranks we receive from). We use only the
      ! receive sides here because halo_send_count and halo_neighbor_ranks
      ! (which is shared between z and uv halos) get a second symmetric
      ! pass in build_halo_descriptors after both sides agree on the same
      ! cell_part.
      !
      allocate(neighbor_present(0:max(mpi_size-1, 0)))
      neighbor_present = .false.
      do nm = 1, npn_h
         if (is_halo_cell(nm)) then
            r = cell_part(nm)
            if (r >= 0 .and. r < mpi_size .and. r /= mpi_rank) neighbor_present(r) = .true.
         end if
      end do
      do iuv = 1, npuv_h
         if (is_halo_edge(iuv)) then
            r = edge_owner(iuv)
            if (r >= 0 .and. r < mpi_size .and. r /= mpi_rank) neighbor_present(r) = .true.
         end if
      end do
      !
      n_neighbors = count(neighbor_present)
      allocate(nbr_ranks(max(n_neighbors, 1)))
      nbr_ranks = -1
      k = 0
      do r = 0, mpi_size - 1
         if (neighbor_present(r)) then
            k = k + 1
            nbr_ranks(k) = r
         end if
      end do
      !
      ! Stash neighbor list into module-level halo state. build_halo_descriptors
      ! re-uses this and fills the per-rank counts and index arrays.
      !
      if (allocated(halo_neighbor_ranks)) deallocate(halo_neighbor_ranks)
      allocate(halo_neighbor_ranks(n_neighbors))
      do k = 1, n_neighbors
         halo_neighbor_ranks(k) = nbr_ranks(k)
      end do
      halo_n_neighbors    = n_neighbors
      halo_uv_n_neighbors = n_neighbors
      !
      ! ---- Build cell map ----
      !
      npn_local = 0
      do nm = 1, npn_h
         if (cell_part(nm) == mpi_rank) npn_local = npn_local + 1
      end do
      npn_total = npn_local + count(is_halo_cell)
      !
      allocate(local_to_global(max(npn_total, 1)))
      allocate(global_to_local(max(npn_h, 1)))
      local_to_global = 0
      global_to_local = 0
      i = 0
      do nm = 1, npn_h
         if (cell_part(nm) == mpi_rank) then
            i = i + 1
            local_to_global(i) = nm
            global_to_local(nm) = i
         end if
      end do
      do ridx = 1, n_neighbors
         r = nbr_ranks(ridx)
         do nm = 1, npn_h
            if (is_halo_cell(nm) .and. cell_part(nm) == r) then
               i = i + 1
               local_to_global(i) = nm
               global_to_local(nm) = i
            end if
         end do
      end do
      !
      cell_index_first = 1
      cell_index_last  = npn_local
      !
      ! ---- Build edge map ----
      !
      npuv_local = 0
      do iuv = 1, npuv_h
         if (edge_owner(iuv) == mpi_rank) npuv_local = npuv_local + 1
      end do
      npuv_total = npuv_local + count(is_halo_edge)
      !
      ! Wide layout: local_to_global_uv extends past
      ! npuv_local + halo_edge_count with ncuv_h slots for combined-UV
      ! (quadtree refinement transitions) plus a sentinel slot at the end,
      ! mirroring host arrays sized npuv + ncuv + 1 (q, q0, uv, uv0, kcuv).
      ! global_to_local_uv extends to npuv_h + ncuv_h + 1 so that
      ! connectivity entries that reference combined-UV global positions
      ! (npuv_h+1 .. npuv_h+ncuv_h) and the sentinel (npuv_h+ncuv_h+1) get
      ! renumbered into local positions in the same wide layout. Other-
      ! sized device shadows (uv_index_*_*, uv_flags_*, kfuv, etc., sized
      ! "narrow" npuv on host) don't include the tail — they ignore it
      ! by allocating only npuv_local + halo_edge_count entries.
      !
      allocate(local_to_global_uv(max(npuv_total + ncuv_h + 1, 1)))
      allocate(global_to_local_uv(max(npuv_h + ncuv_h + 1, 1)))
      local_to_global_uv = 0
      global_to_local_uv = 0
      i = 0
      do iuv = 1, npuv_h
         if (edge_owner(iuv) == mpi_rank) then
            i = i + 1
            local_to_global_uv(i) = iuv
            global_to_local_uv(iuv) = i
         end if
      end do
      do ridx = 1, n_neighbors
         r = nbr_ranks(ridx)
         do iuv = 1, npuv_h
            if (is_halo_edge(iuv) .and. edge_owner(iuv) == r) then
               i = i + 1
               local_to_global_uv(i) = iuv
               global_to_local_uv(iuv) = i
            end if
         end do
      end do
      !
      ! Combined-UV + sentinel tail. Each rank mirrors the global tail so
      ! k_combined_uv (which iterates 1..ncuv on every rank) can write into
      ! a contiguous range in the device shadow, and so connectivity
      ! entries pointing to the global sentinel npuv_h + ncuv_h + 1 stay
      ! in-bounds after renumber.
      !
      do iuv = 1, ncuv_h + 1
         local_to_global_uv(npuv_total + iuv) = npuv_h + iuv
         global_to_local_uv(npuv_h    + iuv) = npuv_total + iuv
      end do
      !
      deallocate(is_halo_cell)
      deallocate(is_halo_edge)
      deallocate(edge_owner)
      deallocate(neighbor_present)
      deallocate(nbr_ranks)
      !
   end subroutine build_local_index_maps
   !
   subroutine build_halo_descriptors(cell_part)
      !
      ! Builds the per-neighbor-rank cell and edge index lists consumed by
      ! halo_exchange_zs / halo_exchange_q_uv (SOR-708) at runtime. The neighbor-rank list
      ! halo_neighbor_ranks and the n_neighbors scalars were already
      ! produced by build_local_index_maps above; this routine fills the
      ! six halo_*_idx and four halo_*_count arrays:
      !
      !   halo_recv_local_idx    : local indices (npn_local+1..npn_total) where
      !                            received cell data is scattered.
      !   halo_recv_remote_idx   : matching GLOBAL cell indices on the
      !                            sending rank (the SOR-708 Isend uses
      !                            these as gather sources).
      !   halo_send_local_idx    : local indices of OWNED cells we need to
      !                            gather and ship to each neighbor.
      !   halo_uv_recv_local_idx / halo_uv_recv_remote_idx /
      !   halo_uv_send_local_idx : same shape, but for edge (uv) halos.
      !   halo_*_count           : per-neighbor valid lengths.
      !
      ! For mpi_size == 1 the routine returns immediately with all device
      ! arrays unallocated and counts at zero, which is what guarantees the
      ! N=1 device-side state matches the prior degenerate code path.
      ! global_to_local / global_to_local_uv are read from module scope
      ! (sfincs_data_device); they are populated by build_local_index_maps
      ! and outlive this routine for use by Phase 4 copyin and the deferred
      ! shadow allocators.
      !
      integer, intent(in) :: cell_part(:)
      !
      integer, allocatable :: edge_owner(:)
      integer, allocatable :: cell_recv_count(:), cell_send_count(:)
      integer, allocatable :: edge_recv_count(:), edge_send_count(:)
      integer, allocatable :: cell_recv_loc(:,:), cell_recv_rem(:,:), cell_send_loc(:,:)
      integer, allocatable :: edge_recv_loc(:,:), edge_recv_rem(:,:), edge_send_loc(:,:)
      integer :: iuv, nm_a, nm_b
      integer :: r_a, r_b, r_edge
      integer :: ridx
      integer :: max_cell_recv, max_cell_send, max_edge_recv, max_edge_send
      integer, allocatable :: rank_to_idx(:)
      !
      ! Reset previous-run device-side allocations defensively. For N=1 the
      ! call returns here with zero allocations.
      !
      if (allocated(halo_recv_local_idx))    deallocate(halo_recv_local_idx)
      if (allocated(halo_recv_remote_idx))   deallocate(halo_recv_remote_idx)
      if (allocated(halo_send_local_idx))    deallocate(halo_send_local_idx)
      if (allocated(halo_uv_recv_local_idx)) deallocate(halo_uv_recv_local_idx)
      if (allocated(halo_uv_recv_remote_idx))deallocate(halo_uv_recv_remote_idx)
      if (allocated(halo_uv_send_local_idx)) deallocate(halo_uv_send_local_idx)
      if (allocated(halo_recv_count))        deallocate(halo_recv_count)
      if (allocated(halo_send_count))        deallocate(halo_send_count)
      if (allocated(halo_uv_recv_count))     deallocate(halo_uv_recv_count)
      if (allocated(halo_uv_send_count))     deallocate(halo_uv_send_count)
      !
      if (mpi_size <= 1 .or. halo_n_neighbors <= 0) then
         allocate(halo_recv_count(0))
         allocate(halo_send_count(0))
         allocate(halo_uv_recv_count(0))
         allocate(halo_uv_send_count(0))
         return
      end if
      !
      ! Reverse map rank -> neighbor-list index for fast lookup during walk.
      !
      allocate(rank_to_idx(0:mpi_size - 1))
      rank_to_idx = 0
      do ridx = 1, halo_n_neighbors
         rank_to_idx(halo_neighbor_ranks(ridx)) = ridx
      end do
      !
      ! Recompute edge ownership (same rule as build_local_index_maps).
      !
      allocate(edge_owner(max(npuv_h, 1)))
      edge_owner = 0
      if (allocated(uv_index_z_nm_h)) then
         do iuv = 1, npuv_h
            nm_a = uv_index_z_nm_h(iuv)
            if (nm_a > 0 .and. nm_a <= npn_h) then
               edge_owner(iuv) = cell_part(nm_a)
            else if (allocated(uv_index_z_nmu_h)) then
               nm_b = uv_index_z_nmu_h(iuv)
               if (nm_b > 0 .and. nm_b <= npn_h) then
                  edge_owner(iuv) = cell_part(nm_b)
               end if
            end if
         end do
      end if
      !
      ! ---- Pass 1: count per-neighbor entries ----
      !
      ! Both passes walk iuv = 1..npuv_h in canonical (global) order. Every
      ! rank walks the same sequence and reaches a given iuv at the same step
      ! in its own list, so any iuv that two ranks both touch lands at
      ! identical per-neighbor slot positions on the two sides. This is the
      ! SOR-1013 fix for cross-refinement-level halo descriptor asymmetry: the
      ! prior owned-cell × eight-slot walk traversed cells in nm-order, but
      ! coarse-side (one slot per fine neighbor) and fine-side (one slot per
      ! coarse neighbor) orderings diverged whenever the two ranks owned the
      ! adjacent cells in different nm-orders, leaving rank N's "send slot k
      ! for neighbor M" referring to a different global iuv than rank M's
      ! "recv slot k from N" on the same edge.
      !
      allocate(cell_recv_count(halo_n_neighbors)); cell_recv_count = 0
      allocate(cell_send_count(halo_n_neighbors)); cell_send_count = 0
      allocate(edge_recv_count(halo_n_neighbors)); edge_recv_count = 0
      allocate(edge_send_count(halo_n_neighbors)); edge_send_count = 0
      !
      block
         logical, allocatable :: cell_recv_seen(:), cell_send_seen(:,:)
         logical, allocatable :: edge_recv_seen(:), edge_send_seen(:,:)
         allocate(cell_recv_seen(npn_h));                       cell_recv_seen = .false.
         allocate(cell_send_seen(npn_h, halo_n_neighbors));     cell_send_seen = .false.
         allocate(edge_recv_seen(max(npuv_h, 1)));              edge_recv_seen = .false.
         allocate(edge_send_seen(max(npuv_h, 1), halo_n_neighbors)); edge_send_seen = .false.
         !
         do iuv = 1, npuv_h
            nm_a = uv_index_z_nm_h(iuv)
            nm_b = uv_index_z_nmu_h(iuv)
            r_a = -1
            r_b = -1
            if (nm_a > 0 .and. nm_a <= npn_h) r_a = cell_part(nm_a)
            if (nm_b > 0 .and. nm_b <= npn_h) r_b = cell_part(nm_b)
            r_edge = edge_owner(iuv)
            !
            ! Cell halo when I own nm_a and the other cell is non-owned.
            !
            if (r_a == mpi_rank .and. r_b /= mpi_rank .and. r_b >= 0 .and. r_b < mpi_size) then
               ridx = rank_to_idx(r_b)
               if (ridx > 0) then
                  if (.not. cell_recv_seen(nm_b)) then
                     cell_recv_seen(nm_b) = .true.
                     cell_recv_count(ridx) = cell_recv_count(ridx) + 1
                  end if
                  if (.not. cell_send_seen(nm_a, ridx)) then
                     cell_send_seen(nm_a, ridx) = .true.
                     cell_send_count(ridx) = cell_send_count(ridx) + 1
                  end if
               end if
            end if
            !
            ! Cell halo when I own nm_b and the other cell is non-owned.
            !
            if (r_b == mpi_rank .and. r_a /= mpi_rank .and. r_a >= 0 .and. r_a < mpi_size) then
               ridx = rank_to_idx(r_a)
               if (ridx > 0) then
                  if (.not. cell_recv_seen(nm_a)) then
                     cell_recv_seen(nm_a) = .true.
                     cell_recv_count(ridx) = cell_recv_count(ridx) + 1
                  end if
                  if (.not. cell_send_seen(nm_b, ridx)) then
                     cell_send_seen(nm_b, ridx) = .true.
                     cell_send_count(ridx) = cell_send_count(ridx) + 1
                  end if
               end if
            end if
            !
            ! Edge halo. Receive if someone else owns the edge but I own an
            ! adjacent cell; send if I own the edge and an adjacent cell is
            ! on another rank.
            !
            if (r_edge == mpi_rank) then
               if (r_a /= mpi_rank .and. r_a >= 0 .and. r_a < mpi_size) then
                  ridx = rank_to_idx(r_a)
                  if (ridx > 0 .and. .not. edge_send_seen(iuv, ridx)) then
                     edge_send_seen(iuv, ridx) = .true.
                     edge_send_count(ridx) = edge_send_count(ridx) + 1
                  end if
               end if
               if (r_b /= mpi_rank .and. r_b >= 0 .and. r_b < mpi_size) then
                  ridx = rank_to_idx(r_b)
                  if (ridx > 0 .and. .not. edge_send_seen(iuv, ridx)) then
                     edge_send_seen(iuv, ridx) = .true.
                     edge_send_count(ridx) = edge_send_count(ridx) + 1
                  end if
               end if
            else if (r_edge >= 0 .and. r_edge < mpi_size) then
               if (r_a == mpi_rank .or. r_b == mpi_rank) then
                  ridx = rank_to_idx(r_edge)
                  if (ridx > 0 .and. .not. edge_recv_seen(iuv)) then
                     edge_recv_seen(iuv) = .true.
                     edge_recv_count(ridx) = edge_recv_count(ridx) + 1
                  end if
               end if
            end if
         end do
         !
         ! ---- Pass 2: allocate buffers and fill index arrays ----
         !
         max_cell_recv = max(maxval(cell_recv_count), 1)
         max_cell_send = max(maxval(cell_send_count), 1)
         max_edge_recv = max(maxval(edge_recv_count), 1)
         max_edge_send = max(maxval(edge_send_count), 1)
         !
         allocate(cell_recv_loc(max_cell_recv, halo_n_neighbors)); cell_recv_loc = 0
         allocate(cell_recv_rem(max_cell_recv, halo_n_neighbors)); cell_recv_rem = 0
         allocate(cell_send_loc(max_cell_send, halo_n_neighbors)); cell_send_loc = 0
         allocate(edge_recv_loc(max_edge_recv, halo_n_neighbors)); edge_recv_loc = 0
         allocate(edge_recv_rem(max_edge_recv, halo_n_neighbors)); edge_recv_rem = 0
         allocate(edge_send_loc(max_edge_send, halo_n_neighbors)); edge_send_loc = 0
         !
         block
            integer, allocatable :: c_recv_pos(:), c_send_pos(:), e_recv_pos(:), e_send_pos(:)
            allocate(c_recv_pos(halo_n_neighbors)); c_recv_pos = 0
            allocate(c_send_pos(halo_n_neighbors)); c_send_pos = 0
            allocate(e_recv_pos(halo_n_neighbors)); e_recv_pos = 0
            allocate(e_send_pos(halo_n_neighbors)); e_send_pos = 0
            !
            ! Reset _seen flags so we do not double-count during the second walk.
            !
            cell_recv_seen = .false.
            cell_send_seen = .false.
            edge_recv_seen = .false.
            edge_send_seen = .false.
            !
            do iuv = 1, npuv_h
               nm_a = uv_index_z_nm_h(iuv)
               nm_b = uv_index_z_nmu_h(iuv)
               r_a = -1
               r_b = -1
               if (nm_a > 0 .and. nm_a <= npn_h) r_a = cell_part(nm_a)
               if (nm_b > 0 .and. nm_b <= npn_h) r_b = cell_part(nm_b)
               r_edge = edge_owner(iuv)
               !
               if (r_a == mpi_rank .and. r_b /= mpi_rank .and. r_b >= 0 .and. r_b < mpi_size) then
                  ridx = rank_to_idx(r_b)
                  if (ridx > 0) then
                     if (.not. cell_recv_seen(nm_b)) then
                        cell_recv_seen(nm_b) = .true.
                        c_recv_pos(ridx) = c_recv_pos(ridx) + 1
                        cell_recv_loc(c_recv_pos(ridx), ridx) = global_to_local(nm_b)
                        cell_recv_rem(c_recv_pos(ridx), ridx) = nm_b
                     end if
                     if (.not. cell_send_seen(nm_a, ridx)) then
                        cell_send_seen(nm_a, ridx) = .true.
                        c_send_pos(ridx) = c_send_pos(ridx) + 1
                        cell_send_loc(c_send_pos(ridx), ridx) = global_to_local(nm_a)
                     end if
                  end if
               end if
               !
               if (r_b == mpi_rank .and. r_a /= mpi_rank .and. r_a >= 0 .and. r_a < mpi_size) then
                  ridx = rank_to_idx(r_a)
                  if (ridx > 0) then
                     if (.not. cell_recv_seen(nm_a)) then
                        cell_recv_seen(nm_a) = .true.
                        c_recv_pos(ridx) = c_recv_pos(ridx) + 1
                        cell_recv_loc(c_recv_pos(ridx), ridx) = global_to_local(nm_a)
                        cell_recv_rem(c_recv_pos(ridx), ridx) = nm_a
                     end if
                     if (.not. cell_send_seen(nm_b, ridx)) then
                        cell_send_seen(nm_b, ridx) = .true.
                        c_send_pos(ridx) = c_send_pos(ridx) + 1
                        cell_send_loc(c_send_pos(ridx), ridx) = global_to_local(nm_b)
                     end if
                  end if
               end if
               !
               if (r_edge == mpi_rank) then
                  if (r_a /= mpi_rank .and. r_a >= 0 .and. r_a < mpi_size) then
                     ridx = rank_to_idx(r_a)
                     if (ridx > 0 .and. .not. edge_send_seen(iuv, ridx)) then
                        edge_send_seen(iuv, ridx) = .true.
                        e_send_pos(ridx) = e_send_pos(ridx) + 1
                        edge_send_loc(e_send_pos(ridx), ridx) = global_to_local_uv(iuv)
                     end if
                  end if
                  if (r_b /= mpi_rank .and. r_b >= 0 .and. r_b < mpi_size) then
                     ridx = rank_to_idx(r_b)
                     if (ridx > 0 .and. .not. edge_send_seen(iuv, ridx)) then
                        edge_send_seen(iuv, ridx) = .true.
                        e_send_pos(ridx) = e_send_pos(ridx) + 1
                        edge_send_loc(e_send_pos(ridx), ridx) = global_to_local_uv(iuv)
                     end if
                  end if
               else if (r_edge >= 0 .and. r_edge < mpi_size) then
                  if (r_a == mpi_rank .or. r_b == mpi_rank) then
                     ridx = rank_to_idx(r_edge)
                     if (ridx > 0 .and. .not. edge_recv_seen(iuv)) then
                        edge_recv_seen(iuv) = .true.
                        e_recv_pos(ridx) = e_recv_pos(ridx) + 1
                        edge_recv_loc(e_recv_pos(ridx), ridx) = global_to_local_uv(iuv)
                        edge_recv_rem(e_recv_pos(ridx), ridx) = iuv
                     end if
                  end if
               end if
            end do
            !
            deallocate(c_recv_pos)
            deallocate(c_send_pos)
            deallocate(e_recv_pos)
            deallocate(e_send_pos)
         end block
         !
         deallocate(cell_recv_seen)
         deallocate(cell_send_seen)
         deallocate(edge_recv_seen)
         deallocate(edge_send_seen)
      end block
      !
      ! ---- Push host descriptors onto the device ----
      !
      allocate(halo_recv_local_idx(max_cell_recv, halo_n_neighbors))
      allocate(halo_recv_remote_idx(max_cell_recv, halo_n_neighbors))
      allocate(halo_send_local_idx(max_cell_send, halo_n_neighbors))
      allocate(halo_uv_recv_local_idx(max_edge_recv, halo_n_neighbors))
      allocate(halo_uv_recv_remote_idx(max_edge_recv, halo_n_neighbors))
      allocate(halo_uv_send_local_idx(max_edge_send, halo_n_neighbors))
      !
      halo_recv_local_idx     = cell_recv_loc
      halo_recv_remote_idx    = cell_recv_rem
      halo_send_local_idx     = cell_send_loc
      halo_uv_recv_local_idx  = edge_recv_loc
      halo_uv_recv_remote_idx = edge_recv_rem
      halo_uv_send_local_idx  = edge_send_loc
      !
      allocate(halo_recv_count(halo_n_neighbors))
      allocate(halo_send_count(halo_n_neighbors))
      allocate(halo_uv_recv_count(halo_n_neighbors))
      allocate(halo_uv_send_count(halo_n_neighbors))
      halo_recv_count    = cell_recv_count
      halo_send_count    = cell_send_count
      halo_uv_recv_count = edge_recv_count
      halo_uv_send_count = edge_send_count
      !
      deallocate(cell_recv_loc); deallocate(cell_recv_rem); deallocate(cell_send_loc)
      deallocate(edge_recv_loc); deallocate(edge_recv_rem); deallocate(edge_send_loc)
      deallocate(cell_recv_count); deallocate(cell_send_count)
      deallocate(edge_recv_count); deallocate(edge_send_count)
      deallocate(rank_to_idx)
      deallocate(edge_owner)
      !
   end subroutine build_halo_descriptors
   !
   subroutine validate_halo_descriptors()
      !
      ! SOR-1013: optional cross-rank halo descriptor symmetry check.
      !
      ! For each neighbor pair (mpi_rank, nbr) the routine verifies that the
      ! global-iuv sequence this rank places in its send-list-for-nbr matches,
      ! slot-by-slot, the global-iuv sequence nbr expects in its
      ! recv-list-from-this-rank. A mismatch means halo_exchange_q_uv would
      ! deliver each rank's owned q value into the wrong halo slot on the
      ! receiver, which is what produced the cross-refinement-level
      ! over-flooding observed before the canonical-iuv-walk descriptor fix.
      !
      ! Gated by the env var SFINCS_DEBUG_HALO_CHECK. Unset / empty / "0" /
      ! "false" makes this routine a no-op so release runs pay zero overhead.
      ! On the first per-slot mismatch the helper prints
      ! `rank, neighbor, slot, expected, got` and calls MPI_ABORT.
      !
      implicit none
      character(len=64) :: env_val
      integer :: status_env
      integer :: nbr_idx, nbr_rank, k
      integer :: n_send, n_recv
      integer :: nbr_send_count
      integer :: ierr
      integer :: status_arr(MPI_STATUS_SIZE)
      integer, allocatable :: my_send_global(:), nbr_send_global(:)
      integer, allocatable :: send_idx_h(:,:), recv_rem_h(:,:)
      logical :: enabled
      !
      call get_environment_variable("SFINCS_DEBUG_HALO_CHECK", env_val, status=status_env)
      enabled = .false.
      if (status_env == 0 .and. len_trim(env_val) > 0) then
         if (trim(env_val) /= "0" .and. trim(env_val) /= "false") enabled = .true.
      end if
      if (.not. enabled) return
      !
      if (mpi_size <= 1 .or. halo_uv_n_neighbors <= 0) return
      if (.not. allocated(halo_uv_send_local_idx))  return
      if (.not. allocated(halo_uv_recv_remote_idx)) return
      !
      ! D2H pulls of the two descriptor arrays we need on host. CUDA Fortran
      ! translates these to cudaMemcpy at the assignment level.
      !
      allocate(send_idx_h(size(halo_uv_send_local_idx, 1), size(halo_uv_send_local_idx, 2)))
      send_idx_h = halo_uv_send_local_idx
      allocate(recv_rem_h(size(halo_uv_recv_remote_idx, 1), size(halo_uv_recv_remote_idx, 2)))
      recv_rem_h = halo_uv_recv_remote_idx
      !
      do nbr_idx = 1, halo_uv_n_neighbors
         nbr_rank = halo_neighbor_ranks(nbr_idx)
         n_send = halo_uv_send_count(nbr_idx)
         n_recv = halo_uv_recv_count(nbr_idx)
         !
         ! Exchange counts first so a count-level asymmetry is caught with a
         ! clearer error than a silent per-slot truncation later.
         !
         nbr_send_count = -1
         call MPI_Sendrecv(n_send,         1, MPI_INTEGER, nbr_rank, HALO_TAG_DBG_COUNT, &
                           nbr_send_count, 1, MPI_INTEGER, nbr_rank, HALO_TAG_DBG_COUNT, &
                           MPI_COMM_WORLD, status_arr, ierr)
         if (nbr_send_count /= n_recv) then
            write(*, '(a,i0,a,i0,a,i0,a,i0)') &
               'SFINCS_DEBUG_HALO_CHECK: edge halo COUNT mismatch rank=', mpi_rank, &
               ' neighbor=', nbr_rank, &
               ' my_recv_count=', n_recv, &
               ' nbr_send_count=', nbr_send_count
            call MPI_Abort(MPI_COMM_WORLD, 1, ierr)
         end if
         !
         allocate(my_send_global (max(n_send, 1))); my_send_global  = 0
         allocate(nbr_send_global(max(n_recv, 1))); nbr_send_global = 0
         do k = 1, n_send
            my_send_global(k) = local_to_global_uv(send_idx_h(k, nbr_idx))
         end do
         call MPI_Sendrecv(my_send_global,  n_send, MPI_INTEGER, nbr_rank, HALO_TAG_DBG_GLOBAL, &
                           nbr_send_global, n_recv, MPI_INTEGER, nbr_rank, HALO_TAG_DBG_GLOBAL, &
                           MPI_COMM_WORLD, status_arr, ierr)
         !
         do k = 1, n_recv
            if (nbr_send_global(k) /= recv_rem_h(k, nbr_idx)) then
               write(*, '(a,i0,a,i0,a,i0,a,i0,a,i0)') &
                  'SFINCS_DEBUG_HALO_CHECK: edge halo descriptor MISMATCH rank=', mpi_rank, &
                  ' neighbor=', nbr_rank, &
                  ' slot=', k, &
                  ' expected_global_iuv=', recv_rem_h(k, nbr_idx), &
                  ' got_global_iuv=', nbr_send_global(k)
               call MPI_Abort(MPI_COMM_WORLD, 1, ierr)
            end if
         end do
         deallocate(my_send_global)
         deallocate(nbr_send_global)
      end do
      !
      deallocate(send_idx_h)
      deallocate(recv_rem_h)
      !
      if (mpi_rank == 0) then
         write(*, '(a)') 'SFINCS_DEBUG_HALO_CHECK: edge halo descriptors symmetric across all neighbor pairs.'
      end if
      !
   end subroutine validate_halo_descriptors
   !
