module sfincs_partition
   !
   ! GPU partition / device-binding / halo-exchange entry points.
   !
   ! This module owns the bridge between the host-side state in sfincs_data
   ! and its device shadow in sfincs_data_device. Multi-rank partition and
   ! halo discovery are implemented here; halo-exchange execution bodies
   ! remain stubs (SOR-708 fills halo_exchange_zs / halo_exchange_q_uv;
   ! SOR-709 wires the call sites and MPI_Allreduce on min_dt; SOR-710
   ! adds the boundary broadcast; SOR-711 adds SnapWave gather/scatter;
   ! SOR-712 adds the output gather). For mpi_size == 1 the partition is
   ! degenerate and the catalog copyin produces device-side arrays
   ! bit-identical to the prior single-rank code path.
   !
   use cudafor
   use mpi
   use sfincs_data_device
   !
   ! Host-side counterparts. The catalog mirrors source/src/sfincs_openacc.f90
   ! lines 15-39. NOTE: the architect mandate refers to a host-side scalar
   ! `npn`; the actual identifier in sfincs_data is `np` (rank-local cell
   ! count). It is renamed here as `npn_h` so the device-side `npn_local`
   ! still maps to a recognisable host name.
   !
   use sfincs_data, only: &
      npn_h => np, npuv_h => npuv, &
      z_xz_h => z_xz, z_yz_h => z_yz, &
      kcs_h => kcs, kfuv_h => kfuv, kcuv_h => kcuv, &
      zs_h => zs, zs0_h => zs0, zsderv_h => zsderv, &
      q_h => q, q0_h => q0, uv_h => uv, uv0_h => uv0, &
      zb_h => zb, zbuv_h => zbuv, zbuvmx_h => zbuvmx, &
      zsmax_h => zsmax, maxzsm_h => maxzsm, qmax_h => qmax, vmax_h => vmax, &
      twet_h => twet, zsm_h => zsm, z_volume_h => z_volume, &
      z_flags_iref_h => z_flags_iref, uv_flags_iref_h => uv_flags_iref, &
      uv_flags_type_h => uv_flags_type, uv_flags_dir_h => uv_flags_dir, &
      mask_adv_h => mask_adv, &
      index_kcuv2_h => index_kcuv2, nmikcuv2_h => nmikcuv2, &
      nmbkcuv2_h => nmbkcuv2, ibkcuv2_h => ibkcuv2, &
      zsb_h => zsb, zsb0_h => zsb0, ibuvdir_h => ibuvdir, uvmean_h => uvmean, &
      subgrid_uv_zmin_h => subgrid_uv_zmin, subgrid_uv_zmax_h => subgrid_uv_zmax, &
      subgrid_uv_havg_h => subgrid_uv_havg, subgrid_uv_nrep_h => subgrid_uv_nrep, &
      subgrid_uv_pwet_h => subgrid_uv_pwet, &
      subgrid_uv_havg_zmax_h => subgrid_uv_havg_zmax, &
      subgrid_uv_nrep_zmax_h => subgrid_uv_nrep_zmax, &
      subgrid_uv_fnfit_h => subgrid_uv_fnfit, subgrid_uv_navg_w_h => subgrid_uv_navg_w, &
      subgrid_z_zmin_h => subgrid_z_zmin, subgrid_z_zmax_h => subgrid_z_zmax, &
      subgrid_z_dep_h => subgrid_z_dep, subgrid_z_volmax_h => subgrid_z_volmax, &
      z_index_uv_md_h => z_index_uv_md, z_index_uv_nd_h => z_index_uv_nd, &
      z_index_uv_mu_h => z_index_uv_mu, z_index_uv_nu_h => z_index_uv_nu, &
      uv_index_z_nm_h => uv_index_z_nm, uv_index_z_nmu_h => uv_index_z_nmu, &
      uv_index_u_nmd_h => uv_index_u_nmd, uv_index_u_nmu_h => uv_index_u_nmu, &
      uv_index_u_ndm_h => uv_index_u_ndm, uv_index_u_num_h => uv_index_u_num, &
      uv_index_v_ndm_h => uv_index_v_ndm, uv_index_v_ndmu_h => uv_index_v_ndmu, &
      uv_index_v_nm_h => uv_index_v_nm, uv_index_v_nmu_h => uv_index_v_nmu, &
      nmindsrc_h => nmindsrc, qtsrc_h => qtsrc, &
      drainage_type_h => drainage_type, drainage_params_h => drainage_params, &
      z_index_wavemaker_h => z_index_wavemaker, wavemaker_uvmean_h => wavemaker_uvmean, &
      wavemaker_nmd_h => wavemaker_nmd, wavemaker_nmu_h => wavemaker_nmu, &
      wavemaker_ndm_h => wavemaker_ndm, wavemaker_num_h => wavemaker_num, &
      structure_uv_index_h => structure_uv_index, &
      structure_parameters_h => structure_parameters, &
      structure_type_h => structure_type, structure_length_h => structure_length, &
      fwuv_h => fwuv, &
      tauwu_h => tauwu, tauwv_h => tauwv, &
      tauwu0_h => tauwu0, tauwv0_h => tauwv0, &
      tauwu1_h => tauwu1, tauwv1_h => tauwv1, &
      windu_h => windu, windv_h => windv, &
      windu0_h => windu0, windv0_h => windv0, &
      windu1_h => windu1, windv1_h => windv1, windmax_h => windmax, &
      patm_h => patm, patm0_h => patm0, patm1_h => patm1, patmb_h => patmb, &
      nmindbnd_h => nmindbnd, &
      prcp_h => prcp, prcp0_h => prcp0, prcp1_h => prcp1, &
      cumprcp_h => cumprcp, netprcp_h => netprcp, qext_h => qext, &
      dxminv_h => dxminv, dxrinv_h => dxrinv, dyrinv_h => dyrinv, &
      dxm2inv_h => dxm2inv, dxr2inv_h => dxr2inv, dyr2inv_h => dyr2inv, &
      dxrinvc_h => dxrinvc, dyrinvc_h => dyrinvc, &
      dxm_h => dxm, dxrm_h => dxrm, dyrm_h => dyrm, &
      cell_area_m2_h => cell_area_m2, cell_area_h => cell_area, &
      gn2uv_h => gn2uv, fcorio2d_h => fcorio2d, &
      storage_volume_h => storage_volume, nuvisc_h => nuvisc, &
      cuv_index_uv_h => cuv_index_uv, cuv_index_uv1_h => cuv_index_uv1, &
      cuv_index_uv2_h => cuv_index_uv2, &
      x73_h => x73, gnapp2_h => gnapp2, &
      timestep_analysis_required_timestep_h => timestep_analysis_required_timestep, &
      timestep_analysis_average_required_timestep_h => timestep_analysis_average_required_timestep, &
      timestep_analysis_times_wet_h => timestep_analysis_times_wet, &
      timestep_analysis_times_limiting_h => timestep_analysis_times_limiting, &
      qinffield_h => qinffield, qinfmap_h => qinfmap, cuminf_h => cuminf, &
      scs_rain_h => scs_rain, scs_Se_h => scs_Se, scs_P1_h => scs_P1, &
      scs_F1_h => scs_F1, scs_S1_h => scs_S1, rain_T1_h => rain_T1, &
      ksfield_h => ksfield, &
      GA_head_h => GA_head, GA_sigma_h => GA_sigma, GA_sigma_max_h => GA_sigma_max, &
      GA_F_h => GA_F, GA_Lu_h => GA_Lu, inf_kr_h => inf_kr, &
      horton_kd_h => horton_kd, horton_fc_h => horton_fc, horton_f0_h => horton_f0
   !
   ! ===== gpu-wavemaker-snapwave-coupling supplemental ====
   !
   use sfincs_data, only: &
      wavemaker_index_uv_h    => wavemaker_index_uv, &
      wavemaker_index_nmi_h   => wavemaker_index_nmi, &
      wavemaker_index_nmb_h   => wavemaker_index_nmb, &
      wavemaker_index_wmfp1_h => wavemaker_index_wmfp1, &
      wavemaker_index_wmfp2_h => wavemaker_index_wmfp2, &
      wavemaker_fac_wmfp_h    => wavemaker_fac_wmfp, &
      wavemaker_idir_h        => wavemaker_idir, &
      wavemaker_angfac_h      => wavemaker_angfac, &
      wavemaker_uvtrend_h     => wavemaker_uvtrend, &
      hm0_h                   => hm0, &
      hm0_ig_h                => hm0_ig
   !
   ! ===== gpu-meteo-spatial-interp supplemental ====
   !
   use sfincs_data, only: &
      spw_times_h     => spw_times, &
      spw_xe_h        => spw_xe, &
      spw_ye_h        => spw_ye, &
      spw_wu_h        => spw_wu, &
      spw_wv_h        => spw_wv, &
      spw_pabs_h      => spw_pabs, &
      spw_prcp_h      => spw_prcp, &
      spw_wu01_h      => spw_wu01, &
      spw_wv01_h      => spw_wv01, &
      spw_pabs01_h    => spw_pabs01, &
      spw_prcp01_h    => spw_prcp01, &
      amuv_times_h    => amuv_times, &
      amuv_wu_h       => amuv_wu, &
      amuv_wv_h       => amuv_wv, &
      amuv_wu01_h     => amuv_wu01, &
      amuv_wv01_h     => amuv_wv01, &
      amp_times_h     => amp_times, &
      amp_patm_h      => amp_patm, &
      amp_patm01_h    => amp_patm01, &
      ampr_times_h    => ampr_times, &
      ampr_pr_h       => ampr_pr, &
      ampr_pr01_h     => ampr_pr01, &
      z_xz_h          => z_xz, &
      z_yz_h          => z_yz, &
      cdval_h         => cdval, &
      cdlgx_h         => cdlgx, &
      z0land_h        => z0land, &
      z0land_table_h  => z0land_table
   !
   implicit none
   !
   public  :: partition_and_localize, device_finalize, &
              halo_exchange_zs, halo_exchange_q_uv, &
              device_to_host_for_output
   private :: compute_quadtree_geometric_partition, &
              build_local_index_maps, &
              build_halo_descriptors, &
              copyin_phase4_degenerate, &
              sort_indices_by_key, qsort_recursive
   !
contains
   !
   subroutine partition_and_localize()
      !
      integer :: ierr
      integer :: nGpus, istat
      logical :: flag
      !
      ! Local partition / index-map state. cell_part and the global_to_local
      ! reverse maps are owned by this routine and deallocated before return.
      ! local_to_global / local_to_global_uv live at module scope in
      ! sfincs_data_device.cuf because SOR-708's halo_exchange needs them at
      ! runtime to translate LOCAL send indices into GLOBAL device indices
      ! (the device shadows stay full-size global-indexed while AC #5/#6
      ! deferral is in effect).
      !
      integer, allocatable :: cell_part(:)
      integer, allocatable :: global_to_local(:)
      integer, allocatable :: global_to_local_uv(:)
      integer :: npn_total, npuv_total
      !
      ! --- Phase 1: MPI bootstrap -------------------------------------------
      ! The orchestrator (sfincs_lib) may have already called mpi_init in the
      ! same PR; guard with mpi_initialized so we never double-init.
      !
      call mpi_initialized(flag, ierr)
      if (.not. flag) then
         call mpi_init(ierr)
      end if
      call mpi_comm_rank(MPI_COMM_WORLD, mpi_rank, ierr)
      call mpi_comm_size(MPI_COMM_WORLD, mpi_size, ierr)
      !
      ! --- Phase 2: Device binding ------------------------------------------
      !
      istat = cudaGetDeviceCount(nGpus)
      local_rank = mod(mpi_rank, nGpus)
      istat = cudaSetDevice(local_rank)
      if (istat /= cudaSuccess) then
         error stop 'cudaSetDevice failed'
      end if
      !
      ! --- Phase 3: Quadtree-aware geometric partition ----------------------
      ! compute_quadtree_geometric_partition fills cell_part(1:npn_h) with
      ! 0-based rank ids. build_local_index_maps consumes cell_part plus the
      ! host-side connectivity arrays to produce the cell- and edge-level
      ! local_to_global / global_to_local maps that Phase 4 needs to gather
      ! and renumber catalog arrays. npn_local, npuv_local, halo counts and
      ! cell_index_first/last are set inside build_local_index_maps. For
      ! mpi_size == 1 the partition is degenerate: cell_part(:) == 0,
      ! npn_local == npn_h, npuv_local == npuv_h, halo_count_* == 0 and the
      ! maps are identities, which is what guarantees the N=1 device-side
      ! state stays bit-identical to the prior single-rank path.
      !
      allocate(cell_part(max(npn_h, 1)))
      call compute_quadtree_geometric_partition(cell_part)
      call build_local_index_maps(cell_part, &
                                  global_to_local, global_to_local_uv, &
                                  npn_total, npuv_total)
      !
      ! --- Phase 4: Allocate device shadows + copyin ------------------------
      ! Every device shadow is allocated with mold=arr_h and copied verbatim
      ! from its host counterpart, both for mpi_size == 1 and mpi_size > 1.
      !
      ! NOTE on AC #5/#6 (Phase 4 shrink + connectivity renumber):
      !
      !    Phase 4 here does NOT shrink to npn_local + halo_count, and the
      !    connectivity arrays are NOT renumbered to local indices. Per the
      !    2026-05-05 architect amendment, AC #5 and AC #6 are deferred to
      !    sub-epic 10 (gpu-rank-local-allocation), which executes after the
      !    per-step staging bridges in source/src/sfincs_<name>_gpu.cuf are
      !    removed. Reason: those bridges (e.g. compute_fluxes at
      !    sfincs_momentum_gpu.cuf:138-176) re-copy the full host arrays into
      !    the device shadows each step via plain `arr_d = arr_h` whole-array
      !    assignments — the symmetric Bridge code lifetime mandated by the
      !    architect's cross-sub-epic contract. Shrinking the device shadow
      !    here, while the bridges still bulk re-copy, triggers a shape
      !    mismatch / cudaErrorIllegalAddress on the first compute_fluxes
      !    call. The SOR-707 issue body's "the per-step compute kernels in
      !    sfincs_<name>_gpu.cuf are not touched" clause forbids the
      !    bridge-side gather edit needed to make the shrink work, so the
      !    shrink lives in sub-epic 10 instead, after the bridges are gone.
      !
      !    The foundation this issue delivers — cell_part (Phase 3),
      !    npn_local / npuv_local / cell_index_first / cell_index_last
      !    (build_local_index_maps), per-neighbor-rank halo descriptors
      !    (Phase 5), and the persisted local_to_global / local_to_global_uv
      !    translation maps (sfincs_data_device) — is sufficient input for
      !    SOR-708 / SOR-709's halo-exchange execution to land against the
      !    full-size global-indexed device shadows, and for sub-epic 10 to
      !    land the eventual shrink and renumber.
      !
      !    N=1 stays bit-identical to the pre-PR baseline because Phase 4
      !    here is a verbatim port of the prior single-rank Phase 4 body.
      !
      call copyin_phase4_degenerate()
      !
      ! --- Phase 5: Halo descriptor build -----------------------------------
      ! Populates halo_recv_local_idx, halo_recv_remote_idx,
      ! halo_send_local_idx, halo_recv_count, halo_send_count,
      ! halo_neighbor_ranks, halo_n_neighbors and the matching halo_uv_*
      ! arrays declared in sfincs_data_device.cuf. For mpi_size == 1 the
      ! routine returns with halo_n_neighbors == 0 and no allocations
      ! beyond the zero-length neighbor-rank vector.
      !
      call build_halo_descriptors(cell_part, &
                                  global_to_local, global_to_local_uv)
      !
      ! Drop host-side temporaries. The state that needs to live past this
      ! routine is the device-resident catalog plus the halo descriptor
      ! arrays and local_to_global / local_to_global_uv (module scope in
      ! sfincs_data_device, deallocated by device_finalize).
      !
      if (allocated(cell_part))          deallocate(cell_part)
      if (allocated(global_to_local))    deallocate(global_to_local)
      if (allocated(global_to_local_uv)) deallocate(global_to_local_uv)
      !
   end subroutine partition_and_localize
   !
   subroutine copyin_phase4_degenerate()
      !
      ! Mirror of the prior single-rank Phase 4 body. Every device shadow
      ! is allocated with mold=arr_h and copied verbatim from its host
      ! counterpart, guaranteeing the N=1 path produces device-side arrays
      ! bit-identical to the pre-PR baseline. Skip arrays whose host
      ! counterpart is unallocated (wavemaker, drainage, structures, etc.
      ! only allocated when their input is given).
      !
      if (allocated(kcs_h))           then; allocate(kcs,           mold=kcs_h);           kcs           = kcs_h;           end if
      if (allocated(kfuv_h))          then; allocate(kfuv,          mold=kfuv_h);          kfuv          = kfuv_h;          end if
      if (allocated(kcuv_h))          then; allocate(kcuv,          mold=kcuv_h);          kcuv          = kcuv_h;          end if
      if (allocated(zs_h))            then; allocate(zs,            mold=zs_h);            zs            = zs_h;            end if
      if (allocated(zs0_h))           then; allocate(zs0,           mold=zs0_h);           zs0           = zs0_h;           end if
      if (allocated(zsderv_h))        then; allocate(zsderv,        mold=zsderv_h);        zsderv        = zsderv_h;        end if
      if (allocated(q_h))             then; allocate(q,             mold=q_h);             q             = q_h;             end if
      if (allocated(q0_h))            then; allocate(q0,            mold=q0_h);            q0            = q0_h;            end if
      if (allocated(uv_h))            then; allocate(uv,            mold=uv_h);            uv            = uv_h;            end if
      if (allocated(uv0_h))           then; allocate(uv0,           mold=uv0_h);           uv0           = uv0_h;           end if
      if (allocated(zb_h))            then; allocate(zb,            mold=zb_h);            zb            = zb_h;            end if
      if (allocated(zbuv_h))          then; allocate(zbuv,          mold=zbuv_h);          zbuv          = zbuv_h;          end if
      if (allocated(zbuvmx_h))        then; allocate(zbuvmx,        mold=zbuvmx_h);        zbuvmx        = zbuvmx_h;        end if
      if (allocated(zsmax_h))         then; allocate(zsmax,         mold=zsmax_h);         zsmax         = zsmax_h;         end if
      if (allocated(maxzsm_h))        then; allocate(maxzsm,        mold=maxzsm_h);        maxzsm        = maxzsm_h;        end if
      if (allocated(qmax_h))          then; allocate(qmax,          mold=qmax_h);          qmax          = qmax_h;          end if
      if (allocated(vmax_h))          then; allocate(vmax,          mold=vmax_h);          vmax          = vmax_h;          end if
      if (allocated(twet_h))          then; allocate(twet,          mold=twet_h);          twet          = twet_h;          end if
      if (allocated(zsm_h))           then; allocate(zsm,           mold=zsm_h);           zsm           = zsm_h;           end if
      if (allocated(z_volume_h))      then; allocate(z_volume,      mold=z_volume_h);      z_volume      = z_volume_h;      end if
      if (allocated(z_flags_iref_h))  then; allocate(z_flags_iref,  mold=z_flags_iref_h);  z_flags_iref  = z_flags_iref_h;  end if
      if (allocated(uv_flags_iref_h)) then; allocate(uv_flags_iref, mold=uv_flags_iref_h); uv_flags_iref = uv_flags_iref_h; end if
      if (allocated(uv_flags_type_h)) then; allocate(uv_flags_type, mold=uv_flags_type_h); uv_flags_type = uv_flags_type_h; end if
      if (allocated(uv_flags_dir_h))  then; allocate(uv_flags_dir,  mold=uv_flags_dir_h);  uv_flags_dir  = uv_flags_dir_h;  end if
      if (allocated(mask_adv_h))      then; allocate(mask_adv,      mold=mask_adv_h);      mask_adv      = mask_adv_h;      end if
      if (allocated(index_kcuv2_h))   then; allocate(index_kcuv2,   mold=index_kcuv2_h);   index_kcuv2   = index_kcuv2_h;   end if
      if (allocated(nmikcuv2_h))      then; allocate(nmikcuv2,      mold=nmikcuv2_h);      nmikcuv2      = nmikcuv2_h;      end if
      if (allocated(nmbkcuv2_h))      then; allocate(nmbkcuv2,      mold=nmbkcuv2_h);      nmbkcuv2      = nmbkcuv2_h;      end if
      if (allocated(ibkcuv2_h))       then; allocate(ibkcuv2,       mold=ibkcuv2_h);       ibkcuv2       = ibkcuv2_h;       end if
      if (allocated(zsb_h))           then; allocate(zsb,           mold=zsb_h);           zsb           = zsb_h;           end if
      if (allocated(zsb0_h))          then; allocate(zsb0,          mold=zsb0_h);          zsb0          = zsb0_h;          end if
      if (allocated(ibuvdir_h))       then; allocate(ibuvdir,       mold=ibuvdir_h);       ibuvdir       = ibuvdir_h;       end if
      if (allocated(uvmean_h))        then; allocate(uvmean,        mold=uvmean_h);        uvmean        = uvmean_h;        end if
      if (allocated(subgrid_uv_zmin_h))      then; allocate(subgrid_uv_zmin,      mold=subgrid_uv_zmin_h);      subgrid_uv_zmin      = subgrid_uv_zmin_h;      end if
      if (allocated(subgrid_uv_zmax_h))      then; allocate(subgrid_uv_zmax,      mold=subgrid_uv_zmax_h);      subgrid_uv_zmax      = subgrid_uv_zmax_h;      end if
      if (allocated(subgrid_uv_havg_h))      then; allocate(subgrid_uv_havg,      mold=subgrid_uv_havg_h);      subgrid_uv_havg      = subgrid_uv_havg_h;      end if
      if (allocated(subgrid_uv_nrep_h))      then; allocate(subgrid_uv_nrep,      mold=subgrid_uv_nrep_h);      subgrid_uv_nrep      = subgrid_uv_nrep_h;      end if
      if (allocated(subgrid_uv_pwet_h))      then; allocate(subgrid_uv_pwet,      mold=subgrid_uv_pwet_h);      subgrid_uv_pwet      = subgrid_uv_pwet_h;      end if
      if (allocated(subgrid_uv_havg_zmax_h)) then; allocate(subgrid_uv_havg_zmax, mold=subgrid_uv_havg_zmax_h); subgrid_uv_havg_zmax = subgrid_uv_havg_zmax_h; end if
      if (allocated(subgrid_uv_nrep_zmax_h)) then; allocate(subgrid_uv_nrep_zmax, mold=subgrid_uv_nrep_zmax_h); subgrid_uv_nrep_zmax = subgrid_uv_nrep_zmax_h; end if
      if (allocated(subgrid_uv_fnfit_h))     then; allocate(subgrid_uv_fnfit,     mold=subgrid_uv_fnfit_h);     subgrid_uv_fnfit     = subgrid_uv_fnfit_h;     end if
      if (allocated(subgrid_uv_navg_w_h))    then; allocate(subgrid_uv_navg_w,    mold=subgrid_uv_navg_w_h);    subgrid_uv_navg_w    = subgrid_uv_navg_w_h;    end if
      if (allocated(subgrid_z_zmin_h))       then; allocate(subgrid_z_zmin,       mold=subgrid_z_zmin_h);       subgrid_z_zmin       = subgrid_z_zmin_h;       end if
      if (allocated(subgrid_z_zmax_h))       then; allocate(subgrid_z_zmax,       mold=subgrid_z_zmax_h);       subgrid_z_zmax       = subgrid_z_zmax_h;       end if
      if (allocated(subgrid_z_dep_h))        then; allocate(subgrid_z_dep,        mold=subgrid_z_dep_h);        subgrid_z_dep        = subgrid_z_dep_h;        end if
      if (allocated(subgrid_z_volmax_h))     then; allocate(subgrid_z_volmax,     mold=subgrid_z_volmax_h);     subgrid_z_volmax     = subgrid_z_volmax_h;     end if
      if (allocated(z_index_uv_md_h))   then; allocate(z_index_uv_md,   mold=z_index_uv_md_h);   z_index_uv_md   = z_index_uv_md_h;   end if
      if (allocated(z_index_uv_nd_h))   then; allocate(z_index_uv_nd,   mold=z_index_uv_nd_h);   z_index_uv_nd   = z_index_uv_nd_h;   end if
